---
import { existsSync } from "node:fs";
import Icon from "./Icon.astro";

/**
 * Venue photo grid with a lightbox. Photos live in /public/media as
 * `<file>-thumb.webp` and `<file>-lg.webp`; entries whose files are not on
 * disk yet are skipped, so the gallery fills in as assets are supplied.
 */
interface Props {
  images: Array<{ file: string; alt: string }>;
  /** Shown when no photos exist yet. */
  fallbackImage: string;
  fallbackAlt: string;
  heading: string;
  viewLarger: string;
  closeLabel: string;
  previousLabel: string;
  nextLabel: string;
  swipeHint: string;
  photoCountTemplate: string;
}

const { images, fallbackImage, fallbackAlt, heading, viewLarger, closeLabel,
  previousLabel, nextLabel, swipeHint, photoCountTemplate } = Astro.props;

const available = images.filter((image) => existsSync(`public/media/${image.file}-thumb.webp`));
const large = (file: string) =>
  existsSync(`public/media/${file}-lg.webp`)
    ? `/media/${file}-lg.webp`
    : `/media/${file}-thumb.webp`;
---

<div data-testid="spa-gallery" class="mb-16">
  <h2 class="text-xl font-semibold mb-4 text-gold">{heading}</h2>

  {
    available.length === 0 ? (
      <figure class="overflow-hidden rounded-2xl border border-white/5 bg-[#141414]">
        <img
          src={fallbackImage}
          alt={fallbackAlt}
          width="800"
          height="800"
          sizes="(min-width: 1280px) 1280px, calc(100vw - 2rem)"
          loading="lazy"
          decoding="async"
          class="w-full h-auto object-cover"
        />
      </figure>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" data-spa-gallery>
        {available.map((image) => (
          <figure class="group overflow-hidden rounded-2xl border border-white/5 bg-[#141414]">
            <button
              type="button"
              class="relative block w-full aspect-[4/3] overflow-hidden"
              data-gallery-open
              data-src={large(image.file)}
              data-alt={image.alt}
            >
              <img
                src={`/media/${image.file}-thumb.webp`}
                alt={image.alt}
                width="600"
                height="600"
                sizes="(min-width: 1024px) 405px, (min-width: 640px) calc((100vw - 3rem) / 2), calc(100vw - 2rem)"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent px-3 py-2 text-left text-xs font-medium text-white/80">
                {viewLarger}
              </span>
            </button>
          </figure>
        ))}
      </div>
    )
  }
</div>

{
  available.length > 0 && (
    <div
      data-gallery-lightbox
      hidden
      class="fixed inset-0 z-[150] hidden items-center justify-center overflow-y-auto overscroll-contain bg-black/95 px-4 pb-6 pt-20"
      role="dialog"
      aria-modal="true"
      aria-label={heading}
      aria-hidden="true"
    >
      <button
        type="button"
        data-gallery-close
        aria-label={closeLabel}
        class="fixed right-4 top-4 z-10 inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/20 bg-black/70 text-white shadow-lg shadow-black/30 backdrop-blur-md transition-colors hover:border-gold/60 hover:text-gold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold sm:right-6 sm:top-6"
      >
        <Icon name="close" class="h-5 w-5" />
      </button>

      <div class="my-auto w-full max-w-5xl">
        <figure class="flex flex-col items-center gap-3">
          <img
            data-gallery-image src="" alt="" draggable="false"
            class="max-h-[max(8rem,calc(100dvh-17rem))] w-auto max-w-full select-none rounded-xl object-contain [touch-action:pan-y_pinch-zoom] sm:max-h-[max(8rem,calc(100dvh-15rem))]"
          />
        </figure>
        <div class="mt-4 flex items-center justify-center gap-6">
          <button
            type="button" data-gallery-prev hidden={available.length < 2}
            aria-label={previousLabel} title={previousLabel}
            class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-gold/40 bg-white/5 text-gold transition-colors hover:bg-gold/15 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold"
          >
            <Icon name="arrow-left" class="h-5 w-5" />
          </button>
          <span
            data-gallery-counter data-count-template={photoCountTemplate}
            role="status" aria-live="polite" aria-atomic="true"
            class="min-w-16 text-center text-sm font-medium tabular-nums text-white/90"
          />
          <button
            type="button" data-gallery-next hidden={available.length < 2}
            aria-label={nextLabel} title={nextLabel}
            class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-gold/40 bg-white/5 text-gold transition-colors hover:bg-gold/15 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold"
          >
            <Icon name="arrow-right" class="h-5 w-5" />
          </button>
        </div>
        {available.length > 1 && <p class="gallery-swipe-hint mt-3 text-center text-xs text-white/50">{swipeHint}</p>}
      </div>
    </div>
  )
}

<script>
  (() => {
    const lightbox = document.querySelector<HTMLElement>("[data-gallery-lightbox]");
    if (!lightbox) return;

    const image = lightbox.querySelector<HTMLImageElement>("[data-gallery-image]");
    const closeButton = lightbox.querySelector<HTMLButtonElement>("[data-gallery-close]");
    const previousButton = lightbox.querySelector<HTMLButtonElement>("[data-gallery-prev]");
    const nextButton = lightbox.querySelector<HTMLButtonElement>("[data-gallery-next]");
    const counter = lightbox.querySelector<HTMLElement>("[data-gallery-counter]");
    const triggers = Array.from(document.querySelectorAll<HTMLElement>("[data-gallery-open]"));
    let currentIndex = 0;
    let swipeStart: { id: number; x: number; y: number } | null = null;
    let lastTrigger: HTMLElement | null = null;
    let previousBodyOverflow = "";
    let savedScrollY = 0;

    // The component is rendered inside [data-page-background]. Move the
    // dialog beside that subtree before making the page itself inert.
    document.body.append(lightbox);

    const isOpen = () => !lightbox.hidden;
    const isZoomed = () => (window.visualViewport?.scale ?? 1) > 1.05;
    const showPhoto = (index: number) => {
      if (!image || !triggers.length) return;
      currentIndex = (index + triggers.length) % triggers.length;
      const trigger = triggers[currentIndex];
      image.src = trigger.dataset.src ?? "";
      image.alt = trigger.dataset.alt ?? "";
      if (counter) {
        counter.textContent = `${currentIndex + 1} / ${triggers.length}`;
        counter.setAttribute("aria-label", (counter.dataset.countTemplate ?? "{current} / {total}")
          .replace("{current}", String(currentIndex + 1))
          .replace("{total}", String(triggers.length)));
      }
    };
    const navigate = (direction: number) => {
      if (isOpen() && triggers.length > 1) showPhoto(currentIndex + direction);
    };
    for (const button of [previousButton, nextButton]) {
      if (button) button.hidden = triggers.length < 2;
    }
    const setBackgroundInert = (inert: boolean) => {
      const background = document.querySelector<HTMLElement>("[data-page-background]");
      if (background) background.inert = inert;
    };

    const close = () => {
      if (!isOpen()) return;
      swipeStart = null;
      lightbox.classList.replace("flex", "hidden");
      lightbox.hidden = true;
      lightbox.setAttribute("aria-hidden", "true");
      setBackgroundInert(false);
      document.body.style.overflow = previousBodyOverflow;
      // preventScroll: focusing on mobile scrolls the page (jumps to top).
      lastTrigger?.focus({ preventScroll: true });
      lastTrigger = null;
      // Restore scroll in case the browser moved it while the lightbox was open.
      window.scrollTo({ top: savedScrollY, behavior: "instant" });
    };

    triggers.forEach((trigger, index) => {
      trigger.addEventListener("click", () => {
        if (!image) return;
        lastTrigger = trigger;
        previousBodyOverflow = document.body.style.overflow;
        savedScrollY = window.scrollY;
        showPhoto(index);
        lightbox.hidden = false;
        lightbox.setAttribute("aria-hidden", "false");
        lightbox.classList.replace("hidden", "flex");
        setBackgroundInert(true);
        document.body.style.overflow = "hidden";
        requestAnimationFrame(() => closeButton?.focus({ preventScroll: true }));
      });
    });

    closeButton?.addEventListener("click", close);
    previousButton?.addEventListener("click", () => navigate(-1));
    nextButton?.addEventListener("click", () => navigate(1));
    image?.addEventListener("pointerdown", (event) => {
      // A second finger cancels navigation so native pinch zoom remains available.
      swipeStart = null;
      if (!isOpen() || !event.isPrimary || event.pointerType === "mouse" || isZoomed()) return;
      swipeStart = { id: event.pointerId, x: event.clientX, y: event.clientY };
      image.setPointerCapture(event.pointerId);
    });
    image?.addEventListener("pointercancel", () => { swipeStart = null; });
    image?.addEventListener("pointerup", (event) => {
      const start = swipeStart;
      swipeStart = null;
      if (!start || start.id !== event.pointerId || isZoomed()) return;
      const dx = event.clientX - start.x;
      const dy = event.clientY - start.y;
      if (Math.abs(dx) >= 50 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        navigate(dx < 0 ? 1 : -1);
      }
    });
    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) close();
    });
    document.addEventListener("keydown", (event) => {
      if (!isOpen()) return;
      if (event.key === "Escape") {
        event.preventDefault();
        close();
      } else if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
        event.preventDefault();
        navigate(event.key === "ArrowLeft" ? -1 : 1);
      } else if (event.key === "Tab") {
        const controls = [closeButton, previousButton, nextButton]
          .filter((control): control is HTMLElement => Boolean(control && !control.hidden));
        const first = controls[0];
        const last = controls[controls.length - 1];
        const active = document.activeElement;
        if (first && (event.shiftKey ? active === first : active === last)) {
          event.preventDefault();
          (event.shiftKey ? last : first).focus();
        } else if (first && !lightbox.contains(active)) {
          event.preventDefault();
          first.focus();
        }
      }
    });
  })();
</script>

<style>
  [data-gallery-prev][hidden],
  [data-gallery-next][hidden] { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .gallery-swipe-hint { display: none; }
  }
</style>
