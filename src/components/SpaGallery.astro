---
import { existsSync } from "node:fs";
import Icon from "./Icon.astro";

/**
 * Venue photo grid with a lightbox. Photos live in /public/media as
 * `<file>-thumb.webp` and `<file>-lg.webp`; entries whose files are not on
 * disk yet are skipped, so the gallery fills in as assets are supplied.
 */
interface Props {
  images: Array<{ file: string; caption: string; alt: string }>;
  /** Shown when no photos exist yet. */
  fallbackImage: string;
  fallbackAlt: string;
  heading: string;
  viewLarger: string;
  closeLabel: string;
}

const { images, fallbackImage, fallbackAlt, heading, viewLarger, closeLabel } = Astro.props;

const available = images.filter((image) => existsSync(`public/media/${image.file}-thumb.webp`));
const large = (file: string) =>
  existsSync(`public/media/${file}-lg.webp`)
    ? `/media/${file}-lg.webp`
    : `/media/${file}-thumb.webp`;
---

<div data-testid="spa-gallery" class="mb-16">
  <h2 class="text-xl font-semibold mb-4 text-gold">{heading}</h2>

  {
    available.length === 0 ? (
      <figure class="overflow-hidden rounded-2xl border border-white/5 bg-[#141414]">
        <img
          src={fallbackImage}
          alt={fallbackAlt}
          width="800"
          height="600"
          loading="lazy"
          decoding="async"
          class="w-full h-auto object-cover"
        />
      </figure>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" data-spa-gallery>
        {available.map((image, index) => (
          <figure class="group overflow-hidden rounded-2xl border border-white/5 bg-[#141414]">
            <button
              type="button"
              class="relative block w-full aspect-[4/3] overflow-hidden"
              data-gallery-open
              data-src={large(image.file)}
              data-alt={image.alt}
              data-caption={image.caption}
            >
              <img
                src={`/media/${image.file}-thumb.webp`}
                alt={image.alt}
                loading={index < 3 ? "eager" : "lazy"}
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent px-3 py-2 text-left text-xs font-medium text-white/80">
                {viewLarger}
              </span>
            </button>
            <figcaption class="px-4 py-3 text-sm leading-relaxed text-white/50">
              {image.caption}
            </figcaption>
          </figure>
        ))}
      </div>
    )
  }
</div>

{
  available.length > 0 && (
    <div
      data-gallery-lightbox
      hidden
      class="fixed inset-0 z-[150] hidden items-center justify-center bg-black/90 p-4"
      role="dialog"
      aria-modal="true"
      aria-label={heading}
    >
      <button
        type="button"
        data-gallery-close
        aria-label={closeLabel}
        class="absolute right-4 top-4 z-10 inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/20 bg-black/70 text-white shadow-lg shadow-black/30 backdrop-blur-md transition-colors hover:border-gold/60 hover:text-gold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold sm:right-6 sm:top-6"
      >
        <Icon name="close" class="h-5 w-5" />
      </button>

      <figure class="max-w-4xl">
        <img data-gallery-image src="" alt="" class="max-h-[75vh] w-auto rounded-xl" />
        <figcaption data-gallery-caption class="mt-3 text-center text-sm text-white/60" />
      </figure>
    </div>
  )
}

<script>
  (() => {
    const lightbox = document.querySelector<HTMLElement>("[data-gallery-lightbox]");
    if (!lightbox) return;

    const image = lightbox.querySelector<HTMLImageElement>("[data-gallery-image]");
    const caption = lightbox.querySelector<HTMLElement>("[data-gallery-caption]");
    const closeButton = lightbox.querySelector<HTMLButtonElement>("[data-gallery-close]");
    let lastTrigger: HTMLElement | null = null;
    let previousBodyOverflow = "";

    const isOpen = () => !lightbox.hidden;

    const close = () => {
      if (!isOpen()) return;
      lightbox.classList.replace("flex", "hidden");
      lightbox.hidden = true;
      document.body.style.overflow = previousBodyOverflow;
      lastTrigger?.focus();
      lastTrigger = null;
    };

    document.querySelectorAll<HTMLElement>("[data-gallery-open]").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        if (!image || !caption) return;
        lastTrigger = trigger;
        previousBodyOverflow = document.body.style.overflow;
        image.src = trigger.dataset.src ?? "";
        image.alt = trigger.dataset.alt ?? "";
        caption.textContent = trigger.dataset.caption ?? "";
        lightbox.hidden = false;
        lightbox.classList.replace("hidden", "flex");
        document.body.style.overflow = "hidden";
        requestAnimationFrame(() => closeButton?.focus());
      });
    });

    closeButton?.addEventListener("click", close);
    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) close();
    });
    document.addEventListener("keydown", (event) => {
      if (!isOpen()) return;
      if (event.key === "Escape") {
        event.preventDefault();
        close();
      } else if (event.key === "Tab" && closeButton) {
        event.preventDefault();
        closeButton.focus();
      }
    });
  })();
</script>
