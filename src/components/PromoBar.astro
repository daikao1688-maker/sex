---
import { getDictionary } from "../i18n";
import { localeMeta, type Locale } from "../i18n/config";

interface Props {
  lang: Locale;
  /**
   * "fixed" overlays the hero, scrolls away natively on phones, and uses the
   * existing fixed fade treatment from the small breakpoint upward (home page);
   * "inline" sits in the document flow below the navbar (every other page).
   */
  variant?: "fixed" | "inline";
  /** Override the default on-page #contact target for contextual CTAs. */
  ctaHref?: string;
}

const { lang, variant = "fixed", ctaHref } = Astro.props;

const placement =
  variant === "fixed"
    ? "absolute top-[5.5rem] sm:fixed sm:top-[6.5rem]"
    : "relative mt-[5.5rem] sm:mt-[6.5rem]";
const t = getDictionary(lang);
// Default: scroll to this page's own contact section — every shell page has
// one except privacy/editorial-policy, which pass an explicit ctaHref.
const ctaTarget = ctaHref ?? "#contact";

const htmlLang = localeMeta[lang].htmlLang;
const now = new Date();
// zh/ja render months as a number + 月; Korean uses 월; everything else gets the long name.
const currentMonth = htmlLang.startsWith("ko")
  ? `${now.getMonth() + 1}월`
  : /^(zh|ja)/.test(htmlLang)
    ? `${now.getMonth() + 1}月`
    : new Intl.DateTimeFormat(htmlLang, { month: "long" }).format(now);

const [offerBefore, offerAfter = ""] = t.promo.offer.split("{month}");
---

<div
  id="promo-top-bar"
  data-promo-variant={variant}
  aria-hidden="false"
  class:list={[
    "left-0 right-0 z-40 w-full overflow-hidden border-b border-red-400/40 glow-red",
    placement,
  ]}
  style="background: linear-gradient(90deg, #1a0a0a 0%, #2a0e0e 50%, #1a0a0a 100%);"
>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 shimmer-red"></div>
  <div
    class="relative max-w-7xl mx-auto px-4 py-2 sm:py-2.5 flex flex-wrap items-center justify-center gap-x-2 sm:gap-x-4 gap-y-0.5"
  >
    <span
      class="text-red-300 text-[13px] sm:text-base font-semibold uppercase tracking-wider whitespace-nowrap"
    >
      <span class="sm:hidden">{t.promo.headlineShort}</span>
      <span class="hidden sm:inline">{t.promo.headlineLong}</span>
    </span>
    <span class="hidden sm:inline text-white/30">·</span>
    <span class="text-white text-[13px] sm:text-base font-bold whitespace-nowrap">
      <span class="text-white/80">{offerBefore}</span><span class="pulse-red" data-promo-month
        >{currentMonth}</span
      ><span class="text-white/80">{offerAfter}</span>
    </span>
    <a
      href={ctaTarget}
      data-promo-cta
      aria-hidden="true"
      tabindex="-1"
      class="hidden sm:inline-flex ml-1 sm:ml-2 items-center px-3 sm:px-4 py-1 rounded-full text-xs sm:text-sm font-bold text-white bg-red-400 hover:bg-red-300 transition-colors whitespace-nowrap"
    >
      {t.promo.cta}
    </a>
  </div>
</div>

<style>
  /* Visual layer ported 1:1 from macau-night.hk's design-overrides.css —
     dark cherry base, gold CTA, rainbow sheen sweep. */
  #promo-top-bar {
    background: linear-gradient(
      90deg,
      rgba(15, 10, 18, 0.99),
      rgba(122, 31, 43, 0.94) 48%,
      rgba(8, 14, 24, 0.99)
    ) !important;
    border-color: rgba(184, 50, 70, 0.34) !important;
    box-shadow:
      0 14px 44px rgba(0, 0, 0, 0.38),
      inset 0 1px rgba(244, 217, 138, 0.08) !important;
    animation: none !important;
    backdrop-filter: none;
  }

  #promo-top-bar::before {
    position: absolute;
    z-index: 1;
    inset: -1px -46%;
    content: "";
    pointer-events: none;
    background: linear-gradient(
      105deg,
      transparent 34%,
      rgba(39, 215, 255, 0.08) 43%,
      rgba(244, 217, 138, 0.55) 50%,
      rgba(255, 79, 216, 0.2) 53%,
      rgba(216, 183, 90, 0.13) 60%,
      transparent 68%
    );
    mix-blend-mode: screen;
    transform: translateX(-58%);
    animation: rmPromoSweep 4.6s ease-in-out infinite;
  }

  #promo-top-bar > .relative.max-w-7xl {
    z-index: 2;
  }

  #promo-top-bar [aria-hidden="true"] {
    z-index: 1;
    background: linear-gradient(
      110deg,
      transparent 0%,
      transparent 42%,
      rgba(244, 217, 138, 0.18) 50%,
      rgba(39, 215, 255, 0.08) 54%,
      transparent 60%,
      transparent 100%
    ) !important;
    opacity: 0.7;
    animation: rmPromoSoftSweep 6.8s linear infinite !important;
  }

  #promo-top-bar .text-red-300,
  #promo-top-bar [data-promo-month] {
    color: #ff7588 !important;
    text-shadow: 0 0 18px rgba(184, 50, 70, 0.56) !important;
    animation: none !important;
  }

  #promo-top-bar a {
    color: #101014 !important;
    background: linear-gradient(180deg, #f7dfa0 0%, #d8b75a 48%, #a9822c 100%) !important;
    border: 1px solid rgba(244, 217, 138, 0.68);
    box-shadow: 0 8px 26px rgba(216, 183, 90, 0.3);
  }

  @keyframes rmPromoSweep {
    0% {
      transform: translateX(-58%);
      opacity: 0;
    }
    12% {
      opacity: 0.88;
    }
    52% {
      opacity: 0.9;
    }
    72% {
      opacity: 0;
    }
    100% {
      transform: translateX(58%);
      opacity: 0;
    }
  }

  @keyframes rmPromoSoftSweep {
    0% {
      background-position: -180% 0;
    }
    100% {
      background-position: 240% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #promo-top-bar::before,
    #promo-top-bar [aria-hidden="true"] {
      animation: none !important;
    }
  }
</style>

<script>
  // The month is baked in at build time, so refresh it on every visit.
  (() => {
    const nodes = document.querySelectorAll<HTMLElement>("[data-promo-month]");
    if (!nodes.length) return;

    const lang = (document.documentElement.lang || "en").toLowerCase();
    const now = new Date();
    const label = lang.startsWith("ko")
      ? `${now.getMonth() + 1}월`
      : /^(zh|ja)/.test(lang)
        ? `${now.getMonth() + 1}月`
        : new Intl.DateTimeFormat(lang, { month: "long" }).format(now);

    nodes.forEach((node) => (node.textContent = label));
  })();

  // The CTA is absent on narrow screens. Fixed home-page bars also leave the
  // accessibility tree once their scroll fade completes, then return with
  // their native tab order when the visitor scrolls back to the top.
  (() => {
    const bar = document.getElementById("promo-top-bar");
    const cta = document.querySelector<HTMLAnchorElement>("[data-promo-cta]");
    if (!bar || !cta) return;

    const desktop = window.matchMedia("(min-width: 640px)");
    const fixedVariant =
      bar.dataset.promoVariant === "fixed" || getComputedStyle(bar).position === "fixed";
    const fadeEnd = 80;
    let scrolledHidden = false;
    let ticking = false;

    const syncAccessibility = () => {
      bar.setAttribute("aria-hidden", String(scrolledHidden));
      bar.inert = scrolledHidden;

      const ctaHidden = scrolledHidden || !desktop.matches;
      cta.setAttribute("aria-hidden", String(ctaHidden));
      if (ctaHidden) cta.tabIndex = -1;
      else cta.removeAttribute("tabindex");
    };

    const update = () => {
      const progress = fixedVariant && desktop.matches
        ? Math.min(1, Math.max(0, window.scrollY / fadeEnd))
        : 0;
      scrolledHidden = progress >= 0.95;
      bar.style.opacity = String(1 - progress);
      bar.style.transform = `translateY(${-progress * 110}%)`;
      bar.style.pointerEvents = scrolledHidden ? "none" : "";
      syncAccessibility();
    };

    update();
    if (fixedVariant) {
      window.addEventListener(
        "scroll",
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            update();
            ticking = false;
          });
        },
        { passive: true },
      );
    }
    desktop.addEventListener("change", update);
  })();
</script>
