---
import type { Locale } from '../i18n/config';
import type { VenueSlug } from '../data/venues';
import { getVenueLicenseLookup } from '../data/venueLicenses';
import { venueLicenseCopy } from '../i18n/venueLicense';

interface Props {
  lang: Locale;
  slug: VenueSlug;
  venueName: string;
}

const { lang, slug, venueName } = Astro.props;
const copy = venueLicenseCopy[lang];
const lookup = getVenueLicenseLookup(slug, lang);
const linkText = lookup.hasVenueSearch
  ? copy.link.replace('{venue}', () => venueName)
  : copy.directory;
---

<p
  data-spa-license
  class="mt-10 flex flex-wrap items-center justify-center gap-x-2 border-t border-white/10 pt-5 text-center text-xs leading-relaxed text-white/55 sm:text-sm"
>
  <span>{copy.intro}</span>
  <span class="hidden sm:inline" aria-hidden="true">·</span>
  <a
    href={lookup.url}
    target="_blank"
    rel="noopener noreferrer"
    data-license-lookup
    data-floating-actions-exclusion
    class="inline-flex min-h-11 max-w-full items-center justify-center gap-1.5 rounded-sm text-gold/80 underline decoration-gold/35 underline-offset-4 transition-colors hover:text-gold-light focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold motion-reduce:transition-none"
  >
    <span>{linkText}</span>
    <span class="shrink-0" aria-hidden="true">↗</span>
  </a>
</p>
