---
import { getDictionary } from "../i18n";
import { localizePath, type Locale } from "../i18n/config";
import Icon from "./Icon.astro";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<div
  id="floating-actions"
  class="fixed bottom-4 right-4 z-[120] flex flex-col items-end gap-3 sm:bottom-5 sm:right-5"
>
  <button
    id="floating-back-to-top"
    data-floating-back-to-top
    type="button"
    aria-label={t.footer.backToTop}
    aria-hidden="true"
    tabindex="-1"
    class="relative inline-flex h-11 w-11 translate-y-2 items-center justify-center rounded-full border border-gold/35 bg-[#0a0a0a]/80 text-gold opacity-0 shadow-md shadow-black/25 backdrop-blur-md transition-[opacity,transform,background-color,border-color] duration-300 ease-out hover:border-gold/70 hover:bg-[#141414] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold motion-reduce:transition-none pointer-events-none"
  >
    <svg
      data-reading-progress
      viewBox="0 0 46 46"
      class="pointer-events-none absolute -inset-px h-[46px] w-[46px] -rotate-90"
      aria-hidden="true"
    >
      <circle
        cx="23"
        cy="23"
        r="21"
        pathLength="100"
        fill="none"
        stroke="currentColor"
        stroke-opacity="0.2"
        stroke-width="2"
      />
      <circle
        data-reading-progress-ring
        cx="23"
        cy="23"
        r="21"
        pathLength="100"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-dasharray="100"
        stroke-dashoffset="100"
      />
    </svg>
    <Icon name="arrow-up" class="relative h-5 w-5" />
  </button>

  <a
    id="floating-contact-pill"
    href={localizePath(lang, "/contact/")}
    aria-label={t.floatingPill.aria}
    class="inline-flex items-center gap-1.5 rounded-full bg-gold/80 px-3.5 py-2 text-xs font-semibold text-black opacity-0 shadow-md shadow-black/20 ring-1 ring-gold/20 backdrop-blur-md transition-opacity duration-300 ease-out hover:bg-gold sm:px-4 sm:py-2 sm:text-[13px] motion-reduce:transition-none pointer-events-none"
  >
    <span class="relative flex h-2 w-2">
      <span class="absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75 animate-ping"
      ></span>
      <span class="relative inline-flex h-2 w-2 rounded-full bg-green-500"></span>
    </span>
    {t.floatingPill.label}
  </a>
</div>

<script>
  (() => {
    const pill = document.getElementById("floating-contact-pill");
    const backToTop = document.getElementById("floating-back-to-top");
    if (!pill || !backToTop) return;
    const progressRing = backToTop.querySelector<SVGCircleElement>(
      "[data-reading-progress-ring]",
    );

    const reduceMotion = () =>
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    pill.addEventListener("click", (event) => {
      const target = document.getElementById("contact");
      if (!target) return;
      event.preventDefault();
      target.scrollIntoView({ behavior: reduceMotion() ? "auto" : "smooth", block: "start" });
    });

    backToTop.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: reduceMotion() ? "auto" : "smooth" });
    });

    const updateBackToTop = () => {
      const visible = window.scrollY > Math.max(320, window.innerHeight * 0.6);
      backToTop.classList.toggle("opacity-0", !visible);
      backToTop.classList.toggle("translate-y-2", !visible);
      backToTop.classList.toggle("pointer-events-none", !visible);
      backToTop.classList.toggle("opacity-100", visible);
      backToTop.classList.toggle("translate-y-0", visible);
      backToTop.classList.toggle("pointer-events-auto", visible);
      backToTop.setAttribute("aria-hidden", String(!visible));
      backToTop.tabIndex = visible ? 0 : -1;

      if (progressRing) {
        const total = Math.max(
          1,
          document.documentElement.scrollHeight - window.innerHeight,
        );
        const ratio = Math.min(1, Math.max(0, window.scrollY / total));
        progressRing.style.strokeDashoffset = String(100 - ratio * 100);
      }
    };

    let backToTopFrame = 0;
    const queueBackToTopUpdate = () => {
      if (backToTopFrame) return;
      backToTopFrame = requestAnimationFrame(() => {
        backToTopFrame = 0;
        updateBackToTop();
      });
    };

    updateBackToTop();
    window.addEventListener("scroll", queueBackToTopUpdate, { passive: true });
    window.addEventListener("resize", queueBackToTopUpdate, { passive: true });

    const show = () => {
      pill.classList.remove("opacity-0", "pointer-events-none");
      pill.classList.add("opacity-100", "pointer-events-auto");
    };
    const hide = () => {
      pill.classList.remove("opacity-100", "pointer-events-auto");
      pill.classList.add("opacity-0", "pointer-events-none");
    };

    // The hero already offers the same call to action, so stay hidden until it
    // has scrolled away.
    const heroRow = document.querySelector('[data-testid="hero-icon-row"]');
    if (typeof IntersectionObserver === "undefined" || !heroRow) {
      show();
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => entries.forEach((entry) => (entry.intersectionRatio < 0.1 ? show() : hide())),
      { threshold: [0, 0.1, 0.5] },
    );
    observer.observe(heroRow);
  })();
</script>
