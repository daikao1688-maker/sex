---
import Icon from "./Icon.astro";
import { getDictionary } from "../i18n";
import type { Locale } from "../i18n/config";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);

const backdrops = [
  {
    src: "/covers/macau-sauna-night-skyline.jpg",
    smallSrc: "/covers/macau-sauna-night-skyline-768.jpg",
    width: 2048,
    height: 1366,
    alt: "Macau sauna concierge — Macau night skyline, VIP booking & luxury pickup",
    position: "object-center",
  },
  {
    src: "/covers/macau-sauna-cotai-casino-skyline-night.jpg",
    smallSrc: "/covers/macau-sauna-cotai-casino-skyline-night-768.jpg",
    width: 1600,
    height: 1066,
    alt: "Macau sauna VIP concierge — Cotai casino skyline at night, luxury chauffeur pickup",
    position: "object-[20%_50%] sm:object-center",
  },
  {
    src: "/covers/macau-sauna-tower-fireworks-night.webp",
    smallSrc: "/covers/macau-sauna-tower-fireworks-night-768.webp",
    width: 1248,
    height: 832,
    alt: "Macau sauna concierge for travelers — Macau Tower fireworks at night",
    position: "object-[80%_50%] sm:object-center",
  },
];

const stepIcons = ["message-circle", "car", "star"] as const;
---

<section
  class="relative min-h-screen flex items-start justify-center overflow-hidden pt-[9.5rem] sm:pt-[12rem] pb-12 sm:pb-16"
  data-hero-motion
  data-motion-state="running"
>
  <div class="absolute inset-0 z-0" data-hero-backdrops>
    {
      backdrops.map((image, index) => (
        <div
          class={`hero-backdrop absolute inset-0 ${index === 0 ? "is-active" : ""}`}
          aria-hidden={index === 0 ? "false" : "true"}
          data-hero-backdrop
          data-zoom-direction={index % 2 === 0 ? "in" : "out"}
        >
          <img
            src={index === 0 ? image.src : undefined}
            srcset={index === 0 ? `${image.smallSrc} 768w, ${image.src} ${image.width}w` : undefined}
            sizes="100vw"
            data-src={index === 0 ? undefined : image.src}
            data-srcset={index === 0 ? undefined : `${image.smallSrc} 768w, ${image.src} ${image.width}w`}
            data-alt={image.alt}
            alt={index === 0 ? image.alt : ""}
            width={image.width}
            height={image.height}
            fetchpriority={index === 0 ? "high" : "low"}
            decoding="async"
            loading={index === 0 ? "eager" : "lazy"}
            class={`w-full h-full object-cover ${image.position}`}
          />
        </div>
      ))
    }
  </div>
  <div class="absolute inset-0 z-[1] bg-gradient-to-b from-black/75 via-black/60 to-[#0a0a0a]"></div>
  <button
    type="button"
    data-hero-motion-toggle
    aria-pressed="false"
    aria-label="Pause background motion"
    class="absolute bottom-4 right-4 z-20 flex min-h-11 min-w-11 items-center justify-center rounded-full border border-white/20 bg-black/60 text-sm text-white transition-colors hover:border-gold hover:text-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold"
  >
    <span aria-hidden="true" data-hero-motion-icon>❚❚</span>
  </button>

  <div class="relative z-10 text-center px-4 max-w-4xl mx-auto pt-6">
    <h1 class="text-[28px] sm:text-4xl md:text-5xl font-bold mb-3 tracking-wider">{t.hero.title}</h1>
    <p class="text-sm sm:text-lg md:text-xl font-medium text-gold mb-4">{t.hero.tagline}</p>

    <p
      class="grid text-base min-[430px]:text-lg sm:text-lg text-white/70 mb-6 whitespace-pre-line"
      data-hero-venues
    >
      {
        t.hero.venueGroups.map((group, index) => (
          <span
            class="transition-opacity duration-700"
            style={`grid-area:1 / 1;opacity:${index === 0 ? 1 : 0}`}
            aria-hidden={index === 0 ? "false" : "true"}
            data-hero-venue-group
          >
            {group}
          </span>
        ))
      }
    </p>

    <div data-testid="hero-icon-row" class="flex items-start justify-center gap-1.5 sm:gap-4 mb-8">
      {
        t.hero.steps.map((step, index) => (
          <>
            {index > 0 && (
              <span class="text-gold text-base sm:text-xl font-black mt-2 sm:mt-3">→</span>
            )}
            <div class="fade-up flex flex-col items-center gap-1" style={`transition-delay:${index * 0.12}s`}>
              <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-gold/50 border border-gold/50 flex items-center justify-center">
                <Icon name={stepIcons[index]} class="w-5 h-5 sm:w-6 sm:h-6 text-gold" />
              </div>
              <span class="text-white font-semibold text-sm min-[400px]:text-base min-[430px]:text-lg sm:text-lg whitespace-nowrap">
                {step.title.map((segment) => (
                  <span class={segment.accent ? "text-gold" : undefined}>{segment.text}</span>
                ))}
              </span>
              <span class="text-xs min-[430px]:text-base sm:text-base text-center">
                {step.desc.map((line, lineIndex) => (
                  <>
                    {lineIndex > 0 && <br />}
                    {line.map((segment) => (
                      <span class={segment.accent ? "text-gold font-bold" : "text-white"}>
                        {segment.text}
                      </span>
                    ))}
                  </>
                ))}
              </span>
            </div>
          </>
        ))
      }
    </div>

    <div class="flex flex-col items-center gap-3 w-full max-w-[280px] mx-auto">
      <a
        href="#spas"
        class="glow-gold relative flex min-h-11 items-center justify-center overflow-hidden w-full px-6 py-2.5 bg-gold hover:bg-gold-dark text-black font-semibold rounded-full transition-colors duration-300 tracking-wider text-center"
      >
        <span aria-hidden="true" class="shimmer-gold pointer-events-none absolute inset-0"></span>
        <span class="relative">↓ {t.hero.exploreCta}</span>
      </a>
      <div class="flex w-full gap-3">
        <a
          href="#vip-treats"
          class="flex min-h-11 flex-1 items-center justify-center px-3 py-2.5 border border-gold/50 text-gold hover:bg-gold/10 rounded-full transition-all duration-300 text-sm text-center"
        >
          {t.hero.howItWorksCta}
        </a>
        <a
          href="#contact"
          class="flex min-h-11 flex-1 items-center justify-center px-3 py-2.5 border border-gold/50 text-gold hover:bg-gold/10 rounded-full transition-all duration-300 text-sm text-center"
        >
          {t.hero.bookCta}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-backdrop {
    z-index: 0;
    opacity: 0;
    overflow: hidden;
    transition: opacity 1.35s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity;
  }

  .hero-backdrop.is-active {
    z-index: 2;
    opacity: 1;
  }

  .hero-backdrop.is-leaving {
    z-index: 1;
    opacity: 0;
  }

  .hero-backdrop img {
    transform: scale(1.06);
    will-change: transform;
  }

  [data-hero-motion][data-motion-state="paused"] .hero-backdrop img {
    animation-play-state: paused;
  }

  .hero-backdrop[data-zoom-direction="in"]:is(.is-active, .is-leaving) img {
    animation: heroZoomIn 7.2s cubic-bezier(0.2, 0.6, 0.4, 1) forwards;
  }

  .hero-backdrop[data-zoom-direction="out"]:is(.is-active, .is-leaving) img {
    animation: heroZoomOut 7.2s cubic-bezier(0.2, 0.6, 0.4, 1) forwards;
  }

  @keyframes heroZoomIn {
    from {
      transform: scale(1.03);
    }
    to {
      transform: scale(1.085);
    }
  }

  @keyframes heroZoomOut {
    from {
      transform: scale(1.085);
    }
    to {
      transform: scale(1.03);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-backdrop {
      transition: none;
    }

    .hero-backdrop img,
    .hero-backdrop[data-zoom-direction="in"]:is(.is-active, .is-leaving) img,
    .hero-backdrop[data-zoom-direction="out"]:is(.is-active, .is-leaving) img {
      animation: none;
      transform: scale(1.06);
    }
  }
</style>

<script>
  // Cross-fade the hero only while it is visible, in view, and not paused.
  (() => {
    const hero = document.querySelector<HTMLElement>("[data-hero-motion]");
    const toggle = document.querySelector<HTMLButtonElement>("[data-hero-motion-toggle]");
    const icon = document.querySelector<HTMLElement>("[data-hero-motion-icon]");
    const backdrops = document.querySelectorAll<HTMLElement>("[data-hero-backdrop]");
    const venueGroups = document.querySelectorAll<HTMLElement>("[data-hero-venue-group]");
    if (!hero || !toggle || !icon || backdrops.length < 2 || venueGroups.length < 2) return;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let manuallyPaused = false;
    let inViewport = true;
    let backdropIndex = 0;
    let venueIndex = 0;
    let backdropTimer = 0;
    let backdropPreloadTimer = 0;
    let venueTimer = 0;

    const canAnimate = () =>
      !reducedMotion.matches &&
      !manuallyPaused &&
      inViewport &&
      document.visibilityState !== "hidden";

    const syncVenue = (nextIndex: number) => {
      venueGroups.forEach((group, index) => {
        const active = index === nextIndex;
        group.style.opacity = active ? "1" : "0";
        group.setAttribute("aria-hidden", String(!active));
      });
    };

    const syncBackdrop = (nextIndex: number) => {
      backdrops.forEach((backdrop, index) => {
        const active = index === nextIndex;
        const leaving = index === backdropIndex && !active;
        backdrop.classList.toggle("is-active", active);
        backdrop.classList.toggle("is-leaving", leaving);
        backdrop.setAttribute("aria-hidden", String(!active));
        const image = backdrop.querySelector?.<HTMLImageElement>("img");
        if (image) image.alt = active ? image.dataset.alt ?? "" : "";
      });
      backdropIndex = nextIndex;
    };

    const prepareBackdrop = (index: number) => {
      const image = backdrops[index]?.querySelector?.<HTMLImageElement>("img");
      if (!image || image.getAttribute("src")) return;
      const source = image.dataset.src;
      if (!source) return;
      if (image.dataset.srcset) image.srcset = image.dataset.srcset;
      image.src = source;
    };

    const stopTimers = () => {
      window.clearTimeout(backdropTimer);
      window.clearTimeout(backdropPreloadTimer);
      window.clearTimeout(venueTimer);
    };

    const queueBackdrop = () => {
      const nextIndex = (backdropIndex + 1) % backdrops.length;
      backdropPreloadTimer = window.setTimeout(() => {
        if (canAnimate()) prepareBackdrop(nextIndex);
      }, 5000);
      backdropTimer = window.setTimeout(() => {
        if (!canAnimate()) return;
        prepareBackdrop(nextIndex);
        syncBackdrop(nextIndex);
        queueBackdrop();
      }, 6000);
    };

    const queueVenue = () => {
      venueTimer = window.setTimeout(() => {
        if (!canAnimate()) return;
        venueIndex = (venueIndex + 1) % venueGroups.length;
        syncVenue(venueIndex);
        queueVenue();
      }, 4500);
    };

    const renderState = () => {
      stopTimers();
      const running = canAnimate();
      hero.dataset.motionState = reducedMotion.matches ? "reduced" : running ? "running" : "paused";
      toggle.setAttribute("aria-pressed", String(manuallyPaused));
      toggle.setAttribute("aria-label", manuallyPaused ? "Resume background motion" : "Pause background motion");
      toggle.toggleAttribute("disabled", reducedMotion.matches);
      icon.textContent = manuallyPaused ? "▶" : "❚❚";
      if (!running) return;
      queueBackdrop();
      queueVenue();
    };

    toggle.addEventListener("click", () => {
      manuallyPaused = !manuallyPaused;
      renderState();
    });
    document.addEventListener("visibilitychange", renderState);
    reducedMotion.addEventListener?.("change", renderState);
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        ([entry]) => {
          inViewport = entry.isIntersecting;
          renderState();
        },
        { threshold: 0.1 },
      ).observe(hero);
    }

    syncBackdrop(backdropIndex);
    syncVenue(venueIndex);
    renderState();
  })();
</script>
