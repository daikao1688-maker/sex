---
import Icon from "./Icon.astro";
import { getDictionary } from "../i18n";
import type { Locale } from "../i18n/config";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);

const backdrops = [
  {
    src: "/covers/macau-sauna-hero-grand-lisboa-night.webp",
    smallSrc: "/covers/macau-sauna-hero-grand-lisboa-night-768.webp",
    width: 1448,
    height: 1086,
    position: "object-center",
  },
  {
    src: "/covers/macau-sauna-hero-balcony-police-night.webp",
    smallSrc: "/covers/macau-sauna-hero-balcony-police-night-768.webp",
    width: 1448,
    height: 1086,
    position: "object-center sm:object-[50%_5%]",
  },
  {
    src: "/covers/macau-sauna-hero-theme-room-duo-night.webp",
    smallSrc: "/covers/macau-sauna-hero-theme-room-duo-night-768.webp",
    width: 1535,
    height: 1024,
    position: "object-[50%_10%] sm:object-center",
  },
];

const stepIcons = ["message-circle", "car", "star"] as const;
---

<section
  class="relative min-h-screen flex items-start justify-center overflow-hidden pt-[9.5rem] sm:pt-[12rem] pb-12 sm:pb-16"
  data-hero-motion
  data-motion-state="running"
>
  <div class="absolute inset-0 z-0" data-hero-backdrops>
    {
      backdrops.map((image, index) => (
        <div
          class={`hero-backdrop absolute inset-0 ${index === 0 ? "is-active is-initial" : ""}`}
          aria-hidden="true"
          data-hero-backdrop
        >
          <img
            src={index === 0 ? image.src : undefined}
            srcset={index === 0 ? `${image.smallSrc} 768w, ${image.src} ${image.width}w` : undefined}
            sizes="100vw"
            data-src={index === 0 ? undefined : image.src}
            data-srcset={index === 0 ? undefined : `${image.smallSrc} 768w, ${image.src} ${image.width}w`}
            alt=""
            width={image.width}
            height={image.height}
            fetchpriority={index === 0 ? "high" : "low"}
            decoding="async"
            loading={index === 0 ? "eager" : "lazy"}
            class={`w-full h-full object-cover ${image.position}`}
          />
        </div>
      ))
    }
  </div>
  <div class="absolute inset-0 z-[1] bg-gradient-to-b from-black/75 via-black/60 to-[#0a0a0a]"></div>
  <div class="relative z-10 text-center px-4 max-w-4xl mx-auto pt-6">
    <h1 class="text-[28px] sm:text-4xl md:text-5xl font-bold mb-3 tracking-wider">{t.hero.title}</h1>
    <p class="hero-tagline-pulse text-sm sm:text-lg md:text-xl font-medium text-gold mb-4">{t.hero.tagline}</p>

    <p
      class="grid text-base min-[430px]:text-lg sm:text-lg text-white/70 mb-6 whitespace-pre-line"
      data-hero-venues
    >
      {
        t.hero.venueGroups.map((group, index) => (
          <span
            class="transition-opacity duration-300"
            style={`grid-area:1 / 1;opacity:${index === 0 ? 1 : 0}`}
            aria-hidden={index === 0 ? "false" : "true"}
            data-hero-venue-group
          >
            {group}
          </span>
        ))
      }
    </p>

    <div data-testid="hero-icon-row" class="flex items-start justify-center gap-1.5 sm:gap-4 mb-8">
      {
        t.hero.steps.map((step, index) => (
          <>
            {index > 0 && (
              <span class="text-gold text-base sm:text-xl font-black mt-2 sm:mt-3">→</span>
            )}
            <div class="fade-up flex flex-col items-center gap-1" style={`transition-delay:${index * 0.12}s`}>
              <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-gold/50 border border-gold/50 flex items-center justify-center">
                <Icon name={stepIcons[index]} class="w-5 h-5 sm:w-6 sm:h-6 text-gold" />
              </div>
              <span class="text-white font-semibold text-sm min-[400px]:text-base min-[430px]:text-lg sm:text-lg whitespace-nowrap">
                {step.title.map((segment) => (
                  <span class={segment.accent ? "text-gold" : undefined}>{segment.text}</span>
                ))}
              </span>
              <span class="text-xs min-[430px]:text-base sm:text-base text-center">
                {step.desc.map((line, lineIndex) => (
                  <>
                    {lineIndex > 0 && <br />}
                    {line.map((segment) => (
                      <span class={segment.accent ? "text-gold font-bold" : "text-white"}>
                        {segment.text}
                      </span>
                    ))}
                  </>
                ))}
              </span>
            </div>
          </>
        ))
      }
    </div>

    <div class="flex flex-col items-center gap-3 w-full max-w-[280px] mx-auto">
      <a
        href="#spas"
        class="glow-gold relative flex min-h-11 items-center justify-center overflow-hidden w-full px-6 py-2.5 bg-gold hover:bg-gold-dark text-black font-semibold rounded-full transition-colors duration-300 tracking-wider text-center"
      >
        <span aria-hidden="true" class="shimmer-gold pointer-events-none absolute inset-0"></span>
        <span class="relative">↓ {t.hero.exploreCta}</span>
      </a>
      <div class="flex w-full gap-3">
        <a
          href="#vip-treats"
          class="flex min-h-11 flex-1 items-center justify-center px-3 py-2.5 border border-gold/50 text-gold hover:bg-gold/10 rounded-full transition-all duration-300 text-sm text-center"
        >
          {t.hero.howItWorksCta}
        </a>
        <a
          href="#contact"
          class="flex min-h-11 flex-1 items-center justify-center px-3 py-2.5 border border-gold/50 text-gold hover:bg-gold/10 rounded-full transition-all duration-300 text-sm text-center"
        >
          {t.hero.bookCta}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Motion spec matches macau-night.hk's HomeHero island: 4s per slide,
     1.4s ease-in-out cross-fade, 5.4s linear zoom-out (1.08 → 1). */
  .hero-backdrop {
    z-index: 0;
    opacity: 0;
    overflow: hidden;
    transition: opacity 1.4s ease-in-out;
    will-change: opacity;
  }

  .hero-backdrop.is-active {
    z-index: 2;
    opacity: 1;
  }

  .hero-backdrop.is-leaving {
    z-index: 1;
    opacity: 0;
  }

  .hero-backdrop img {
    transform: scale(1.08);
    /* Transition (not keyframes): a leaving slide eases back to 1.08 over
       the same 5.4s instead of snapping mid-fade — matches framer-motion. */
    transition: transform 5.4s linear;
    will-change: transform;
  }

  .hero-backdrop.is-active img {
    transform: scale(1);
  }

  /* First slide starts pinned at 1.08 so removing this class after first
     paint gives the transition a "before" state — otherwise the zoom never
     plays on the initial slide (transitions only run on class changes). */
  .hero-backdrop.is-initial img {
    transform: scale(1.08);
  }

  .hero-tagline-pulse {
    animation: heroTaglinePulse 10s ease-in-out infinite;
  }

  @keyframes heroTaglinePulse {
    0%,
    100% {
      opacity: 1;
    }
    25%,
    75% {
      opacity: 0.7;
    }
    50% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-backdrop,
    .hero-backdrop img {
      transition: none;
    }

    .hero-backdrop img,
    .hero-backdrop.is-active img {
      transform: scale(1.08);
    }

    .hero-tagline-pulse {
      animation: none;
    }
  }
</style>

<script>
  // Cross-fade the hero only while it is visible, in view, and motion is allowed.
  (() => {
    const hero = document.querySelector<HTMLElement>("[data-hero-motion]");
    const backdrops = document.querySelectorAll<HTMLElement>("[data-hero-backdrop]");
    const venueGroups = document.querySelectorAll<HTMLElement>("[data-hero-venue-group]");
    if (!hero || backdrops.length < 2 || venueGroups.length < 2) return;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let inViewport = true;
    let backdropIndex = 0;
    let venueIndex = 0;
    let backdropTimer = 0;
    let backdropPreloadTimer = 0;
    let venueTimer = 0;
    let venueFadeTimer = 0;

    const canAnimate = () =>
      !reducedMotion.matches &&
      inViewport &&
      document.visibilityState !== "hidden";

    // Sequential fade: the outgoing group must reach opacity 0 before the
    // incoming one starts fading in, so the stacked texts never overlap.
    const VENUE_FADE_MS = 300;

    const syncVenue = (nextIndex: number) => {
      const next = venueGroups[nextIndex];
      if (nextIndex === venueIndex) {
        // Idempotent sync (init / resume): keep the active group exposed.
        next.style.opacity = "1";
        next.setAttribute("aria-hidden", "false");
        return;
      }
      const current = venueGroups[venueIndex];
      current.style.opacity = "0";
      current.setAttribute("aria-hidden", "true");
      venueIndex = nextIndex;
      window.clearTimeout(venueFadeTimer);
      venueFadeTimer = window.setTimeout(() => {
        next.style.opacity = "1";
        next.setAttribute("aria-hidden", "false");
      }, VENUE_FADE_MS);
    };

    const syncBackdrop = (nextIndex: number) => {
      backdrops.forEach((backdrop, index) => {
        const active = index === nextIndex;
        const leaving = index === backdropIndex && !active;
        backdrop.classList.toggle("is-active", active);
        backdrop.classList.toggle("is-leaving", leaving);
        if (leaving) {
          // Detach after the 1.4s fade so the zoom resets for the next pass.
          window.setTimeout(() => backdrop.classList.toggle("is-leaving", false), 1400);
        }
      });
      backdropIndex = nextIndex;
    };

    const prepareBackdrop = (index: number) => {
      const image = backdrops[index]?.querySelector?.<HTMLImageElement>("img");
      if (!image || image.getAttribute("src")) return;
      const source = image.dataset.src;
      if (!source) return;
      if (image.dataset.srcset) image.srcset = image.dataset.srcset;
      image.src = source;
    };

    const stopTimers = () => {
      window.clearTimeout(backdropTimer);
      window.clearTimeout(backdropPreloadTimer);
      window.clearTimeout(venueTimer);
      window.clearTimeout(venueFadeTimer);
    };

    const queueBackdrop = () => {
      const nextIndex = (backdropIndex + 1) % backdrops.length;
      backdropPreloadTimer = window.setTimeout(() => {
        if (canAnimate()) prepareBackdrop(nextIndex);
      }, 3000);
      backdropTimer = window.setTimeout(() => {
        if (!canAnimate()) return;
        prepareBackdrop(nextIndex);
        syncBackdrop(nextIndex);
        queueBackdrop();
      }, 4000);
    };

    const queueVenue = () => {
      venueTimer = window.setTimeout(() => {
        if (!canAnimate()) return;
        syncVenue((venueIndex + 1) % venueGroups.length);
        queueVenue();
      }, 4000);
    };

    const renderState = () => {
      stopTimers();
      const running = canAnimate();
      hero.dataset.motionState = reducedMotion.matches ? "reduced" : running ? "running" : "paused";
      if (!running) return;
      queueBackdrop();
      queueVenue();
    };

    document.addEventListener("visibilitychange", renderState);
    reducedMotion.addEventListener?.("change", renderState);
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        ([entry]) => {
          inViewport = entry.isIntersecting;
          renderState();
        },
        { threshold: 0.1 },
      ).observe(hero);
    }

    syncBackdrop(backdropIndex);
    syncVenue(venueIndex);
    // Kick the first slide's zoom: unpin it two frames in so the browser has
    // committed scale(1.08) and the 5.4s transition animates from there.
    const kickFirstZoom = () => backdrops[0]?.classList.remove?.("is-initial");
    if (typeof window.requestAnimationFrame === "function") {
      window.requestAnimationFrame(() => window.requestAnimationFrame(kickFirstZoom));
    } else {
      window.setTimeout(kickFirstZoom, 50);
    }
    renderState();
  })();
</script>
