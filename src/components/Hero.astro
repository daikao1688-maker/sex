---
import Icon from "./Icon.astro";
import { getDictionary } from "../i18n";
import type { Locale } from "../i18n/config";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const venueLineCount = Math.max(...t.hero.venueGroups.map((group) => group.split("\n").length));

// Every locale's hero title contains an uppercase "VIP" segment — wrap it for
// the metallic gold treatment. Falls back to the plain title if absent.
const vipIndex = t.hero.title.indexOf("VIP");
const titleBefore = vipIndex >= 0 ? t.hero.title.slice(0, vipIndex) : t.hero.title;
const titleAfter = vipIndex >= 0 ? t.hero.title.slice(vipIndex + 3) : "";

const backdrops = [
  {
    src: "/covers/macau-hero-parisian-night.webp",
    smallSrc: "/covers/macau-hero-parisian-night-768.webp",
    width: 1448,
    height: 1086,
    position: "object-[30%_center] sm:object-center",
  },
  {
    src: "/covers/macau-hero-studio-city-sunset.webp",
    smallSrc: "/covers/macau-hero-studio-city-sunset-768.webp",
    width: 1448,
    height: 1086,
    position: "object-center",
  },
  {
    src: "/covers/macau-hero-mgm-lion-night.webp",
    smallSrc: "/covers/macau-hero-mgm-lion-night-768.webp",
    width: 1448,
    height: 1086,
    position: "object-center",
  },
];

const stepIcons = ["message-circle", "car", "star"] as const;
---

<section
  class="relative min-h-screen flex items-start justify-center overflow-hidden pt-[9.5rem] sm:pt-[12rem] pb-12 sm:pb-16"
  data-hero-motion
  data-motion-state="running"
>
  <div class="absolute inset-0 z-0" data-hero-backdrops>
    {
      backdrops.map((image, index) => (
        <div
          class={`hero-backdrop absolute inset-0 ${index === 0 ? "is-active is-initial" : ""}`}
          aria-hidden="true"
          data-hero-backdrop
        >
          <img
            src={index === 0 ? image.src : undefined}
            srcset={index === 0 ? `${image.smallSrc} 768w, ${image.src} ${image.width}w` : undefined}
            sizes="100vw"
            data-src={index === 0 ? undefined : image.src}
            data-srcset={index === 0 ? undefined : `${image.smallSrc} 768w, ${image.src} ${image.width}w`}
            alt=""
            width={image.width}
            height={image.height}
            fetchpriority={index === 0 ? "high" : "low"}
            decoding="async"
            loading={index === 0 ? "eager" : "lazy"}
            class={`w-full h-full object-cover ${image.position}`}
          />
        </div>
      ))
    }
  </div>
  <div class="absolute inset-0 z-[1] bg-gradient-to-b from-black/75 via-black/65 to-[#0a0a0a]"></div>
  <div class="relative z-10 text-center px-4 max-w-4xl mx-auto pt-6">
    <h1 class="hero-title-reveal text-[28px] sm:text-4xl md:text-5xl font-bold mb-1 tracking-wider">
      {titleBefore}{vipIndex >= 0 && <span class="hero-vip-metallic">VIP</span>}{titleAfter}
    </h1>
    <span class="hero-title-rule" aria-hidden="true"></span>
    <p class="hero-enter text-sm sm:text-lg md:text-xl font-medium text-gold mb-5 mt-3" style="--enter-delay: 0.3s">
      {t.hero.tagline}
    </p>

    <p
      class="hero-enter hero-venue-viewport flex items-center justify-center overflow-hidden text-sm min-[430px]:text-base sm:text-base text-white/70 mb-7 sm:mb-8 whitespace-pre-line"
      style={`--hero-venue-lines:${venueLineCount}; --enter-delay: 0.6s`}
      data-hero-venues
      data-hero-venue-groups={JSON.stringify(t.hero.venueGroups)}
    >
      <span class="hero-venue-text block w-full" data-hero-venue-text>{t.hero.venueGroups[0]}</span>
    </p>

    <div data-testid="hero-icon-row" class="flex items-start justify-center gap-1.5 sm:gap-4 mb-10 sm:mb-11">
      {
        t.hero.steps.map((step, index) => (
          <>
            {index > 0 && (
              <span class="hero-enter text-gold/70 text-base sm:text-xl font-medium mt-2 sm:mt-3" style={`--enter-delay: ${0.9 + index * 0.18}s`} aria-hidden="true">→</span>
            )}
            <div class="hero-enter flex flex-col items-center gap-1.5" style={`--enter-delay: ${0.9 + index * 0.18}s`}>
              <div class="hero-step-icon w-10 h-10 sm:w-12 sm:h-12 rounded-full flex items-center justify-center">
                <Icon name={stepIcons[index]} class="w-5 h-5 sm:w-6 sm:h-6 text-gold-light" />
              </div>
              <span class="text-white font-semibold text-sm min-[400px]:text-base min-[430px]:text-lg sm:text-lg whitespace-nowrap">
                {step.title.map((segment) => (
                  <span class={segment.accent ? "text-gold" : undefined}>{segment.text}</span>
                ))}
              </span>
              <span class="text-xs min-[430px]:text-sm sm:text-sm leading-relaxed text-center">
                {step.desc.map((line, lineIndex) => (
                  <>
                    {lineIndex > 0 && <br />}
                    {line.map((segment) => (
                      <span class={segment.accent && index === 2 ? "text-gold/90 font-medium" : "text-white/70"}>
                        {segment.text}
                      </span>
                    ))}
                  </>
                ))}
              </span>
            </div>
          </>
        ))
      }
    </div>

    <div class="hero-actions flex flex-col items-center gap-3 w-full max-w-[280px] mx-auto">
      <div class="hero-enter w-full" style="--enter-delay: 1.45s">
        <a
          href="#spas"
          class="hero-cta hero-cta-primary relative flex min-h-11 items-center justify-center overflow-hidden w-full px-6 py-2.5 bg-gold hover:bg-gold-dark text-black font-semibold rounded-full transition-colors duration-300 tracking-wider text-center"
        >
          <span aria-hidden="true" class="hero-cta-sheen pointer-events-none absolute inset-0"></span>
          <span class="relative">↓ {t.hero.exploreCta}</span>
        </a>
      </div>
      <div class="hero-enter flex w-full gap-3" style="--enter-delay: 1.6s" data-hero-secondary-cta>
        <a
          href="#vip-treats"
          class="hero-cta flex min-h-11 flex-1 items-center justify-center px-3 py-2.5 border border-white/25 bg-black/20 text-white/80 hover:border-gold/50 hover:text-gold rounded-full transition-all duration-300 text-sm text-center"
        >
          {t.hero.howItWorksCta}
        </a>
        <a
          href="#contact"
          class="hero-cta flex min-h-11 flex-1 items-center justify-center px-3 py-2.5 border border-white/25 bg-black/20 text-white/80 hover:border-gold/50 hover:text-gold rounded-full transition-all duration-300 text-sm text-center"
        >
          {t.hero.bookCta}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Motion spec matches macau-night.hk's HomeHero island: 4s per slide,
     1.4s ease-in-out cross-fade, 5.4s linear zoom-out (1.08 → 1). */
  .hero-backdrop {
    z-index: 0;
    opacity: 0;
    overflow: hidden;
    transition: opacity 1.4s ease-in-out;
    will-change: opacity;
  }

  .hero-backdrop.is-active {
    z-index: 2;
    opacity: 1;
  }

  .hero-backdrop.is-leaving {
    z-index: 1;
    opacity: 0;
  }

  .hero-backdrop img {
    transform: scale(1.08);
    /* Transition (not keyframes): a leaving slide eases back to 1.08 over
       the same 5.4s instead of snapping mid-fade — matches framer-motion. */
    transition: transform 5.4s linear;
    will-change: transform;
  }

  .hero-backdrop.is-active img {
    transform: scale(1);
  }

  /* First slide starts pinned at 1.08 so removing this class after first
     paint gives the transition a "before" state — otherwise the zoom never
     plays on the initial slide (transitions only run on class changes). */
  .hero-backdrop.is-initial img {
    transform: scale(1.08);
  }

  /* One entrance timeline, independent of the page's scroll-reveal observer:
     title → tagline → venues → individual steps → primary/secondary actions. */

  .hero-title-reveal {
    /* Keep wrapping stable throughout the reveal, including narrow screens. */
    letter-spacing: 0.025em;
    animation: heroTitleReveal 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes heroTitleReveal {
    from {
      opacity: 0;
      filter: blur(8px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }

  /* Keep the metallic finish still once the heading has appeared. */
  .hero-vip-metallic {
    background: linear-gradient(
      180deg,
      #f5d67b 0%,
      #b8912b 45%,
      #ffe9a8 50%,
      #8a6d1f 55%,
      #e8c96b 100%
    );
    background-size: 100% 220%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Fallback: no background-clip support → solid gold instead of invisible. */
  @supports not (background-clip: text) {
    .hero-vip-metallic {
      background: none;
      color: #d4af37;
    }
  }

  .hero-title-rule {
    display: block;
    width: 56px;
    height: 2px;
    margin: 8px auto 0;
    background: linear-gradient(90deg, transparent, #d4af37, transparent);
    transform: scaleX(0);
    transform-origin: center;
    animation: heroRuleDraw 0.4s ease-out 0.2s forwards;
  }

  @keyframes heroRuleDraw {
    to {
      transform: scaleX(1);
    }
  }

  .hero-enter {
    animation: heroEnter 0.35s cubic-bezier(0.22, 1, 0.36, 1) var(--enter-delay, 0s) both;
  }

  @keyframes heroEnter {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* A single sweep finishes the entrance without competing with the copy. */
  .hero-cta-sheen {
    background: linear-gradient(
      105deg,
      transparent 30%,
      rgba(255, 255, 255, 0.3) 50%,
      transparent 70%
    );
    transform: translateX(-110%);
    animation: heroSweep 0.65s ease-in-out 1.8s both;
  }

  @keyframes heroSweep {
    from {
      transform: translateX(-110%);
    }
    to {
      transform: translateX(110%);
    }
  }

  /* Steady rings support the steps without three competing pulse loops. */
  .hero-step-icon {
    background: rgba(212, 175, 55, 0.08);
    border: 1.5px solid rgba(212, 175, 55, 0.75);
    box-shadow: 0 0 10px rgba(212, 175, 55, 0.2);
  }

  .hero-cta-primary {
    box-shadow: 0 0 22px rgba(212, 175, 55, 0.22);
  }

  /* Keyboard users can reach the actions before their scheduled entrance. */
  .hero-actions:focus-within .hero-enter {
    opacity: 1 !important;
    transform: none !important;
  }

  /* Entrance lives on wrappers so it cannot override button press feedback. */
  .hero-cta {
    transition-property: color, background-color, border-color, transform;
  }

  .hero-cta:active {
    transform: scale(0.97);
    transition-duration: 150ms;
  }

  .hero-venue-viewport {
    height: calc(var(--hero-venue-lines, 2) * 1.65em);
    line-height: 1.65;
  }

  .hero-venue-text {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 220ms ease-out,
      transform 220ms ease-out;
    will-change: opacity, transform;
  }

  .hero-venue-text.is-exiting {
    opacity: 0;
    transform: translateY(-0.25rem);
    transition-duration: 180ms;
    transition-timing-function: ease-in;
  }

  .hero-venue-text.is-entering {
    opacity: 0;
    transform: translateY(0.25rem);
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-backdrop,
    .hero-backdrop img {
      transition: none;
    }

    .hero-backdrop img,
    .hero-backdrop.is-active img {
      transform: scale(1.08);
    }

    .hero-title-reveal,
    .hero-enter,
    .hero-title-rule {
      animation: none;
      opacity: 1;
      transform: none;
      filter: none;
    }

    .hero-title-rule {
      transform: scaleX(1);
    }

    .hero-cta-sheen {
      animation: none;
      display: none;
    }

    .hero-cta:active {
      transform: none;
    }

    .hero-venue-text,
    .hero-venue-text.is-exiting,
    .hero-venue-text.is-entering {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // Cross-fade the hero only while it is visible, in view, and motion is allowed.
  (() => {
    const hero = document.querySelector<HTMLElement>("[data-hero-motion]");
    const backdrops = document.querySelectorAll<HTMLElement>("[data-hero-backdrop]");
    const venueViewport = document.querySelector<HTMLElement>("[data-hero-venues]");
    const venueText = document.querySelector<HTMLElement>("[data-hero-venue-text]");
    let venueGroups: string[] = [];
    try {
      const parsed = JSON.parse(venueViewport?.dataset.heroVenueGroups ?? "[]");
      if (Array.isArray(parsed) && parsed.every((group) => typeof group === "string")) {
        venueGroups = parsed;
      }
    } catch {
      venueGroups = [];
    }
    if (!hero || backdrops.length < 2 || !venueText || venueGroups.length < 2) return;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let inViewport = true;
    let backdropIndex = 0;
    let venueIndex = 0;
    let backdropTimer = 0;
    let backdropPreloadTimer = 0;
    let backdropCycleToken = 0;
    const backdropReady = new Map<number, Promise<boolean>>();
    const failedBackdrops = new Set<number>();
    let venueTimer = 0;
    let venueFallbackTimer = 0;
    let venueEnterFrame = 0;
    let venueTransitionToken = 0;
    let venueTransitioning = false;
    let venueExitListener: ((event: TransitionEvent) => void) | null = null;

    const canAnimate = () =>
      !reducedMotion.matches &&
      inViewport &&
      document.visibilityState !== "hidden";

    const requestFrame = (callback: FrameRequestCallback) =>
      typeof window.requestAnimationFrame === "function"
        ? window.requestAnimationFrame(callback)
        : window.setTimeout(() => callback(performance.now()), 16);

    const cancelFrame = (frame: number) => {
      if (!frame) return;
      if (typeof window.cancelAnimationFrame === "function") window.cancelAnimationFrame(frame);
      else window.clearTimeout(frame);
    };

    const resetVenueTransition = () => {
      venueTransitionToken += 1;
      window.clearTimeout(venueFallbackTimer);
      cancelFrame(venueEnterFrame);
      if (venueExitListener) venueText.removeEventListener?.("transitionend", venueExitListener);
      venueExitListener = null;
      venueFallbackTimer = 0;
      venueEnterFrame = 0;
      venueTransitioning = false;
      venueText.classList.toggle("is-exiting", false);
      venueText.classList.toggle("is-entering", false);
    };

    const syncVenue = (nextIndex: number) => {
      if (nextIndex === venueIndex) {
        venueText.textContent = venueGroups[venueIndex];
        venueText.classList.toggle("is-exiting", false);
        venueText.classList.toggle("is-entering", false);
        return;
      }
      if (venueTransitioning) return;

      venueTransitioning = true;
      const token = ++venueTransitionToken;
      const finishExit = (event?: TransitionEvent) => {
        if (event && (event.target !== venueText || event.propertyName !== "opacity")) return;
        if (token !== venueTransitionToken) return;

        if (venueExitListener) venueText.removeEventListener?.("transitionend", venueExitListener);
        venueExitListener = null;
        window.clearTimeout(venueFallbackTimer);
        venueFallbackTimer = 0;

        venueText.textContent = venueGroups[nextIndex];
        venueIndex = nextIndex;
        venueText.classList.toggle("is-exiting", false);
        venueText.classList.toggle("is-entering", true);

        venueEnterFrame = requestFrame(() => {
          venueEnterFrame = requestFrame(() => {
            if (token !== venueTransitionToken) return;
            venueText.classList.toggle("is-entering", false);
            venueTransitioning = false;
            venueEnterFrame = 0;
          });
        });
      };

      venueExitListener = finishExit;
      venueText.addEventListener("transitionend", finishExit);
      // Fallback covers browsers that suppress transition events while a tab
      // is being throttled. A single text node still makes overlap impossible.
      venueFallbackTimer = window.setTimeout(() => finishExit(), 260);
      venueText.classList.toggle("is-exiting", true);
    };

    const syncBackdrop = (nextIndex: number) => {
      backdrops.forEach((backdrop, index) => {
        const active = index === nextIndex;
        const leaving = index === backdropIndex && !active;
        backdrop.classList.toggle("is-active", active);
        backdrop.classList.toggle("is-leaving", leaving);
        if (leaving) {
          // Detach after the 1.4s fade so the zoom resets for the next pass.
          window.setTimeout(() => backdrop.classList.toggle("is-leaving", false), 1400);
        }
      });
      backdropIndex = nextIndex;
    };

    const prepareBackdrop = (index: number): Promise<boolean> => {
      const pending = backdropReady.get(index);
      if (pending) return pending;
      const image = backdrops[index]?.querySelector?.<HTMLImageElement>("img");
      const source = image?.getAttribute("src") || image?.dataset.src;
      if (!image || !source) {
        failedBackdrops.add(index);
        return Promise.resolve(false);
      }

      const ready = new Promise<boolean>((resolve) => {
        const cleanup = () => {
          image.removeEventListener("load", loaded);
          image.removeEventListener("error", failed);
        };
        const failed = () => {
          cleanup();
          failedBackdrops.add(index);
          resolve(false);
        };
        const loaded = async () => {
          cleanup();
          if (!image.naturalWidth) return failed();
          try {
            if (typeof image.decode === "function") await image.decode();
            resolve(true);
          } catch {
            failed();
          }
        };
        image.addEventListener("load", loaded);
        image.addEventListener("error", failed);
        // Fetch only the scheduled image, even if native lazy loading would
        // otherwise defer an inactive layer. Cached images need no load event.
        image.loading = "eager";
        if (!image.getAttribute("src")) {
          if (image.dataset.srcset) image.srcset = image.dataset.srcset;
          image.src = source;
        }
        if (image.complete) void loaded();
      });
      backdropReady.set(index, ready);
      return ready;
    };

    const stopTimers = () => {
      // A load/decode already in flight can finish after pause and resume.
      // It may populate the ready cache, but must not resume an old cycle.
      backdropCycleToken += 1;
      window.clearTimeout(backdropTimer);
      window.clearTimeout(backdropPreloadTimer);
      window.clearTimeout(venueTimer);
      resetVenueTransition();
    };

    const queueBackdrop = () => {
      let nextIndex = (backdropIndex + 1) % backdrops.length;
      while (nextIndex !== backdropIndex && failedBackdrops.has(nextIndex)) {
        nextIndex = (nextIndex + 1) % backdrops.length;
      }
      if (nextIndex === backdropIndex) return;
      const token = backdropCycleToken;
      backdropPreloadTimer = window.setTimeout(() => {
        if (token === backdropCycleToken && canAnimate()) void prepareBackdrop(nextIndex);
      }, 3000);
      backdropTimer = window.setTimeout(() => {
        if (token !== backdropCycleToken || !canAnimate()) return;
        void prepareBackdrop(nextIndex).then((ready) => {
          if (token !== backdropCycleToken || !canAnimate()) return;
          if (ready) syncBackdrop(nextIndex);
          queueBackdrop();
        });
      }, 4000);
    };

    const queueVenue = () => {
      venueTimer = window.setTimeout(() => {
        if (!canAnimate()) return;
        syncVenue((venueIndex + 1) % venueGroups.length);
        queueVenue();
      }, 4000);
    };

    const renderState = () => {
      stopTimers();
      const running = canAnimate();
      hero.dataset.motionState = reducedMotion.matches ? "reduced" : running ? "running" : "paused";
      if (!running) return;
      queueBackdrop();
      queueVenue();
    };

    document.addEventListener("visibilitychange", renderState);
    reducedMotion.addEventListener?.("change", renderState);
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        ([entry]) => {
          inViewport = entry.isIntersecting;
          renderState();
        },
        { threshold: 0.1 },
      ).observe(hero);
    }

    syncBackdrop(backdropIndex);
    syncVenue(venueIndex);
    // Kick the first slide's zoom: unpin it two frames in so the browser has
    // committed scale(1.08) and the 5.4s transition animates from there.
    const kickFirstZoom = () => backdrops[0]?.classList.remove?.("is-initial");
    if (typeof window.requestAnimationFrame === "function") {
      window.requestAnimationFrame(() => window.requestAnimationFrame(kickFirstZoom));
    } else {
      window.setTimeout(kickFirstZoom, 50);
    }
    renderState();
  })();
</script>
