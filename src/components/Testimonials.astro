---
import { getDictionary } from "../i18n";
import type { Locale } from "../i18n/config";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);

// Extra visual copies make the transform loop seamless. Only the first copy
// is exposed to assistive technology, so a quote is never announced twice.
const loop = [0, 1, 2].flatMap((copy) =>
  t.testimonials.items.map((item) => ({ item, isClone: copy > 0 })),
);
---

<section class="pt-10 pb-16 px-4">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-10">
      <h2 class="text-2xl sm:text-3xl font-bold mb-4">{t.testimonials.heading}</h2>
      <div class="w-16 h-0.5 bg-gold mx-auto"></div>
    </div>

    <div class="relative" data-testimonial-motion-region>
      <div class="testimonial-viewport">
      <div
        id="testimonial-track"
        class="testimonial-track flex gap-4"
        role="region"
        aria-label={t.testimonials.regionLabel}
        data-count={t.testimonials.items.length}
        data-motion-state="running"
      >
        {
          loop.map(({ item, isClone }) => (
            <blockquote
              data-testimonial-card={isClone ? "clone" : "primary"}
              data-testimonial-clone={isClone ? "true" : undefined}
              aria-hidden={isClone ? "true" : "false"}
              class="flex-shrink-0 w-[280px] bg-[#141414] border border-white/5 rounded-xl p-5 flex flex-col justify-between"
            >
              <p class="text-white/70 text-sm leading-relaxed mb-4">&ldquo;{item.quote}&rdquo;</p>
              <p class="text-gold/70 text-xs text-right">— {item.author}</p>
            </blockquote>
          ))
        }
      </div>
      </div>
    </div>

    <div class="text-center mt-8">
      <p class="text-white/60 text-sm">{t.testimonials.served}</p>
    </div>
  </div>
</section>

<script>
  (() => {
    const track = document.getElementById("testimonial-track");
    if (!track) return;

    const count = Number(track.dataset.count ?? 0);
    const motionRegion = document.querySelector<HTMLElement>("[data-testimonial-motion-region]");
    if (!count || !motionRegion) return;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let hovered = false;
    let focused = false;
    // Without viewport observation, stay conservative and do not animate
    // potentially offscreen content for the lifetime of the page.
    let inViewport = false;
    let animationFrame = 0;
    let lastTimestamp = 0;
    let offset = 0;

    const canAnimate = () =>
      !reducedMotion.matches &&
      !hovered &&
      !focused &&
      inViewport &&
      document.visibilityState !== "hidden";

    const loopWidth = () => {
      const cards = track.querySelectorAll<HTMLElement>("[data-testimonial-card]");
      const first = cards[0];
      const firstClone = cards[count];
      const measured = firstClone && first ? firstClone.offsetLeft - first.offsetLeft : 0;
      return measured > 0 ? measured : count * 296;
    };

    const renderState = () => {
      const running = canAnimate();
      track.dataset.motionState = reducedMotion.matches ? "reduced" : running ? "running" : "paused";

      window.cancelAnimationFrame(animationFrame);
      if (running) {
        lastTimestamp = 0;
        animationFrame = window.requestAnimationFrame(step);
      }
    };

    const step = (timestamp: number) => {
      if (!canAnimate()) return;
      if (lastTimestamp) {
        offset += ((timestamp - lastTimestamp) * 28) / 1000;
        const width = loopWidth();
        if (offset >= width) offset -= width;
        track.style.transform = `translate3d(${-offset}px, 0, 0)`;
      }
      lastTimestamp = timestamp;
      animationFrame = window.requestAnimationFrame(step);
    };

    motionRegion.addEventListener("mouseenter", () => {
      hovered = true;
      renderState();
    });
    motionRegion.addEventListener("mouseleave", () => {
      hovered = false;
      renderState();
    });
    motionRegion.addEventListener("focusin", () => {
      focused = true;
      renderState();
    });
    motionRegion.addEventListener("focusout", (event) => {
      if (!motionRegion.contains(event.relatedTarget as Node | null)) {
        focused = false;
        renderState();
      }
    });
    document.addEventListener("visibilitychange", renderState);
    reducedMotion.addEventListener?.("change", renderState);

    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        ([entry]) => {
          inViewport = entry.isIntersecting;
          renderState();
        },
        { threshold: 0.1 },
      ).observe(motionRegion);
    }

    renderState();
  })();
</script>
