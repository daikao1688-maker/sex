---
import { getDictionary } from "../i18n";
import { localizePath, type Locale } from "../i18n/config";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);

const secondary = [
  { href: localizePath(lang, "/ranking/"), label: t.ctaBand.ranking },
  { href: localizePath(lang, "/guide/"), label: t.ctaBand.guide },
  { href: localizePath(lang, "/faq/"), label: t.ctaBand.faq },
];
---

<section class="pb-12 px-4">
  <div class="max-w-3xl mx-auto">
    <div
      class="fade-up bg-gradient-to-r from-[#141414] to-[#1a1a1a] border border-gold/10 rounded-2xl p-8 text-center"
    >
      <h3 class="text-xl font-bold mb-3">{t.ctaBand.heading}</h3>
      <p class="text-white/50 text-sm mb-6">{t.ctaBand.body}</p>
      <div
        class="mx-auto grid max-w-sm auto-rows-fr grid-cols-1 gap-3 min-[360px]:grid-cols-2 sm:max-w-none sm:grid-cols-4"
      >
        <a
          href="#contact"
          class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-gold px-4 py-2.5 text-center text-sm font-semibold leading-snug text-black transition-all duration-300 hover:bg-gold-dark"
          >{t.ctaBand.chat}</a
        >
        {
          secondary.map((link) => (
            <a
              href={link.href}
              class="inline-flex min-h-12 w-full items-center justify-center rounded-full border border-gold/50 px-4 py-2.5 text-center text-sm leading-snug text-gold transition-all duration-300 hover:bg-gold/10"
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
