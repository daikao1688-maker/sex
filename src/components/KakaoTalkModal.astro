---
import Icon from "./Icon.astro";
import { getDictionary } from "../i18n";
import type { Locale } from "../i18n/config";
import { contact } from "../data/site";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const id = contact.kakaotalk.id;
const withId = (value: string) => value.replaceAll("{id}", id);
---

<div
  id="kakaotalk-modal"
  class="fixed inset-0 z-[200] flex items-center justify-center bg-black/80 p-4 opacity-0 pointer-events-none transition-opacity duration-200 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="kakaotalk-modal-title"
  aria-hidden="true"
  hidden
>
  <div class="relative max-h-[calc(100dvh-2rem)] w-full max-w-sm overflow-y-auto rounded-2xl border border-[#FEE500]/40 bg-[#141414] p-6 sm:p-8">
    <button
      id="kakaotalk-modal-close"
      type="button"
      class="absolute right-3 top-3 flex h-10 w-10 items-center justify-center text-white/60 transition-colors hover:text-[#FEE500] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FEE500]"
      aria-label={t.kakaotalk.close}
    >
      <Icon name="close" class="h-6 w-6" />
    </button>

    <h3 id="kakaotalk-modal-title" class="mb-4 pr-8 text-center text-base sm:text-lg font-bold text-[#FEE500]">
      {t.kakaotalk.title}
    </h3>

    <div class="mb-4 flex items-center justify-center rounded-xl bg-white p-3">
      <img
        src={contact.kakaotalk.qr}
        alt={withId(t.kakaotalk.qrAlt)}
        width="192"
        height="210"
        class="h-auto w-full max-w-[192px]"
        loading="lazy"
      />
    </div>

    <p class="mb-4 text-center text-sm text-white/75">
      <span class="text-[#FEE500]">{t.kakaotalk.optionScan}</span><br />
      <span class="text-[#FEE500]">{withId(t.kakaotalk.optionCopy)}</span>
    </p>

    <button
      id="kakaotalk-copy-btn"
      type="button"
      data-copy-kakaotalk={id}
      data-copied-label={t.kakaotalk.copied}
      data-manual-label={t.kakaotalk.manualCopy}
      class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#FEE500] px-4 py-3 font-semibold text-black transition-colors hover:bg-[#F5DC00] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
    >
      <Icon name="copy" class="h-4 w-4" />
      <span id="kakaotalk-copy-label" aria-live="polite">{withId(t.kakaotalk.copy)}</span>
    </button>
    <input
      id="kakaotalk-copy-fallback"
      type="text"
      value={id}
      aria-label={t.kakaotalk.manualCopy}
      class="mt-3 w-full rounded-lg border border-[#FEE500]/40 bg-black/50 px-3 py-2 text-center text-sm text-white outline-none focus:border-[#FEE500] focus:ring-2 focus:ring-[#FEE500]/50"
      readonly
      disabled
      hidden
    />
  </div>
</div>

<style>
  #kakaotalk-modal[hidden],
  #kakaotalk-copy-fallback[hidden] {
    display: none !important;
  }
</style>

<script>
  (() => {
    const modal = document.getElementById("kakaotalk-modal");
    if (!modal) return;

    const closeBtn = document.getElementById("kakaotalk-modal-close");
    const copyBtn = document.getElementById("kakaotalk-copy-btn");
    const copyLabel = document.getElementById("kakaotalk-copy-label");
    const fallbackField = document.getElementById("kakaotalk-copy-fallback") as HTMLInputElement | null;
    const originalLabel = copyLabel?.textContent ?? "";
    let labelTimer: number | undefined;
    let lastTrigger: HTMLElement | null = null;
    let previousBodyOverflow = "";
    let savedScrollY = 0;
    let session = 0;
    let copyAttempt = 0;

    const isOpen = () => !modal.hasAttribute("hidden");
    const focusable = () =>
      Array.from(
        modal.querySelectorAll<HTMLElement>(
          'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
        ),
      );
    const setBackgroundInert = (inert: boolean) => {
      const background = document.querySelector<HTMLElement>("[data-page-background]");
      if (background) background.inert = inert;
    };
    const resetCopyState = () => {
      window.clearTimeout(labelTimer);
      if (copyLabel) copyLabel.textContent = originalLabel;
      if (fallbackField) {
        fallbackField.hidden = true;
        fallbackField.disabled = true;
      }
    };

    const open = () => {
      if (isOpen()) return;
      session += 1;
      resetCopyState();
      lastTrigger = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      previousBodyOverflow = document.body.style.overflow;
      savedScrollY = window.scrollY;
      modal.removeAttribute("hidden");
      modal.setAttribute("aria-hidden", "false");
      modal.classList.remove("opacity-0", "pointer-events-none");
      modal.classList.add("opacity-100", "pointer-events-auto");
      setBackgroundInert(true);
      document.body.style.overflow = "hidden";
      requestAnimationFrame(() => focusable()[0]?.focus({ preventScroll: true }));
    };

    const close = () => {
      if (!isOpen()) return;
      session += 1;
      window.clearTimeout(labelTimer);
      modal.classList.add("opacity-0", "pointer-events-none");
      modal.classList.remove("opacity-100", "pointer-events-auto");
      modal.setAttribute("aria-hidden", "true");
      modal.setAttribute("hidden", "");
      setBackgroundInert(false);
      document.body.style.overflow = previousBodyOverflow;
      lastTrigger?.focus({ preventScroll: true });
      window.scrollTo({ top: savedScrollY, behavior: "instant" });
    };

    const copyId = async () => {
      const id = copyBtn?.dataset.copyKakaotalk;
      if (!id) return;
      const copySession = session;
      const attempt = ++copyAttempt;
      let copied = false;

      try {
        if (!navigator.clipboard?.writeText) throw new Error("Clipboard API unavailable");
        await navigator.clipboard.writeText(id);
        copied = true;
      } catch {
        copied = false;
      }

      if (!isOpen() || copySession !== session || attempt !== copyAttempt) return;
      if (copied) {
        if (fallbackField) {
          fallbackField.hidden = true;
          fallbackField.disabled = true;
        }
      } else if (fallbackField) {
        fallbackField.hidden = false;
        fallbackField.disabled = false;
        fallbackField.focus({ preventScroll: true });
        fallbackField.select();
      }

      if (!copyLabel) return;
      copyLabel.textContent = copied
        ? copyBtn?.dataset.copiedLabel ?? originalLabel
        : copyBtn?.dataset.manualLabel ?? originalLabel;
      // Localized fallback messages can add lines above the input. Reveal it
      // after that reflow so it stays reachable in short landscape viewports.
      if (!copied) fallbackField?.scrollIntoView({ block: "nearest", inline: "nearest" });
      window.clearTimeout(labelTimer);
      labelTimer = window.setTimeout(() => {
        if (isOpen() && copySession === session && attempt === copyAttempt) {
          copyLabel.textContent = originalLabel;
        }
      }, 2000);
    };

    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.closest("[data-kakaotalk-trigger]")) {
        event.preventDefault();
        open();
      } else if (target === modal) {
        close();
      }
    });

    closeBtn?.addEventListener("click", close);
    copyBtn?.addEventListener("click", copyId);
    document.addEventListener("keydown", (event) => {
      if (!isOpen()) return;
      if (event.key === "Escape") {
        event.preventDefault();
        close();
        return;
      }
      if (event.key !== "Tab") return;
      const controls = focusable();
      const first = controls[0];
      const last = controls.at(-1);
      if (!first || !last) return;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus({ preventScroll: true });
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus({ preventScroll: true });
      }
    });
  })();
</script>
