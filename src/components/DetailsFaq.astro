---
/** Plain <details> Q&A list — no JavaScript. Used on the contact page. */
interface Props {
  items: Array<{ question: string; answer: string }>;
  /** Opens the first item, matching the design. */
  openFirst?: boolean;
}

const { items, openFirst = true } = Astro.props;
---

<div class="space-y-3">
  {
    items.map((item, index) => (
      <details
        open={openFirst && index === 0}
        class="group rounded-xl border border-gold/10 bg-white/[0.02] px-5 py-4 hover:border-gold/20 transition-colors"
      >
        <summary class="flex cursor-pointer items-center justify-between gap-3 font-semibold text-white/85 list-none">
          {item.question}
          <span class="text-gold text-lg leading-none shrink-0 transition-transform group-open:rotate-45">
            +
          </span>
        </summary>
        <p class="text-white/60 text-sm leading-relaxed mt-3">{item.answer}</p>
      </details>
    ))
  }
</div>
