---
import { getDictionary, interpolate } from "../i18n";
import { localizePath, type Locale } from "../i18n/config";
import { venues, type VenueAccent } from "../data/venues";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);

const formatPrice = (venue: (typeof venues)[number]) =>
  `${venue.priceMin.toLocaleString("en-US")} – ${venue.priceMax.toLocaleString("en-US")}`;

const frames: Record<VenueAccent, string> = {
  red: "border-2 border-red-400/60 hover:border-red-400/80 glow-red",
  gold: "border-2 border-gold/60 hover:border-gold/80 glow-gold",
  silver: "border-2 border-white/30 hover:border-gold/40 glow-silver",
  plain: "border border-gold/25 hover:border-gold/40",
};

const accentDots: Record<VenueAccent, string> = {
  red: "bg-red-400",
  gold: "bg-gold",
  silver: "bg-white/70",
  plain: "bg-gold/60",
};

// The count renders inside a <strong>, so split the sentence around it.
const [hiddenBefore, hiddenAfter = ""] = t.spas.hiddenNote.split("{count}");

// Paused venues collapse into one consolidated card so the grid stays focused
// on bookable venues. The card joins filtering via the union of their buckets.
const openVenues = venues
  .filter((venue) => !venue.temporarilyClosed)
  .sort((a, b) => {
    if (a.slug === "yu-sauna") return -1;
    if (b.slug === "yu-sauna") return 1;
    return 0;
  });
const closedVenues = venues.filter((venue) => venue.temporarilyClosed);
const filterBuckets = (venue: (typeof venues)[number]) => [
  ...venue.buckets.filter((bucket) => bucket !== "lineup"),
  venue.district,
];
const pausedBuckets = [...new Set(closedVenues.flatMap(filterBuckets))].join(" ");
---

<section id="spas" class="py-20 sm:py-28 px-4 scroll-mt-6">
  <div class="max-w-7xl mx-auto">
    <div class="fade-up text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold mb-4">{t.spas.heading}</h2>
      <div class="w-20 h-0.5 bg-gold mx-auto mb-6"></div>
      <p class="text-white/60 max-w-none mx-auto">{t.spas.intro}</p>
    </div>

    <div
      class="sticky top-16 sm:top-20 z-30 -mx-4 px-4 py-2 mb-7 bg-[#0a0a0a]/85 backdrop-blur-md border-b border-white/5"
    >
      <div
        class="flex sm:flex-wrap sm:justify-center gap-1.5 sm:gap-2 max-w-7xl mx-auto"
        role="group"
        aria-label={t.spas.filterLabel}
        data-spa-filter
      >
        {
          t.spas.filters.map((filter, index) => (
            <button
              type="button"
              data-bucket={filter.bucket}
              aria-pressed={index === 0 ? "true" : "false"}
              class="flex min-h-11 flex-1 items-center justify-center sm:flex-none min-w-0 rounded-full px-2 sm:px-3.5 py-1.5 text-xs sm:text-[13px] font-semibold text-center border border-white/12 bg-white/[0.04] text-white/70 whitespace-nowrap transition-colors hover:bg-white/[0.08] aria-pressed:bg-gold aria-pressed:text-black aria-pressed:border-transparent"
            >
              {filter.label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-spa-grid>
      {
        openVenues.map((venue, index) => {
          const copy = t.spas.venues[venue.slug];
          // Red belongs to the first homepage card, not to a particular venue.
          const frameAccent: VenueAccent =
            index === 0 ? "red" : venue.accent === "red" ? "gold" : venue.accent;
          return (
            <div
              class="fade-up"
              style={`transition-delay: ${(index * 0.03).toFixed(2)}s`}
              data-buckets={filterBuckets(venue).join(" ")}
            >
              <a
                href={localizePath(lang, `/spa/${venue.slug}/`)}
                class={`spa-card group relative isolate overflow-hidden rounded-2xl bg-ink transition-colors duration-200 ${frames[frameAccent]}`}
                data-frame={frameAccent}
              >
                <div class="spa-card-media absolute inset-0 -z-10 overflow-hidden">
                  <picture>
                    <source
                      srcset={`/covers/${venue.cover}-400.webp 400w, /covers/${venue.cover}.webp 800w`}
                      sizes="(min-width: 1024px) 405px, (min-width: 640px) calc((100vw - 3.5rem) / 2), calc(100vw - 2rem)"
                      type="image/webp"
                    />
                    <img
                      src={`/covers/${venue.cover}.jpg`}
                      srcset={`/covers/${venue.cover}-400.jpg 400w, /covers/${venue.cover}.jpg 800w`}
                      sizes="(min-width: 1024px) 405px, (min-width: 640px) calc((100vw - 3.5rem) / 2), calc(100vw - 2rem)"
                      alt={`${copy.name} — ${t.spas.imageAltSuffix}`}
                      loading="lazy"
                      fetchpriority="low"
                      decoding="async"
                      width="800"
                      height="800"
                      class="h-full w-full object-cover"
                    />
                  </picture>
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute inset-0 bg-black/15"
                  />
                </div>

                <span class="spa-card-badge relative m-3 self-start rounded-full border border-gold/60 bg-black/80 px-3 py-1.5 text-xs font-semibold leading-relaxed tracking-wide text-gold">
                  {copy.badge}
                </span>

                <div class="spa-card-content relative mt-auto px-4 pb-5 pt-16 sm:px-5">
                  <h3 class="spa-card-title text-xl font-bold leading-snug text-white transition-colors duration-200 group-hover:text-gold-light group-focus-visible:text-gold-light sm:text-[22px]">
                    {copy.name}
                    <span
                      aria-hidden="true"
                      class={`spa-card-accent ml-2 inline-block h-1.5 w-1.5 rotate-45 align-middle ${accentDots[venue.accent]}`}
                    />
                  </h3>

                  <div class="my-2 flex flex-wrap items-center gap-x-3 gap-y-1">
                    <small class="text-xs text-white/75">
                      {t.spas.districts[venue.district]}
                    </small>
                    <p
                      class="text-sm tracking-[0.18em] text-gold"
                      role="img"
                      aria-label={interpolate(t.spas.stats.ratingLabel, { rating: venue.rating })}
                    >
                      {"★".repeat(venue.rating)}
                    </p>
                  </div>

                  <p class="spa-card-description text-sm leading-relaxed text-white/75 line-clamp-2 whitespace-pre-line">
                    {copy.description}
                  </p>

                  <div class="spa-card-stats mt-3 grid grid-cols-3 gap-2 border-t border-white/20 pt-3 text-xs">
                    <div class="min-w-0">
                      <span class="mb-1 block leading-snug text-white/65">{t.spas.stats.price}</span>
                      <b class="block break-words text-xs leading-snug text-white tabular-nums sm:text-[13px]">
                        {formatPrice(venue)}
                      </b>
                    </div>
                    <div class="min-w-0">
                      <span class="mb-1 block leading-snug text-white/65">{t.spas.stats.hours}</span>
                      <b class="block break-words text-xs leading-snug text-white tabular-nums sm:text-[13px]">
                        {venue.open24h ? t.spas.stats.open24h : venue.hours}
                      </b>
                    </div>
                    <div class="min-w-0">
                      <span class="mb-1 block leading-snug text-white/65">{t.spas.stats.serviceFee}</span>
                      <b class="block break-words text-xs leading-snug text-white tabular-nums sm:text-[13px]">
                        {venue.serviceFee === "none" ? t.spas.stats.noServiceFee : `+${venue.serviceFee}`}
                      </b>
                    </div>
                  </div>

                  <div class="mt-4 flex items-center">
                    <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-gold group-hover:text-gold-light group-focus-visible:text-gold-light">
                      {t.spas.learnMore}
                      <span class="spa-card-arrow" aria-hidden="true">→</span>
                    </span>
                  </div>
                </div>
              </a>
            </div>
          );
        })
      }

      {
        closedVenues.length > 0 && (
          <div
            class="fade-up"
            style={`transition-delay: ${(openVenues.length * 0.03).toFixed(2)}s`}
            data-buckets={pausedBuckets}
          >
            <div
              class="flex h-full flex-col rounded-[16px] border border-gold/25 bg-[#141414] p-5 sm:rounded-[20px]"
              data-testid="spa-paused-card"
            >
              <span class="inline-block self-start px-4 py-1.5 rounded-full border border-gold/60 text-gold text-sm font-bold tracking-wide mb-3">
                {t.spas.pausedCard.badge}
              </span>
              <p class="text-white/50 text-sm mb-4">{t.spas.pausedCard.description}</p>
              <div class="grid flex-1 auto-rows-fr grid-cols-2 gap-2">
                {closedVenues.map((venue) => (
                  <a
                    href={localizePath(lang, `/spa/${venue.slug}/`)}
                    class="group flex items-center gap-3 rounded-lg border border-white/10 bg-black/40 px-3 py-2 transition-colors hover:border-gold/40"
                  >
                    <img
                      src={`/covers/${venue.cover}-400.webp`}
                      alt=""
                      aria-hidden="true"
                      loading="lazy"
                      decoding="async"
                      width="400"
                      height="400"
                      class="aspect-square h-full max-h-14 min-h-9 w-auto shrink-0 rounded-md object-cover grayscale opacity-60 transition-all duration-300 group-hover:grayscale-0 group-hover:opacity-100"
                    />
                    <span class="text-sm leading-tight text-white/80 transition-colors group-hover:text-gold">
                      {t.spas.venues[venue.slug].name}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        )
      }
    </div>

    <p class="text-center text-sm text-white/50 mt-8" data-spa-hidden-note hidden>
      {hiddenBefore}<strong class="text-white" data-hidden-count>0</strong>{hiddenAfter}
      <button
        type="button"
        class="text-gold underline underline-offset-2 hover:text-gold-light"
        data-spa-jump-all
      >
        {t.spas.showAll}
      </button>
    </p>
  </div>
</section>

<style>
  /* Keep content in normal flow so long translations / zoom can grow the
     card. The photograph fills the whole surface, behind the lower copy. */
  .spa-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 28rem;
  }

  .spa-card-badge {
    max-width: calc(100% - 1.5rem);
    overflow-wrap: anywhere;
  }

  .spa-card-content {
    background: linear-gradient(
      to bottom,
      transparent,
      rgb(0 0 0 / 0.78) 4rem,
      rgb(0 0 0 / 0.93) 72%,
      rgb(0 0 0 / 0.98)
    );
  }

  .spa-card-title {
    overflow-wrap: anywhere;
  }

  .spa-card:focus-visible {
    outline: 2px solid var(--color-gold-light);
    outline-offset: 4px;
  }

  .spa-card:active {
    border-color: var(--color-gold-light);
  }

  @media (min-width: 640px) {
    .spa-card {
      min-height: 30rem;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .spa-card-media img,
    .spa-card-arrow {
      transition: transform 300ms ease-out;
    }

    .spa-card:hover .spa-card-media img {
      transform: scale(1.04);
    }

    .spa-card:hover .spa-card-arrow {
      transform: translateX(3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spa-card,
    .spa-card-title,
    .spa-card-media img,
    .spa-card-arrow {
      animation: none;
      transition: none;
    }

    .spa-card:hover .spa-card-media img,
    .spa-card:hover .spa-card-arrow {
      transform: none;
    }
  }
</style>

<script>
  (() => {
    const grid = document.querySelector<HTMLElement>("[data-spa-grid]");
    const filterBar = document.querySelector<HTMLElement>("[data-spa-filter]");
    const note = document.querySelector<HTMLElement>("[data-spa-hidden-note]");
    if (!grid || !filterBar) return;

    const pills = filterBar.querySelectorAll<HTMLButtonElement>("button[data-bucket]");
    const cards = grid.querySelectorAll<HTMLElement>("[data-buckets]");
    const stickyBar = filterBar.closest<HTMLElement>(".sticky");

    // Teleport (never smooth-scroll) so the first card lands right under the
    // sticky bar — a smooth scroll would be clamped mid-flight as the grid
    // shrinks, producing a visible double jump.
    const jumpToFirstCard = () => {
      const navHeight = window.matchMedia("(max-width: 639px)").matches ? 64 : 80;
      const barHeight = stickyBar ? Math.ceil(stickyBar.getBoundingClientRect().height) : 0;
      const targetY = window.scrollY + grid.getBoundingClientRect().top - navHeight - barHeight - 12;
      window.scrollTo({ top: Math.max(0, targetY), behavior: "instant" as ScrollBehavior });
    };

    const apply = (active: HTMLButtonElement) => {
      const bucket = active.dataset.bucket ?? "all";
      pills.forEach((pill) => pill.setAttribute("aria-pressed", String(pill === active)));

      let hidden = 0;
      cards.forEach((card) => {
        const buckets = (card.dataset.buckets ?? "").split(/\s+/).filter(Boolean);
        const visible = bucket === "all" || buckets.includes(bucket);
        card.toggleAttribute("hidden", !visible);
        if (!visible) hidden += 1;
      });

      if (!note) return;
      if (bucket === "all" || hidden === 0) {
        note.setAttribute("hidden", "");
      } else {
        const count = note.querySelector<HTMLElement>("[data-hidden-count]");
        if (count) count.textContent = String(hidden);
        note.removeAttribute("hidden");
      }
    };

    pills.forEach((pill) =>
      pill.addEventListener("click", () => {
        // Filter first, then jump — both run synchronously, so the scroll
        // measurement sees the final layout.
        apply(pill);
        jumpToFirstCard();
      }),
    );

    note?.querySelector("[data-spa-jump-all]")?.addEventListener("click", () => {
      const all = filterBar.querySelector<HTMLButtonElement>('button[data-bucket="all"]');
      if (!all) return;
      apply(all);
      jumpToFirstCard();
    });
  })();
</script>
