---
import { getDictionary } from "../i18n";
import type { Locale } from "../i18n/config";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<section class="pb-12 sm:pb-16 px-4">
  <div class="max-w-3xl mx-auto">
    <div
      class="bg-gradient-to-b from-gold/10 to-gold/5 border border-gold/25 rounded-2xl px-6 py-7 sm:px-8 sm:py-9"
    >
      <p class="text-gold italic text-xs sm:text-sm opacity-90 mb-4 text-center">
        {t.mission.quote}
      </p>
      <p
        class="text-white/85 text-sm sm:text-base leading-relaxed max-w-2xl mx-auto text-left whitespace-pre-line"
      >
        {t.mission.body}
      </p>
    </div>
  </div>
</section>
