---
import Icon from "./Icon.astro";
import { getDictionary } from "../i18n";
import type { Locale } from "../i18n/config";
import { contact } from "../data/site";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<div
  id="wechat-modal"
  class="fixed inset-0 z-[200] bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="wechat-modal-title"
  aria-hidden="true"
  hidden
>
  <div class="bg-[#141414] rounded-2xl p-6 sm:p-8 max-w-sm w-full border border-gold/20 relative">
    <button
      id="wechat-modal-close"
      type="button"
      class="absolute top-3 right-3 w-10 h-10 flex items-center justify-center text-white/50 hover:text-gold transition-colors"
      aria-label={t.wechat.close}
    >
      <Icon name="close" class="w-6 h-6" />
    </button>

    <h3 id="wechat-modal-title" class="text-lg font-bold text-gold text-center mb-4">
      {t.wechat.title}
    </h3>

    <div class="bg-white rounded-xl p-3 mb-4 flex items-center justify-center">
      <img
        src={contact.wechat.qr}
        alt={`WeChat QR Code for ${contact.wechat.id}`}
        width="665"
        height="657"
        class="w-full h-auto max-w-[240px] rounded-lg"
        loading="lazy"
      />
    </div>

    <p class="text-center text-sm text-white/70 mb-4">
      <span class="text-gold">{t.wechat.optionScan}</span><br />
      <span class="text-gold">{t.wechat.optionCopy}</span>
    </p>

    <button
      id="wechat-copy-btn"
      type="button"
      data-copy-wechat={contact.wechat.id}
      data-copied-label={t.wechat.copied}
      data-manual-label={t.wechat.manualCopy}
      class="w-full flex items-center justify-center gap-2 bg-green-500 hover:bg-green-600 text-white font-semibold px-4 py-3 rounded-lg transition-colors"
    >
      <Icon name="copy" class="w-4 h-4" />
      <span id="wechat-copy-label" aria-live="polite">{t.wechat.copy}</span>
    </button>
    <input
      id="wechat-copy-fallback"
      type="text"
      value={contact.wechat.id}
      aria-label={t.wechat.manualCopy}
      class="mt-3 w-full rounded-lg border border-gold/30 bg-black/50 px-3 py-2 text-center text-sm text-white outline-none focus:border-gold focus:ring-2 focus:ring-gold/50"
      readonly
      disabled
      hidden
    />
  </div>
</div>

<script>
  (() => {
    const modal = document.getElementById("wechat-modal");
    if (!modal) return;

    const closeBtn = document.getElementById("wechat-modal-close");
    const copyBtn = document.getElementById("wechat-copy-btn");
    const copyLabel = document.getElementById("wechat-copy-label");
    const fallbackField = document.getElementById("wechat-copy-fallback") as HTMLInputElement | null;
    const originalLabel = copyLabel?.textContent ?? "";
    let labelTimer: number | undefined;
    let lastTrigger: HTMLElement | null = null;
    let previousBodyOverflow = "";
    let savedScrollY = 0;

    const isOpen = () => !modal.hasAttribute("hidden");
    const focusable = () =>
      Array.from(
        modal.querySelectorAll<HTMLElement>(
          'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
        ),
      );
    const setBackgroundInert = (inert: boolean) => {
      const background = document.querySelector<HTMLElement>("[data-page-background]");
      if (background) background.inert = inert;
    };

    const open = () => {
      if (isOpen()) return;
      lastTrigger = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      previousBodyOverflow = document.body.style.overflow;
      savedScrollY = window.scrollY;
      modal.removeAttribute("hidden");
      modal.setAttribute("aria-hidden", "false");
      modal.classList.remove("opacity-0", "pointer-events-none");
      modal.classList.add("opacity-100", "pointer-events-auto");
      setBackgroundInert(true);
      document.body.style.overflow = "hidden";
      // preventScroll: mobile browsers scroll the page when focusing elements
      // inside a fixed container, which jumps the page to the top.
      requestAnimationFrame(() => focusable()[0]?.focus({ preventScroll: true }));
    };

    const close = () => {
      if (!isOpen()) return;
      modal.classList.add("opacity-0", "pointer-events-none");
      modal.classList.remove("opacity-100", "pointer-events-auto");
      modal.setAttribute("aria-hidden", "true");
      setBackgroundInert(false);
      document.body.style.overflow = previousBodyOverflow;
      lastTrigger?.focus({ preventScroll: true });
      // Restore the scroll position in case the browser moved it while the
      // modal was open (focus scroll-into-view, overflow toggling, URL bar).
      window.scrollTo({ top: savedScrollY, behavior: "instant" });
      window.setTimeout(() => {
        if (modal.classList.contains("opacity-0")) modal.setAttribute("hidden", "");
      }, 250);
    };

    const copyId = async () => {
      const id = copyBtn?.dataset.copyWechat;
      if (!id) return;

      let copied = false;
      try {
        if (!navigator.clipboard?.writeText) throw new Error("Clipboard API unavailable");
        await navigator.clipboard.writeText(id);
        copied = true;
        if (fallbackField) {
          fallbackField.hidden = true;
          fallbackField.disabled = true;
        }
      } catch {
        if (fallbackField) {
          fallbackField.hidden = false;
          fallbackField.disabled = false;
          fallbackField.focus();
          fallbackField.select();
        }
      }

      if (!copyLabel) return;
      copyLabel.textContent = copied
        ? copyBtn?.dataset.copiedLabel ?? originalLabel
        : copyBtn?.dataset.manualLabel ?? originalLabel;
      window.clearTimeout(labelTimer);
      labelTimer = window.setTimeout(() => (copyLabel.textContent = originalLabel), 2000);
    };

    // Delegated so any [data-wechat-trigger] on the page opens the modal.
    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.closest("[data-wechat-trigger]")) {
        event.preventDefault();
        open();
      } else if (target === modal) {
        close();
      }
    });

    closeBtn?.addEventListener("click", close);
    copyBtn?.addEventListener("click", copyId);
    document.addEventListener("keydown", (event) => {
      if (!isOpen()) return;
      if (event.key === "Escape") {
        event.preventDefault();
        close();
        return;
      }
      if (event.key !== "Tab") return;
      const controls = focusable();
      const first = controls[0];
      const last = controls.at(-1);
      if (!first || !last) return;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  })();
</script>
