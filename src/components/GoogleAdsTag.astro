---
/**
 * Google Ads conversion tag (AW-18409047939).
 * Standard gtag.js snippet + delegated conversion listeners for the four
 * contact channels. Loaded in <head> on every page via Layout.astro.
 */
---

<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18409047939"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag("js", new Date());
  gtag("config", "AW-18409047939");
</script>

<script is:inline>
  // Delegated so dynamically rendered links are covered too; a single
  // document listener replaces per-element binding.
  window.addEventListener("load", () => {
    const conversions = [
      { selector: 'a[href*="t.me"]', sendTo: "AW-18409047939/7SfQCKrtyegcEIOPj8pE" }, // Telegram
      { selector: 'a[href*="wa.me"]', sendTo: "AW-18409047939/_-cICM7eyegcEIOPj8pE" }, // WhatsApp
      { selector: 'a[href*="line.m"]', sendTo: "AW-18409047939/QnbSCMbK0-gcEIOPj8pE" }, // LINE
      { selector: "button#wechat-copy-btn", sendTo: "AW-18409047939/vmq_CKCKyugcEIOPj8pE" }, // WeChat
    ];
    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      for (const { selector, sendTo } of conversions) {
        if (target.closest(selector)) {
          gtag("event", "conversion", { send_to: sendTo });
          break;
        }
      }
    });
  });
</script>
