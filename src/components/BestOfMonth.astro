---
import Icon from "./Icon.astro";
import { getDictionary, interpolate } from "../i18n";
import { localeMeta, localizePath, type Locale } from "../i18n/config";
import { getBestOfMonthCopy } from "../i18n/pages/bestOfMonth";
import { venues } from "../data/venues";

/**
 * Editors' shortlist under the hero: three venue scorecards stacked in one
 * grid cell, browsable by swipe, arrows and position dots.
 */
interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const copy = getBestOfMonthCopy(lang);

const htmlLang = localeMeta[lang].htmlLang;
const now = new Date();
// "August 2026" in English, "2026年8月" in zh/ja, "2026년 8월" in Korean.
const monthLabel = htmlLang.startsWith("ko")
  ? `${now.getFullYear()}년 ${now.getMonth() + 1}월`
  : /^(zh|ja)/.test(htmlLang)
    ? `${now.getFullYear()}年${now.getMonth() + 1}月`
    : new Intl.DateTimeFormat(htmlLang, { month: "long", year: "numeric" }).format(now);

const cards = copy.cards.map((card, index) => {
  const venue = venues.find((entry) => entry.slug === card.slug)!;
  return {
    ...card,
    venue,
    rank: index + 1,
    name: t.spas.venues[card.slug].name,
    href: localizePath(lang, `/spa/${card.slug}/`),
    coverBase: `/covers/${venue.cover}`,
    district: copy.districts[venue.district],
    price: `${venue.priceMin.toLocaleString("en-US")} – ${venue.priceMax.toLocaleString("en-US")}`,
    hours: venue.open24h ? copy.values.open24h : venue.hours,
    serviceFee: venue.serviceFee === "none" ? copy.values.noServiceFee : venue.serviceFee,
  };
});

const heading = interpolate(copy.heading, { venue: cards[0].name });
---

<section
  id="best-of-month"
  data-testid="best-of-month"
  class="relative -mt-px scroll-mt-6 overflow-x-clip bg-ink px-4 pb-14 pt-20 sm:pb-20 sm:pt-28"
  aria-labelledby="bom-title"
>
  <div
    class="mx-auto grid w-full max-w-6xl grid-cols-[minmax(0,1fr)] items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,440px)] lg:gap-14"
  >
    <div class="fade-up min-w-0 text-center lg:text-left">
      <p
        class="mb-3 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-gold"
      >
        <span
          class="inline-block h-1.5 w-1.5 rounded-full bg-gold shadow-[0_0_12px_rgba(212,175,55,0.65)]"
          aria-hidden="true"></span>
        {copy.eyebrow}
        <span class="text-gold/55">·</span>
        <span data-bom-month>{monthLabel}</span>
      </p>

      <h2
        id="bom-title"
        data-bom-heading
        aria-live="polite"
        class="text-balance text-3xl font-extrabold leading-tight tracking-tight text-white sm:text-4xl md:text-5xl"
      >
        {heading}
      </h2>

      <p class="mx-auto mt-4 max-w-xl text-pretty text-sm leading-relaxed text-white/60 sm:text-base lg:mx-0">
        {copy.intro}
      </p>

      <a
        href={localizePath(lang, "/ranking/")}
        class="mt-6 inline-flex text-sm font-semibold text-gold transition-colors hover:text-gold-light"
      >
        {copy.rankingLink}
      </a>
    </div>

    <div
      class="fade-up relative mx-auto min-w-0 w-full max-w-[min(100%,400px)] origin-center touch-pan-y sm:max-w-[440px] lg:mx-0 lg:justify-self-end"
      data-testid="bom-scorecard"
      data-bom-deck
      role="region"
      aria-label={copy.controls.carousel}
    >
      <div
        class="bom-track min-w-0 w-full"
        data-bom-track
      >
        {
          cards.map((card, index) => (
            <a
              href={card.href}
              data-bom-card
              data-bom-heading-value={interpolate(copy.heading, { venue: card.name })}
              tabindex={index === 0 ? 0 : -1}
              aria-hidden={index === 0 ? "false" : "true"}
              class="bom-card relative block overflow-hidden rounded-[16px] shadow-[0_24px_50px_-18px_rgba(212,175,55,0.28)] transition-[box-shadow,opacity,transform] duration-500 hover:shadow-[0_30px_60px_-16px_rgba(212,175,55,0.45)] sm:rounded-[20px]"
              style={`--bom-card-tilt:${index % 2 === 0 ? "1.25deg" : "-1.1deg"};grid-area:1 / 1;pointer-events:${index === 0 ? "auto" : "none"};opacity:${index === 0 ? 1 : 0};visibility:${index === 0 ? "visible" : "hidden"}`}
            >
              <div class="relative aspect-[3/2]">
                <picture data-bom-picture class="block h-full w-full">
                  <source
                    srcset={`${card.coverBase}-400.webp 400w, ${card.coverBase}.webp 800w`}
                    sizes="(min-width: 640px) 440px, 88vw"
                    type="image/webp"
                  />
                  <img
                    src={`${card.coverBase}.jpg`}
                    srcset={`${card.coverBase}-400.jpg 400w, ${card.coverBase}.jpg 800w`}
                    sizes="(min-width: 640px) 440px, 88vw"
                    alt={card.name}
                    width="800"
                    height="800"
                    loading="lazy"
                    fetchpriority="low"
                    decoding="async"
                    draggable="false"
                    class="h-full w-full object-cover"
                  />
                </picture>
                <span class="absolute left-2 top-2 max-w-[70%] truncate rounded-full border border-gold/60 bg-[#0a0a0a]/90 px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-[0.12em] text-gold sm:left-3 sm:top-3 sm:max-w-none sm:px-3 sm:text-[11px] sm:tracking-[0.14em]">
                  {card.award}
                </span>
                <span class="absolute right-2 top-2 flex h-8 w-8 items-center justify-center rounded-full bg-gold text-sm font-black text-black shadow-[0_0_16px_rgba(212,175,55,0.55)] sm:right-3 sm:top-3 sm:h-[34px] sm:w-[34px]">
                  #{card.rank}
                </span>
                <span
                  aria-hidden="true"
                  class="absolute bottom-2 right-2 rounded-md border-2 border-gold/50 bg-black/40 px-1.5 py-0.5 text-[9px] font-black uppercase tracking-[0.14em] text-white/90 backdrop-blur-[2px] sm:bottom-3 sm:right-3 sm:rounded-lg sm:px-2 sm:py-1 sm:text-[11px] sm:tracking-[0.18em]"
                  style="transform:rotate(-9deg)"
                  data-bom-stamp
                >
                  {interpolate(copy.reviewedStamp, { month: monthLabel })}
                </span>
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute inset-x-0 bottom-0 h-3/5 bg-gradient-to-t from-black/90 via-black/45 to-transparent"
                ></span>
                <b class="absolute bottom-2.5 left-3 right-16 truncate text-xl font-black text-white drop-shadow-[0_2px_10px_rgba(0,0,0,0.7)] sm:bottom-3.5 sm:left-4 sm:right-20 sm:text-[26px] sm:leading-tight">
                  {card.name}
                </b>
              </div>

              <div class="relative px-4 pb-4 pt-3.5 sm:px-6 sm:pb-6 sm:pt-5">
                <div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-2">
                  <small class="text-[11px] text-white/50 sm:text-[13px]">
                    {card.venue.nameZh} · {card.district}
                  </small>
                </div>

                <p
                  class="my-1.5 tracking-[0.2em] text-gold sm:my-2 sm:tracking-[0.25em]"
                  aria-label={interpolate(copy.ratingLabel, { rating: card.venue.rating })}
                >
                  {"★".repeat(card.venue.rating)}
                </p>

                <p class="mb-3 border-l-[3px] border-gold/70 pl-2.5 text-[13px] leading-relaxed text-white/65 sm:mb-4 sm:pl-3 sm:text-sm">
                  “{card.quote}”
                </p>

                <div class="grid grid-cols-3 gap-1.5 border-t border-dashed border-white/15 pt-2.5 text-[10px] sm:gap-2 sm:pt-3 sm:text-[11.5px]">
                  <div class="min-w-0 overflow-hidden">
                    <span class="mb-0.5 block leading-tight text-white/50">{copy.stats.price}</span>
                    <b class="block hyphens-auto break-words text-[10px] leading-snug text-white sm:text-[13px]">
                      {card.price}
                    </b>
                  </div>
                  <div class="min-w-0 overflow-hidden">
                    <span class="mb-0.5 block leading-tight text-white/50">{copy.stats.hours}</span>
                    <b class="block hyphens-auto break-words text-[10px] leading-snug text-white sm:text-[13px]">
                      {card.hours}
                    </b>
                  </div>
                  <div class="min-w-0 overflow-hidden">
                    <span class="mb-0.5 block leading-tight text-white/50">
                      {copy.stats.serviceFee}
                    </span>
                    <b class="block hyphens-auto break-words text-[10px] leading-snug text-white sm:text-[13px]">
                      {card.serviceFee}
                    </b>
                  </div>
                </div>

                <div class="mt-3 flex items-center justify-end sm:mt-4">
                  <span class="text-xs font-extrabold text-gold sm:text-sm">{copy.viewVenue}</span>
                </div>
              </div>
            </a>
          ))
        }
      </div>

      <div
        class="mt-5 flex items-center justify-center gap-2 sm:mt-6 sm:gap-4"
        data-bom-controls
        role="group"
        aria-label={copy.controls.carousel}
      >
        <button
          type="button"
          data-bom-previous
          aria-label={copy.controls.previous}
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-white/20 bg-[#141414]/85 text-2xl leading-none text-white/75 transition-[border-color,color,background-color,transform] hover:border-gold/65 hover:text-gold active:scale-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold sm:h-14 sm:w-14"
        >
          <Icon name="arrow-left" class="h-5 w-5" />
        </button>

        <div class="flex items-center justify-center">
          {
            cards.map((card, index) => (
              <button
                type="button"
                data-bom-dot
                data-bom-index={index}
                aria-current={index === 0 ? "true" : undefined}
                aria-label={interpolate(copy.controls.slide, {
                  index: index + 1,
                  total: cards.length,
                  venue: card.name,
                })}
                class="group flex h-11 w-11 items-center justify-center rounded-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold"
              >
                <span
                  aria-hidden="true"
                  data-bom-dot-indicator
                  class="h-2.5 rounded-full transition-[width,background-color,transform] duration-300 group-hover:scale-125"
                  style={`width:${index === 0 ? "28px" : "10px"};background:${index === 0 ? "var(--color-gold)" : "rgba(255,248,240,0.22)"}`}
                />
              </button>
            ))
          }
        </div>

        <button
          type="button"
          data-bom-next
          aria-label={copy.controls.next}
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-white/20 bg-[#141414]/85 text-2xl leading-none text-white/75 transition-[border-color,color,background-color,transform] hover:border-gold/65 hover:text-gold active:scale-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold sm:h-14 sm:w-14"
        >
          <Icon name="arrow-right" class="h-5 w-5" />
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .bom-track {
    display: grid;
    overflow: visible;
  }

  .bom-card {
    grid-area: 1 / 1;
    border: 1.5px solid transparent;
    background:
      linear-gradient(#151515, #101010) padding-box,
      linear-gradient(135deg, #f5d67b 0%, #d4af37 40%, #7a5f18 100%) border-box;
  }

  .bom-card:hover {
    background:
      linear-gradient(#181818, #121212) padding-box,
      linear-gradient(135deg, #ffe9a8 0%, #e6c455 40%, #9a7a24 100%) border-box;
  }

  /* Gold sheen sweep on hover */
  .bom-card::after {
    content: "";
    position: absolute;
    top: -20%;
    bottom: -20%;
    left: -55%;
    width: 42%;
    background: linear-gradient(
      105deg,
      transparent 0%,
      rgba(255, 240, 200, 0.12) 42%,
      rgba(255, 240, 200, 0.26) 50%,
      rgba(255, 240, 200, 0.12) 58%,
      transparent 100%
    );
    transform: skewX(-12deg);
    pointer-events: none;
  }

  .bom-card:hover::after {
    transform: skewX(-12deg) translateX(360%);
    transition: transform 0.9s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .bom-card::after {
      display: none;
    }
  }

  @media (max-width: 639px) {
    .bom-card {
      transform: rotate(var(--bom-card-tilt, 1.25deg));
      transform-origin: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bom-card,
    [data-bom-dot-indicator] {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  (() => {
    const deck = document.querySelector<HTMLElement>("[data-bom-deck]");
    if (!deck) return;

    const cards = Array.from(deck.querySelectorAll<HTMLElement>("[data-bom-card]"));
    if (cards.length < 2) return;

    const heading = deck.closest("section")?.querySelector<HTMLElement>("[data-bom-heading]");
    const dots = Array.from(deck.querySelectorAll<HTMLButtonElement>("[data-bom-dot]"));
    const previous = deck.querySelector<HTMLButtonElement>("[data-bom-previous]");
    const next = deck.querySelector<HTMLButtonElement>("[data-bom-next]");
    let active = 0;
    let pointerStartX = 0;
    let pointerStartY = 0;
    let trackingPointer = false;
    let suppressClickUntil = 0;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const show = (next: number, dir = 1, animate = true) => {
      const motionOK = animate && !reduceMotion.matches;
      cards.forEach((card, index) => {
        const on = index === next;
        window.clearTimeout(Number(card.dataset.bomHideTimer ?? 0));
        if (on) {
          card.style.visibility = "visible";
          card.style.pointerEvents = "auto";
          card.tabIndex = 0;
          card.setAttribute("aria-hidden", "false");
          if (motionOK) {
            card.style.transition = "none";
            card.style.transform = `translateX(${44 * dir}px) scale(0.97)`;
            card.style.opacity = "0";
            requestAnimationFrame(() => {
              requestAnimationFrame(() => {
                card.style.transition = "";
                card.style.transform = "";
                card.style.opacity = "1";
              });
            });
          } else {
            card.style.transform = "";
            card.style.opacity = "1";
          }
        } else {
          card.style.pointerEvents = "none";
          card.tabIndex = -1;
          card.setAttribute("aria-hidden", "true");
          if (motionOK) {
            card.style.transition = "";
            card.style.transform = `translateX(${-32 * dir}px) scale(0.97)`;
            card.style.opacity = "0";
            const timer = window.setTimeout(() => {
              if (card.style.opacity === "0") card.style.visibility = "hidden";
            }, 520);
            card.dataset.bomHideTimer = String(timer);
          } else {
            card.style.transform = "";
            card.style.opacity = "0";
            card.style.visibility = "hidden";
          }
        }
      });

      dots.forEach((dot, dotIndex) => {
        const current = dotIndex === next;
        const indicator = dot.querySelector<HTMLElement>("[data-bom-dot-indicator]");
        if (indicator) {
          indicator.style.width = current ? "28px" : "10px";
          indicator.style.background = current
            ? "var(--color-gold)"
            : "rgba(255,248,240,0.22)";
        }
        if (current) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });

      const headingValue = cards[next]?.dataset.bomHeadingValue;
      if (heading && headingValue) heading.textContent = headingValue;

      active = next;
    };

    const select = (index: number) => {
      const target = (index + cards.length) % cards.length;
      const dir = index >= active ? 1 : -1;
      show(target, dir);
    };

    previous?.addEventListener("click", () => select(active - 1));
    next?.addEventListener("click", () => select(active + 1));
    dots.forEach((dot) => {
      dot.addEventListener("click", () => select(Number(dot.dataset.bomIndex ?? 0)));
    });
    show(active, 1, false);

    // Keep vertical page scrolling native while treating a deliberate
    // horizontal movement as carousel navigation.
    deck.addEventListener("pointerdown", (event) => {
      if (!event.isPrimary || event.button !== 0) return;
      pointerStartX = event.clientX;
      pointerStartY = event.clientY;
      trackingPointer = true;
    });

    const finishPointer = (event: PointerEvent) => {
      if (!trackingPointer || !event.isPrimary) return;
      trackingPointer = false;

      const deltaX = event.clientX - pointerStartX;
      const deltaY = event.clientY - pointerStartY;
      const swiped = Math.abs(deltaX) >= 40 && Math.abs(deltaX) > Math.abs(deltaY);

      if (swiped) {
        suppressClickUntil = performance.now() + 500;
        select(deltaX < 0 ? active + 1 : active - 1);
      }
    };

    deck.addEventListener("pointerup", finishPointer);
    deck.addEventListener("pointercancel", () => {
      trackingPointer = false;
    });
    deck.addEventListener(
      "click",
      (event) => {
        if (performance.now() >= suppressClickUntil) return;
        event.preventDefault();
        event.stopPropagation();
      },
      true,
    );

  })();

  // The month is baked in at build time; refresh it on every visit.
  (() => {
    const lang = (document.documentElement.lang || "en").toLowerCase();
    const now = new Date();
    const label = lang.startsWith("ko")
      ? `${now.getFullYear()}년 ${now.getMonth() + 1}월`
      : /^(zh|ja)/.test(lang)
        ? `${now.getFullYear()}年${now.getMonth() + 1}月`
        : new Intl.DateTimeFormat(lang, { month: "long", year: "numeric" }).format(now);

    document.querySelectorAll<HTMLElement>("[data-bom-month]").forEach((node) => {
      node.textContent = label;
    });
    document.querySelectorAll<HTMLElement>("[data-bom-stamp]").forEach((node) => {
      const text = node.textContent ?? "";
      const separator = text.indexOf("·");
      if (separator > -1) node.textContent = `${text.slice(0, separator + 1)} ${label}`;
    });
  })();
</script>
