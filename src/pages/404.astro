---
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
import { defaultLocale, localeMeta, locales, localizePath, type Locale } from "../i18n/config";

interface NotFoundCopy {
  brand: string;
  languageLabel: string;
  eyebrow: string;
  heading: string;
  body: string;
  home: string;
  spas: string;
  moreLabel: string;
  recoveryLabel: string;
  guide: string;
  contact: string;
}

/**
 * One static /404.html serves every missing URL. Its English HTML remains a
 * complete no-JavaScript fallback; the small inline script below selects the
 * URL locale first, then applies the same device-language rules as `/`.
 */
const copy: Record<Locale, NotFoundCopy> = {
  en: {
    brand: "Macau Sauna Sites",
    languageLabel: "Language",
    eyebrow: "Wrong turn, easy way back",
    heading: "This page slipped off the map",
    body: "The link may be outdated or the page may have moved. Return home, or keep exploring Macau venues.",
    home: "Back to home",
    spas: "Browse venues",
    moreLabel: "Or continue from here",
    recoveryLabel: "Page recovery",
    guide: "First-time guide",
    contact: "Contact concierge",
  },
  "zh-TW": {
    brand: "澳門桑拿導航站",
    languageLabel: "語言",
    eyebrow: "走錯一小步，回程很簡單",
    heading: "這一頁暫時找不到",
    body: "連結可能已失效，或頁面已經搬家。您可以返回首頁，或繼續瀏覽澳門會所。",
    home: "返回首頁",
    spas: "瀏覽會所",
    moreLabel: "也可以從這裡繼續",
    recoveryLabel: "頁面導覽",
    guide: "新手指南",
    contact: "聯絡禮賓",
  },
  "zh-CN": {
    brand: "澳门桑拿导航站",
    languageLabel: "语言",
    eyebrow: "走错一小步，返回很简单",
    heading: "这个页面暂时找不到",
    body: "链接可能已失效，或页面已经迁移。您可以返回首页，或继续浏览澳门会所。",
    home: "返回首页",
    spas: "浏览会所",
    moreLabel: "也可以从这里继续",
    recoveryLabel: "页面导航",
    guide: "新手指南",
    contact: "联系礼宾",
  },
  ja: {
    brand: "マカオ・サウナ・ガイド",
    languageLabel: "言語",
    eyebrow: "少し道を外れても、すぐに戻れます",
    heading: "お探しのページが見つかりません",
    body: "リンクが古いか、ページが移動した可能性があります。ホームに戻るか、マカオの店舗一覧をご覧ください。",
    home: "ホームへ戻る",
    spas: "店舗を見る",
    moreLabel: "こちらからもお進みいただけます",
    recoveryLabel: "ページ案内",
    guide: "初めての方へ",
    contact: "コンシェルジュに相談",
  },
};

const localeLabels = Object.fromEntries(
  locales.map((locale) => [locale, localeMeta[locale].label]),
) as Record<Locale, string>;
const t = copy[defaultLocale];
---

<Layout
  lang={defaultLocale}
  path="/404/"
  title={`404 — ${t.heading}`}
  description={t.body}
  indexable={false}
  analytics={false}
>
  <div class="not-found-page relative min-h-dvh overflow-hidden bg-ink text-white">
    <div class="not-found-atmosphere pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="not-found-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <header class="relative z-20 mx-auto flex h-16 w-full max-w-7xl items-center justify-between px-4 sm:h-20 sm:px-6 lg:px-8">
      <a
        href={localizePath(defaultLocale, "/")}
        class="group flex min-w-0 items-center gap-2 rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold/80 focus-visible:ring-offset-4 focus-visible:ring-offset-ink"
        data-404-brand-link
      >
        <img
          src="/favicon.svg"
          alt=""
          width="40"
          height="40"
          class="h-8 w-8 shrink-0 sm:h-10 sm:w-10"
          aria-hidden="true"
        />
        <span
          class="max-w-[52vw] truncate whitespace-nowrap text-base font-bold tracking-wider text-gold transition-colors group-hover:text-gold-light sm:text-2xl"
          data-404-brand
        >
          {t.brand}
        </span>
      </a>

      <div class="relative ml-3 shrink-0">
        <button
          type="button"
          class="inline-flex min-h-11 items-center gap-1.5 rounded-xl border border-white/15 bg-black/30 px-2.5 py-2 text-sm font-medium text-white/75 backdrop-blur-md transition-[border-color,color,background-color] duration-200 hover:border-gold/35 hover:bg-white/5 hover:text-gold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold/80 sm:gap-2 sm:px-3.5"
          aria-label={`${t.languageLabel}: ${localeMeta[defaultLocale].label}`}
          aria-expanded="false"
          aria-controls="not-found-language-panel"
          aria-haspopup="true"
          data-404-language-toggle
        >
          <Icon name="globe" class="h-5 w-5 shrink-0" />
          <span class="not-found-language-current" data-404-language-current>
            {localeMeta[defaultLocale].label}
          </span>
          <Icon name="chevron-down" class="h-4 w-4 shrink-0" />
        </button>

        <div
          id="not-found-language-panel"
          class="absolute right-0 top-[calc(100%+0.65rem)] hidden w-48 overflow-hidden rounded-2xl border border-white/10 bg-[#111]/95 p-2 shadow-2xl shadow-black/50 backdrop-blur-xl"
          data-404-language-panel
        >
          {
            locales.map((locale) => (
              <a
                href={localizePath(locale, "/")}
                hreflang={localeMeta[locale].htmlLang}
                data-404-locale-link
                data-locale={locale}
                aria-current={locale === defaultLocale ? "true" : undefined}
                class:list={[
                  "flex min-h-11 items-center justify-between rounded-xl px-3.5 py-2.5 text-sm transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold/80",
                  locale === defaultLocale
                    ? "bg-gold/15 text-gold"
                    : "text-white/70 hover:bg-white/5 hover:text-white",
                ]}
              >
                <span>{localeMeta[locale].label}</span>
                <span
                  class:list={[locale === defaultLocale ? "" : "hidden"]}
                  data-404-locale-check
                  aria-hidden="true"
                >
                  <Icon name="check" class="h-4 w-4" />
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </header>

    <main
      class="relative z-10 mx-auto flex min-h-[calc(100dvh-8rem)] w-full max-w-5xl items-center justify-center px-4 pb-12 pt-6 text-center sm:min-h-[calc(100dvh-10rem)] sm:px-6 sm:pb-16 sm:pt-8"
      data-testid="not-found"
    >
      <section class="w-full max-w-3xl" aria-labelledby="not-found-title">
        <div class="not-found-code" aria-hidden="true">404</div>

        <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-gold sm:text-sm" data-404-eyebrow>
          {t.eyebrow}
        </p>
        <h1
          id="not-found-title"
          class="mx-auto max-w-2xl text-3xl font-black leading-tight tracking-tight text-white sm:text-5xl"
          data-404-heading
        >
          {t.heading}
        </h1>
        <p
          class="mx-auto mt-5 max-w-2xl text-base leading-7 text-white/60 sm:mt-6 sm:text-lg sm:leading-8"
          data-404-body
        >
          {t.body}
        </p>

        <div class="mx-auto mt-8 flex max-w-xl flex-col items-stretch justify-center gap-3 sm:mt-10 sm:flex-row">
          <a
            href={localizePath(defaultLocale, "/")}
            class="inline-flex min-h-12 flex-1 items-center justify-center gap-2 rounded-full bg-gradient-to-r from-gold-light to-gold-dark px-6 py-3 font-bold text-black shadow-[0_14px_36px_-18px_rgba(212,175,55,0.9)] transition-[filter,transform,box-shadow] duration-200 hover:brightness-110 hover:shadow-[0_18px_44px_-18px_rgba(212,175,55,1)] active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-light focus-visible:ring-offset-4 focus-visible:ring-offset-ink motion-reduce:transition-none"
            data-404-home
          >
            <Icon name="arrow-left" class="h-5 w-5" />
            <span>{t.home}</span>
          </a>
          <a
            href={localizePath(defaultLocale, "/#spas")}
            class="inline-flex min-h-12 flex-1 items-center justify-center gap-2 rounded-full border border-gold/50 bg-gold/[0.04] px-6 py-3 font-semibold text-gold transition-[border-color,background-color,color,transform] duration-200 hover:border-gold/80 hover:bg-gold/10 hover:text-gold-light active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold focus-visible:ring-offset-4 focus-visible:ring-offset-ink motion-reduce:transition-none"
            data-404-spas
          >
            <span>{t.spas}</span>
            <Icon name="arrow-right" class="h-5 w-5" />
          </a>
        </div>

        <div class="mx-auto mt-8 max-w-xl rounded-2xl border border-white/[0.07] bg-white/[0.025] px-4 py-4 sm:mt-10 sm:px-6">
          <p class="text-xs font-medium uppercase tracking-[0.16em] text-white/35" data-404-more-label>
            {t.moreLabel}
          </p>
          <nav
            class="mt-3 flex flex-wrap items-center justify-center gap-x-5 gap-y-2"
            aria-label={t.recoveryLabel}
            data-404-recovery
          >
            <a
              href={localizePath(defaultLocale, "/guide/")}
              class="inline-flex min-h-11 items-center gap-1.5 px-1 text-sm font-medium text-white/65 transition-colors duration-200 hover:text-gold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold/80"
              data-404-guide
            >
              <span>{t.guide}</span>
              <Icon name="arrow-right" class="h-4 w-4" />
            </a>
            <span class="h-1 w-1 rounded-full bg-gold/35" aria-hidden="true"></span>
            <a
              href={localizePath(defaultLocale, "/contact/")}
              class="inline-flex min-h-11 items-center gap-1.5 px-1 text-sm font-medium text-white/65 transition-colors duration-200 hover:text-gold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold/80"
              data-404-contact
            >
              <span>{t.contact}</span>
              <Icon name="arrow-right" class="h-4 w-4" />
            </a>
          </nav>
        </div>
      </section>
    </main>

    <footer class="relative z-10 flex h-16 items-center justify-center border-t border-gold/10 px-4 text-xs tracking-wider text-white/30">
      <span>© 2026</span>
    </footer>
  </div>

  <script is:inline define:vars={{ copy, locales, defaultLocale, localeLabels }}>
    (() => {
      const supportedLocales = locales;

      const deviceLocale = (language) => {
        const normalized = (language || "").toLowerCase();
        if (normalized === "ja" || normalized.startsWith("ja-")) return "ja";
        if (
          normalized === "zh-tw" ||
          normalized === "zh-hk" ||
          normalized === "zh-mo" ||
          normalized === "zh-hant" ||
          normalized.startsWith("zh-hant-")
        ) return "zh-TW";
        if (
          normalized === "zh" ||
          normalized === "zh-cn" ||
          normalized === "zh-sg" ||
          normalized === "zh-hans" ||
          normalized.startsWith("zh-hans-")
        ) return "zh-CN";
        return defaultLocale;
      };

      const prefix = window.location.pathname.split("/")[1];
      const initialLocale = supportedLocales.includes(prefix)
        ? prefix
        : deviceLocale(navigator.language);

      const elements = {
        eyebrow: document.querySelector("[data-404-eyebrow]"),
        heading: document.querySelector("[data-404-heading]"),
        body: document.querySelector("[data-404-body]"),
        brand: document.querySelector("[data-404-brand]"),
        languageCurrent: document.querySelector("[data-404-language-current]"),
        languageToggle: document.querySelector("[data-404-language-toggle]"),
        languagePanel: document.querySelector("[data-404-language-panel]"),
        brandLink: document.querySelector("[data-404-brand-link]"),
        home: document.querySelector("[data-404-home]"),
        spas: document.querySelector("[data-404-spas]"),
        guide: document.querySelector("[data-404-guide]"),
        contact: document.querySelector("[data-404-contact]"),
        moreLabel: document.querySelector("[data-404-more-label]"),
        recovery: document.querySelector("[data-404-recovery]"),
      };
      const localeLinks = document.querySelectorAll("[data-404-locale-link]");

      const setLink = (element, href, label) => {
        if (!element) return;
        element.setAttribute("href", href);
        const text = element.querySelector?.("span");
        if (text) text.textContent = label;
        else element.textContent = label;
      };

      const closeLanguagePanel = () => {
        elements.languagePanel?.classList.add("hidden");
        elements.languageToggle?.setAttribute("aria-expanded", "false");
      };

      const renderLocale = (locale) => {
        const safeLocale = supportedLocales.includes(locale) ? locale : defaultLocale;
        const strings = copy[safeLocale];
        document.documentElement.lang = safeLocale;
        document.title = `${strings.heading} | ${strings.brand}`;

        if (elements.eyebrow) elements.eyebrow.textContent = strings.eyebrow;
        if (elements.heading) elements.heading.textContent = strings.heading;
        if (elements.body) elements.body.textContent = strings.body;
        if (elements.brand) elements.brand.textContent = strings.brand;
        if (elements.moreLabel) elements.moreLabel.textContent = strings.moreLabel;
        elements.recovery?.setAttribute("aria-label", strings.recoveryLabel);
        if (elements.languageCurrent) elements.languageCurrent.textContent = localeLabels[safeLocale];
        elements.languageToggle?.setAttribute(
          "aria-label",
          `${strings.languageLabel}: ${localeLabels[safeLocale]}`,
        );

        setLink(elements.brandLink, `/${safeLocale}/`, strings.brand);
        setLink(elements.home, `/${safeLocale}/`, strings.home);
        setLink(elements.spas, `/${safeLocale}/#spas`, strings.spas);
        setLink(elements.guide, `/${safeLocale}/guide/`, strings.guide);
        setLink(elements.contact, `/${safeLocale}/contact/`, strings.contact);

        localeLinks.forEach((link) => {
          const linkLocale = link.dataset.locale;
          const current = linkLocale === safeLocale;
          link.setAttribute("href", `/${linkLocale}/`);
          link.classList.toggle("bg-gold/15", current);
          link.classList.toggle("text-gold", current);
          link.classList.toggle("text-white/70", !current);
          link.querySelector?.("[data-404-locale-check]")?.classList.toggle("hidden", !current);
          if (current) link.setAttribute("aria-current", "true");
          else link.removeAttribute("aria-current");
        });

        closeLanguagePanel();
      };

      renderLocale(initialLocale);

      elements.languageToggle?.addEventListener("click", () => {
        const open = elements.languagePanel?.classList.toggle("hidden") === false;
        elements.languageToggle?.setAttribute("aria-expanded", String(open));
      });

      localeLinks.forEach((link) => {
        link.addEventListener("click", (event) => {
          event.preventDefault();
          renderLocale(link.dataset.locale);
          elements.languageToggle?.focus();
        });
      });

      document.addEventListener("click", (event) => {
        if (
          elements.languagePanel?.contains(event.target) ||
          elements.languageToggle?.contains(event.target)
        ) return;
        closeLanguagePanel();
      });

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        closeLanguagePanel();
        elements.languageToggle?.focus();
      });
    })();
  </script>

  <style>
    .not-found-page {
      isolation: isolate;
      background: #080808;
    }

    .not-found-atmosphere {
      z-index: -2;
      background:
        radial-gradient(circle at 50% 24%, rgb(212 175 55 / 0.14), transparent 27rem),
        radial-gradient(circle at 12% 78%, rgb(212 175 55 / 0.06), transparent 22rem),
        linear-gradient(180deg, #0d0d0d 0%, #080808 58%, #050505 100%);
    }

    .not-found-grid {
      z-index: -1;
      opacity: 0.22;
      background-image: radial-gradient(circle, rgb(232 201 107 / 0.28) 0.75px, transparent 0.85px);
      background-size: 34px 34px;
      mask-image: linear-gradient(to bottom, black, transparent 76%);
    }

    .not-found-code {
      margin-bottom: -0.1em;
      font-size: clamp(5.5rem, 22vw, 12rem);
      font-weight: 900;
      line-height: 0.88;
      letter-spacing: -0.055em;
      color: transparent;
      -webkit-text-stroke: 1px rgb(212 175 55 / 0.72);
      background: linear-gradient(180deg, rgb(232 201 107 / 0.35), rgb(212 175 55 / 0.04));
      background-clip: text;
      -webkit-background-clip: text;
      filter: drop-shadow(0 0 32px rgb(212 175 55 / 0.12));
      animation: not-found-breathe 5s ease-in-out infinite;
      user-select: none;
    }

    @keyframes not-found-breathe {
      0%,
      100% {
        opacity: 0.72;
        transform: translateY(0);
      }
      50% {
        opacity: 1;
        transform: translateY(-4px);
      }
    }

    @media (max-width: 359px) {
      .not-found-code {
        font-size: 5rem;
      }

      .not-found-language-current {
        display: none;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .not-found-code {
        animation: none;
      }
    }
  </style>
</Layout>
