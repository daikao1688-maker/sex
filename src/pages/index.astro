<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Macau Sauna Sites</title>
    <style>
      :root {
        color-scheme: dark;
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #0a0a0a;
        color: #fff;
      }

      body {
        min-height: 100vh;
        margin: 0;
        display: grid;
        place-items: center;
        padding: 1.5rem;
        box-sizing: border-box;
        background:
          radial-gradient(circle at 50% 20%, rgba(212, 175, 55, 0.13), transparent 32rem),
          #0a0a0a;
      }

      main {
        width: min(100%, 42rem);
        text-align: center;
      }

      h1 {
        margin: 0;
        font-size: clamp(1.75rem, 7vw, 3rem);
        line-height: 1.1;
      }

      p {
        margin: 1rem auto 1.75rem;
        color: rgba(255, 255, 255, 0.66);
        line-height: 1.6;
      }

      nav {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem;
      }

      a {
        min-height: 3rem;
        display: grid;
        place-items: center;
        border: 1px solid rgba(212, 175, 55, 0.35);
        border-radius: 0.75rem;
        color: #d4af37;
        text-decoration: none;
        font-weight: 700;
        background: rgba(20, 20, 20, 0.9);
      }

      a:hover,
      a:focus-visible {
        border-color: #d4af37;
        background: #181818;
        outline: 2px solid transparent;
      }

      @media (max-width: 30rem) {
        nav {
          grid-template-columns: 1fr;
        }
      }
    </style>
    <script is:inline data-root-locale-redirect>
      (() => {
        const language = (navigator.language || '').toLowerCase();
        let locale = 'en';

        if (language === 'ko' || language.startsWith('ko-')) {
          locale = 'ko';
        } else if (language === 'ja' || language.startsWith('ja-')) {
          locale = 'ja';
        } else if (
          language === 'zh-tw' ||
          language.startsWith('zh-tw-') ||
          language === 'zh-hk' ||
          language.startsWith('zh-hk-') ||
          language === 'zh-mo' ||
          language.startsWith('zh-mo-') ||
          language === 'zh-hant' ||
          language.startsWith('zh-hant-')
        ) {
          locale = 'zh-TW';
        } else if (
          language === 'zh' ||
          language === 'zh-cn' ||
          language.startsWith('zh-cn-') ||
          language === 'zh-sg' ||
          language.startsWith('zh-sg-') ||
          language === 'zh-hans' ||
          language.startsWith('zh-hans-')
        ) {
          locale = 'zh-CN';
        }

        location.replace(`/${locale}/${location.search}${location.hash}`);
      })();
    </script>
  </head>
  <body>
    <main>
      <h1>Macau Sauna Sites</h1>
      <p>Choose your language if automatic forwarding does not start.</p>
      <nav data-root-locale-fallback aria-label="Choose a language">
        <a href="/en/" hreflang="en" lang="en">English</a>
        <a href="/zh-TW/" hreflang="zh-TW" lang="zh-TW">繁體中文</a>
        <a href="/zh-CN/" hreflang="zh-CN" lang="zh-CN">简体中文</a>
        <a href="/ja/" hreflang="ja" lang="ja">日本語</a>
        <a href="/ko/" hreflang="ko" lang="ko">한국어</a>
      </nav>
    </main>
  </body>
</html>
