---
import PageShell from "../../layouts/PageShell.astro";
import Icon from "../../components/Icon.astro";
import { locales, localizePath, type Locale } from "../../i18n/config";
import { getPrivacyCopy } from "../../i18n/pages/privacy";
import { site } from "../../data/site";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const copy = getPrivacyCopy(lang);

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "PrivacyPolicy",
    name: copy.heading,
    description: copy.meta.description,
    url: new URL(localizePath(lang, "/privacy/"), site.origin).href,
  },
];
---

<PageShell
  lang={lang}
  path="/privacy/"
  title={copy.meta.title}
  description={copy.meta.description}
  breadcrumbs={copy.breadcrumbs}
  schemas={schemas}
>
  <section class="pt-6 sm:pt-10 pb-16 px-4">
    <div class="max-w-3xl mx-auto">
      <div class="fade-up">
        <a
          href={localizePath(lang, "/")}
          class="group inline-flex items-center text-white/40 hover:text-gold transition-colors text-sm mb-6"
        >
          <Icon
            name="arrow-left"
            class="w-4 h-4 mr-2 transition-transform group-hover:-translate-x-1"
          />
          {copy.backHome}
        </a>

        <h1 class="text-3xl sm:text-4xl font-bold mb-3">{copy.heading}</h1>
        <p class="text-white/40 text-sm mb-8">{copy.effectiveDate}</p>

        <div
          class="rounded-2xl border border-gold/15 bg-gradient-to-b from-gold/[0.06] to-transparent p-5 sm:p-6 mb-10"
        >
          <p class="text-white/80 leading-relaxed">{copy.summary}</p>
        </div>

        {
          copy.sections.map((section) => (
            <div class="mb-8">
              <h2 class="text-xl font-bold mb-3 text-gold">{section.heading}</h2>
              {section.paragraphs.map((paragraph) => (
                <p class="text-white/65 leading-relaxed mb-3">{paragraph}</p>
              ))}
            </div>
          ))
        }

        <div class="mt-10 pt-6 border-t border-white/5">
          <a
            href={localizePath(lang, "/contact/")}
            class="inline-flex items-center gap-1 text-gold hover:underline text-sm font-medium"
          >
            {copy.contactLink}
          </a>
        </div>
      </div>
    </div>
  </section>
</PageShell>
