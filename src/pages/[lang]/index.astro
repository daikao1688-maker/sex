---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import PromoBar from "../../components/PromoBar.astro";
import Hero from "../../components/Hero.astro";
import BestOfMonth from "../../components/BestOfMonth.astro";
import SpaGrid from "../../components/SpaGrid.astro";
import HowItWorks from "../../components/HowItWorks.astro";
import QuickMatch from "../../components/QuickMatch.astro";
import Features from "../../components/Features.astro";
import Testimonials from "../../components/Testimonials.astro";
import BlogTeaser from "../../components/BlogTeaser.astro";
import CtaBand from "../../components/CtaBand.astro";
import ContactSection from "../../components/ContactSection.astro";
import Mission from "../../components/Mission.astro";
import Footer from "../../components/Footer.astro";
import WeChatModal from "../../components/WeChatModal.astro";
import FloatingContactPill from "../../components/FloatingContactPill.astro";
import { locales, type Locale } from "../../i18n/config";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const skipLabels: Record<Locale, string> = {
  en: "Skip to main content",
  "zh-TW": "跳至主要內容",
  "zh-CN": "跳至主要内容",
  ja: "メインコンテンツへ移動",
  ko: "본문으로 건너뛰기",
};
---

<Layout lang={lang} path="/" siteSchema>
  <a
    href="#main-content"
    data-skip-link
    class="sr-only fixed left-4 top-4 z-[300] rounded-lg bg-gold px-4 py-2 font-semibold text-black focus:not-sr-only focus:outline-none focus:ring-2 focus:ring-white"
  >
    {skipLabels[lang]}
  </a>
  <div data-page-background class="min-h-screen bg-ink text-white">
    <Navbar lang={lang} path="/" />
    <PromoBar lang={lang} />
    <main id="main-content" tabindex="-1">
      <Hero lang={lang} />
      <BestOfMonth lang={lang} />
      <SpaGrid lang={lang} />
      <HowItWorks lang={lang} />
      <QuickMatch lang={lang} />
      <Features lang={lang} />
      <Testimonials lang={lang} />
      <BlogTeaser lang={lang} />
      <CtaBand lang={lang} />
      <ContactSection lang={lang} />
      <Mission lang={lang} />
    </main>
    <Footer lang={lang} />
    <FloatingContactPill lang={lang} />
  </div>

  <WeChatModal lang={lang} />
</Layout>
