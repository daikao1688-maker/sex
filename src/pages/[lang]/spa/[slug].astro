      <div
        data-video-modal
        aria-hidden="true"
        inert
        class="fixed inset-0 z-[140] pointer-events-none invisible"
      >
        <div
          class="absolute inset-0 bg-black/80 transition-opacity duration-300 opacity-0"
          data-video-scrim
        >
        </div>
        <div class="absolute inset-0 flex items-center justify-center p-4 pointer-events-none">
          <div
            role="dialog"
            aria-modal="true"
            aria-labelledby="venue-video-title"
            data-video-panel
            class="dining-video-panel pointer-events-auto opacity-0 scale-95 transition-all duration-300"
          >
            <div class="mb-3 flex items-center justify-between gap-4">
              <p id="venue-video-title" class="text-sm font-semibold text-gold-light" data-video-modal-title></p>
              <button
                type="button"
                data-video-close
                aria-label={copy.labels.videoClose}
                class="flex-shrink-0 p-2.5 rounded-full bg-white/10 text-white ring-1 ring-white/15 hover:bg-white/20 active:bg-white/25 transition-colors"
              >
                <Icon name="close" class="w-5 h-5" />
              </button>
            </div>
            <video
              preload="none"
              controls
              playsinline
              tabindex="0"
              aria-labelledby="venue-video-title"
              class="dining-video-player block rounded-xl border border-gold/50 bg-black"
            ></video>
          </div>
        </div>
      </div>
      <script>
        (() => {
          const modal = document.querySelector<HTMLElement>("[data-video-modal]");
          if (!modal) return;
          // Move out of [data-page-background]: opening sets that container inert,
          // which would disable every control inside the modal (close button, video).
          document.body.append(modal);
          const scrim = modal.querySelector<HTMLElement>("[data-video-scrim]");
          const panel = modal.querySelector<HTMLElement>("[data-video-panel]");
          const video = modal.querySelector<HTMLVideoElement>("video");
          const closeButton = modal.querySelector<HTMLButtonElement>("[data-video-close]");
          const titleEl = modal.querySelector<HTMLElement>("[data-video-modal-title]");
          let lastTrigger: HTMLElement | null = null;
          let previousBodyOverflow = "";
          let closeTimer: number | undefined;
          const isOpen = () => modal.getAttribute("aria-hidden") === "false";
          const setBackgroundInert = (inert: boolean) => {
            const background = document.querySelector<HTMLElement>("[data-page-background]");
            if (background) background.inert = inert;
          };

          const open = (trigger: HTMLElement) => {
            const src = trigger.dataset.videoSrc;
            if (isOpen() || !video || !src) return;
            window.clearTimeout(closeTimer);
            if (video.getAttribute("src") !== src) {
              video.setAttribute("src", src);
              const poster = trigger.dataset.videoPoster;
              if (poster) video.setAttribute("poster", poster);
              else video.removeAttribute("poster");
            }
            if (titleEl && trigger.dataset.videoTitle) {
              titleEl.textContent = trigger.dataset.videoTitle;
            }
            lastTrigger = trigger;
            previousBodyOverflow = document.body.style.overflow;
            modal.classList.remove("pointer-events-none", "invisible");
            modal.setAttribute("aria-hidden", "false");
            modal.inert = false;
            scrim?.classList.replace("opacity-0", "opacity-100");
            panel?.classList.remove("opacity-0", "scale-95");
            setBackgroundInert(true);
            document.body.style.overflow = "hidden";
            // The clip only starts downloading now — no src on the element before this.
            video?.play().catch(() => {});
            requestAnimationFrame(() => {
              if (isOpen()) closeButton?.focus({ preventScroll: true });
            });
          };

          const close = () => {
            if (!isOpen()) return;
            video?.pause();
            video?.removeAttribute("src");
            video?.load();
            modal.setAttribute("aria-hidden", "true");
            scrim?.classList.replace("opacity-100", "opacity-0");
            panel?.classList.add("opacity-0", "scale-95");
            setBackgroundInert(false);
            document.body.style.overflow = previousBodyOverflow;
            lastTrigger?.focus({ preventScroll: true });
            lastTrigger = null;
            modal.inert = true;
            closeTimer = window.setTimeout(() => {
              if (!isOpen()) modal.classList.add("pointer-events-none", "invisible");
            }, 300);
          };

          document.addEventListener("click", (event) => {
            const target = event.target as HTMLElement | null;
            const trigger = target?.closest<HTMLElement>("[data-video-open]");
            if (trigger) {
              event.preventDefault();
              open(trigger);
            } else if (target?.closest("[data-video-close]") || target === scrim) {
              close();
            }
          });

          document.addEventListener("keydown", (event) => {
            if (!isOpen()) return;
            if (event.key === "Escape") {
              event.preventDefault();
              close();
            } else if (event.key === "Tab" && event.shiftKey && document.activeElement === closeButton) {
              event.preventDefault();
              video?.focus();
            }
          });
          document.addEventListener("focusin", (event) => {
            // Let Tab traverse the browser's native video controls before wrapping.
            // Trapping on activeElement === video would skip those shadow-DOM controls.
            const target = event.target as Node | null;
            if (isOpen() && target && !modal.contains(target)) {
              closeButton?.focus({ preventScroll: true });
            }
          });
        })();
      </script>
      </>
    )
  }
</PageShell>

