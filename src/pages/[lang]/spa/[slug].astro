---
import { existsSync } from "node:fs";
import PageShell from "../../../layouts/PageShell.astro";
import Icon from "../../../components/Icon.astro";
import SpaGallery from "../../../components/SpaGallery.astro";
import ContactChannels from "../../../components/ContactChannels.astro";
import VipExtrasDrawer from "../../../components/VipExtrasDrawer.astro";
import VenueLicenseNotice from "../../../components/VenueLicenseNotice.astro";
import { getDictionary, interpolate } from "../../../i18n";
import { locales, localizePath, type Locale } from "../../../i18n/config";
import { getSpaPageCopy, spaBreadcrumbs, venueSummary } from "../../../i18n/pages/spa";
import { getSpaVisitFlow } from "../../../i18n/pages/spaVisitFlow";
import { resolveVenueDetail } from "../../../lib/spaDetail";
import { venues } from "../../../data/venues";
import { getDiningVideo } from "../../../data/venueDiningVideos";
import { venueInteriorVideos } from "../../../data/venueInteriorVideos";
import { getReplacementVenueGallery } from "../../../data/venueGalleries";
import { venueHeroImageMetadata } from "../../../data/venueHeroImages";
import { site, contact, chatUrl } from "../../../data/site";

export function getStaticPaths() {
  return locales.flatMap((lang) =>
    venues.map((venue) => ({ params: { lang, slug: venue.slug }, props: { venue } })),
  );
}

const { venue } = Astro.props;
const lang = Astro.params.lang as Locale;

const t = getDictionary(lang);
const copy = getSpaPageCopy(lang);
const detail = resolveVenueDetail(venue, copy, t);

const venueCopy = t.spas.venues[venue.slug];
const name = venueCopy.name;
const visitFlow = getSpaVisitFlow(lang, name);
const diningVideo = getDiningVideo(venue.slug);
const diningVideoTitle = diningVideo
  ? interpolate(copy.labels.diningVideoTitle, { duration: diningVideo.durationSeconds })
  : "";
const interiorVideo = venueInteriorVideos[venue.slug];
const interiorVideoBadge = interiorVideo
  ? interpolate(copy.labels.interiorVideoBadge, { duration: interiorVideo.durationSeconds })
  : "";
const inquiryMessage = (venue.temporarilyClosed ? copy.inquiry.closed : copy.inquiry.booking)
  .replace("{venue}", () => name);
const summary = venueCopy.summary ?? venueSummary(venueCopy.description, lang);
const path = `/spa/${venue.slug}/`;
const cover = `/covers/${venue.cover}.jpg`;
const useWeChatQuickContact = lang === "zh-TW" || lang === "zh-CN";
// Keep the Korean quick-contact pair equal even when the localized labels differ.
const koreanQuickContactClass = "inline-flex min-h-11 w-full min-w-0 items-center justify-center gap-2 rounded-full px-3 py-2 text-sm font-bold leading-5 whitespace-nowrap sm:px-4 transition-colors hover:brightness-95 active:brightness-90 focus-visible:outline-2 focus-visible:outline-offset-4";
const galleryImages = getReplacementVenueGallery(venue.slug, lang) ?? detail.gallery;

const price = `MOP ${venue.priceMin.toLocaleString("en-US")} - ${venue.priceMax.toLocaleString("en-US")}`;
const practicalHours = venue.open24h ? copy.labels.openAllDay : venue.hours;
const paymentMethods = detail.paymentMethods ?? copy.paymentMethods;

/**
 * Hero backdrop: the venue's lead gallery photo at full size, falling back to
 * the card cover for venues whose photos are not on disk yet.
 */
const heroSource = galleryImages.find((image) =>
  existsSync(`public/media/${image.file}-lg.webp`),
);
const heroImage = heroSource ? `/media/${heroSource.file}-lg.webp` : cover;
const heroSmallImage = heroSource
  ? `/media/${heroSource.file}-hero-768.webp`
  : `/covers/${venue.cover}-400.jpg`;
const heroSmallWidth = heroSource ? 768 : 400;
const heroDimensions = heroSource
  ? venueHeroImageMetadata[heroSource.file]
  : { width: 800, height: 800 };
if (!heroDimensions) {
  throw new Error(`Missing intrinsic hero dimensions for ${venue.slug}/${heroSource?.file}`);
}
const heroAlt = heroSource ? heroSource.alt : `${name} — Macau premium sauna venue`;

const related = venues
  .filter((other) => other.slug !== venue.slug && !other.temporarilyClosed)
  .slice(0, 4);

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    name,
    description: summary,
    url: new URL(localizePath(lang, path), site.origin).href,
    image: new URL(cover, site.origin).href,
    address: { "@type": "PostalAddress", addressCountry: "MO", addressLocality: "Macau" },
    areaServed: { "@type": "Country", name: "Macau" },
    aggregateRating: undefined,
    ...(venue.temporarilyClosed
      ? {}
      : {
          priceRange: `MOP ${venue.priceMin} – ${venue.priceMax}`,
        }),
  },
];
---

<PageShell
  lang={lang}
  path={path}
  title={`${name} - ${t.meta.siteName}`}
  description={summary}
  ogImage={cover}
  ogImageAlt={heroAlt}
  ogImageWidth={800}
  ogImageHeight={800}
  breadcrumbs={spaBreadcrumbs(copy, name, venue.slug)}
  schemas={schemas}
  promo={false}
  inquiryMessage={inquiryMessage}
  contactHref="#contact"
>
  <section data-testid="spa-hero" class="relative min-h-[50vh] sm:min-h-[60vh] flex items-end overflow-hidden">
    <img
      src={heroImage}
      srcset={`${heroSmallImage} ${heroSmallWidth}w, ${heroImage} ${heroDimensions.width}w`}
      sizes="100vw"
      alt={heroAlt}
      width={heroDimensions.width}
      height={heroDimensions.height}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-black/40 to-black/30"></div>
    <div class="relative z-10 w-full max-w-5xl mx-auto px-4 pt-24 pb-10 sm:pt-28">
      <div class="fade-up">
        <a
          href={localizePath(lang, "/")}
          class="inline-flex items-center gap-2 text-white/60 hover:text-gold transition-colors mb-4 text-sm"
        >
          <Icon name="arrow-left" class="w-4 h-4" />
          {copy.backHome}
        </a>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-wide">{name}</h1>
        <div
          data-venue-rating
          role="img"
          aria-label={`${t.spas.stats.ratingTitle}: ${venue.rating} / 5`}
          class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2"
        >
          <span aria-hidden="true" class="inline-flex gap-1 text-xl leading-none sm:text-2xl">
            {Array.from({ length: 5 }, (_, index) => (
              <span
                data-rating-star={index < venue.rating ? "filled" : "empty"}
                class={index < venue.rating ? "text-gold" : "text-white/20"}
              >★</span>
            ))}
          </span>
          <span aria-hidden="true" class="text-sm font-semibold tabular-nums text-white/90 sm:text-base">
            {venue.rating.toFixed(1)} <span class="font-normal text-white/50">/ 5</span>
          </span>
          <span aria-hidden="true" class="text-xs text-white/60 sm:text-sm">{t.spas.stats.ratingTitle}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 pt-10 sm:pt-14">
    <div class="max-w-5xl mx-auto">
      {
        venue.temporarilyClosed && (
          <aside
            data-testid="spa-temporarily-closed-notice"
            role="status"
            class="fade-up mb-8 flex flex-col gap-3 rounded-2xl border border-gold/35 bg-gold/[0.04] px-5 py-4 sm:mb-10 sm:flex-row sm:items-center sm:gap-5 sm:px-6 sm:py-5"
          >
            <span class="inline-flex w-fit shrink-0 rounded-full border border-gold/60 bg-black/35 px-4 py-2 text-sm font-bold text-gold-light">
              {t.spas.temporarilyClosed}
            </span>
            <p class="text-sm leading-relaxed text-white/80 sm:text-base">
              {t.spas.temporarilyClosedNotice}
            </p>
          </aside>
        )
      }
      <div class="fade-up mb-10">
        <p class="text-white/60 leading-relaxed whitespace-pre-line max-w-3xl">
          {venueCopy.description}
        </p>
        {
          detail.aliases && (
            <p class="text-white/60 text-sm mt-4">
              {copy.alsoKnownAs} {detail.aliases}
            </p>
          )
        }
        {
          detail.isPlaceholder && (
            <p class="mt-4 inline-block rounded-full border border-gold/30 bg-gold/10 px-3 py-1 text-xs text-gold">
              Placeholder detail — awaiting venue copy
            </p>
          )
        }
      </div>

      <div class="mb-12">
        <div data-testid="spa-practical-info" class="fade-up">
          <dl class="practical-info-card overflow-hidden rounded-2xl">
            <div
              data-info-icon="price"
              class="border-b border-white/5 px-5 py-4"
            >
              <dt class="mb-1 flex items-center gap-2">
                <Icon name="badge-dollar-sign" class="h-5 w-5 shrink-0 text-gold" />
                <span class="text-xs uppercase tracking-wider text-white/60">
                  {copy.labels.referencePrice}
                </span>
              </dt>
              <dd class="ml-7 min-w-0">
                <p class="mt-1 text-lg font-medium text-white break-words">{price}</p>
                <p class="mt-1 text-sm text-white/60" data-spa-service-fee>
                  {copy.labels.separateServiceFee}: {
                    venue.serviceFee === "none" ? copy.labels.noSeparateSurcharge : venue.serviceFee
                  }
                </p>
                <p class="mt-1 max-w-2xl text-xs leading-relaxed text-white/60" data-spa-price-note>
                  {copy.labels.priceDisclaimer}
                </p>
                <a
                  href="#contact"
                  class="mt-1 inline-flex min-h-11 items-center text-sm text-gold transition-colors hover:text-gold-light focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold/70"
                  >{
                    venue.temporarilyClosed
                      ? t.spas.contactForAlternative
                      : detail.contactCta ?? copy.labels.discountCta
                  }</a
                >
              </dd>
            </div>

            <div
              data-info-icon="staff"
              class="border-b border-white/5 px-5 py-4"
            >
              <dt class="mb-1 flex items-center gap-2">
                <Icon name="users" class="h-5 w-5 shrink-0 text-gold" />
                <span class="text-xs uppercase tracking-wider text-white/60">{copy.labels.staff}</span>
              </dt>
              <dd class="ml-7 min-w-0 font-medium leading-relaxed text-white break-words">
                {copy.labels.staffValue}
              </dd>
            </div>

            <div
              data-info-icon="hours"
              class="info-row border-b border-dashed border-gold/20 px-5 py-4"
              style="--row-delay: 0.2s"
            >
              <dt class="mb-1 flex items-center gap-2">
                <Icon name="clock" class="h-5 w-5 shrink-0 text-gold" />
                <span class="text-xs uppercase tracking-wider text-white/60">{copy.labels.hours}</span>
              </dt>
              <dd class="ml-7 min-w-0">
                <p class="font-medium text-white break-words">{practicalHours}</p>
                <p class="text-sm text-white/50 break-words">{copy.labels.staffHours} {venue.hours}</p>
              </dd>
            </div>

            <div
              data-info-icon="overnight"
              class="border-b border-white/5 px-5 py-4"
            >
              <dt class="mb-1 flex items-center gap-2">
                <Icon name="moon" class="h-5 w-5 shrink-0 text-gold" />
                <span class="text-xs uppercase tracking-wider text-white/60">
                  {copy.labels.overnight}
                </span>
              </dt>
              <dd class="ml-7 min-w-0 font-medium leading-relaxed text-white break-words">
                {
                  detail.overnightValue ??
                    (venue.overnightAllowed
                      ? copy.labels.overnightAvailable
                      : copy.labels.overnightUnavailable)
                }
                {
                  detail.overnightNote && (
                    <span class="text-sm font-normal text-white/50"> {detail.overnightNote}</span>
                  )
                }
              </dd>
            </div>

            <div
              data-info-icon="highlights"
              class="border-b border-white/5 px-5 py-4"
            >
              <dt class="mb-1 flex items-center gap-2">
                <Icon name="sparkles" class="h-5 w-5 shrink-0 text-gold" />
                <span class="text-xs uppercase tracking-wider text-white/60">
                  {copy.labels.highlights}
                </span>
              </dt>
              <dd class="ml-7 min-w-0">
                <ul class="mt-2 space-y-1">
                  {
                    detail.highlights.map((highlight) => (
                      <li class="flex items-start gap-2 text-sm font-medium text-white">
                        <span class="mt-0.5 text-gold/60">•</span>
                        <span class="min-w-0 break-words">{highlight}</span>
                      </li>
                    ))
                  }
                </ul>
              </dd>
            </div>

            <div
              data-info-icon="best-for"
              class="border-b border-white/5 px-5 py-4"
            >
              <dt class="mb-1 flex items-center gap-2">
                <span class="info-ring" aria-hidden="true"><Icon name="tag" class="h-4 w-4" /></span>
                <span class="text-xs uppercase tracking-wider text-white/60">
                  {copy.labels.bestFor}
                </span>
              </dt>
              <dd class="ml-7 min-w-0 font-medium leading-relaxed text-white break-words">
                {detail.bestFor}
              </dd>
            </div>

            {
              paymentMethods.length > 0 && (
                <div data-info-icon="payment" class="px-5 py-4">
                  <dt class="mb-1 flex items-center gap-2">
                    <span class="info-ring" aria-hidden="true"><Icon name="credit-card" class="h-4 w-4" /></span>
                    <span class="text-xs uppercase tracking-wider text-white/60">
                      {copy.labels.payment}
                    </span>
                  </dt>
                  <dd class="ml-7 mt-2 flex min-w-0 flex-wrap gap-2">
                    {paymentMethods.map((method) => (
                      <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-white/70">
                        {method}
                      </span>
                    ))}
                  </dd>
                </div>
              )
            }
          </dl>

          {
            venue.temporarilyClosed ? (
              <div
                data-testid="spa-temporarily-closed-actions"
                class="mt-4 rounded-2xl border border-gold/15 bg-gold/[0.04] p-4 text-center"
              >
                <p class="mb-3 text-sm text-white/70">{t.spas.temporarilyClosedNotice}</p>
                <div class="flex flex-wrap items-center justify-center gap-3">
                  <a
                    href="#related"
                    class="inline-flex min-h-11 items-center gap-2 rounded-full bg-gold px-4 py-2 text-sm font-bold text-black transition-transform hover:-translate-y-0.5"
                  >
                    {t.spas.browseOtherVenues}
                    <Icon name="arrow-right" class="h-4 w-4" />
                  </a>
                  <a
                    href="#contact"
                    class="inline-flex min-h-11 items-center rounded-full border border-gold/50 px-4 py-2 text-sm font-bold text-gold transition-colors hover:border-gold hover:bg-gold/10"
                  >
                    {t.spas.contactForAlternative}
                  </a>
                </div>
              </div>
            ) : (
              <div
                data-testid="spa-quick-contact"
                class="mt-4 rounded-2xl border border-gold/15 bg-gold/[0.04] p-4 text-center"
              >
                <p class="text-white/70 text-sm mb-3">{detail.bookingNote ?? copy.labels.quickBook}</p>
                <div class={lang === "ko" ? "mx-auto grid w-full max-w-xs grid-cols-2 items-center gap-3" : "flex flex-wrap items-center justify-center gap-3"}>
                  {
                    lang === "ko" ? (
                      <button
                        type="button"
                        data-kakaotalk-trigger
                        aria-haspopup="dialog"
                        aria-controls="kakaotalk-modal"
                        class:list={[koreanQuickContactClass, "bg-[#FEE500] text-black focus-visible:outline-[#FEE500]"]}
                      >
                        <img src="/icons/kakaotalk.svg" alt="" width="16" height="16" />{t.kakaotalk.name}
                      </button>
                    ) : (
                      <a
                        href={chatUrl(contact.whatsapp.url, inquiryMessage)}
                        target="_blank"
                        rel="noopener"
                        class="inline-flex items-center gap-2 rounded-full bg-[#25d366] px-4 py-2 text-sm font-bold text-white transition-transform hover:-translate-y-0.5"
                      >
                        <img src="/icons/whatsapp.svg" alt="" width="16" height="16" />WhatsApp
                      </a>
                    )
                  }
                  {
                    useWeChatQuickContact ? (
                      <button
                        type="button"
                        data-testid="spa-quick-contact-secondary"
                        data-wechat-trigger
                        aria-label={t.wechat.title}
                        class="inline-flex items-center gap-2 rounded-full bg-[#07c160] px-4 py-2 text-sm font-bold text-white transition-transform hover:-translate-y-0.5"
                      >
                        <img src="/icons/wechat.svg" alt="" width="16" height="16" />微信
                      </button>
                    ) : (
                      <a
                        href={chatUrl(contact.telegram.url, inquiryMessage)}
                        target="_blank"
                        rel="noopener"
                        data-testid="spa-quick-contact-secondary"
                        class:list={[
                          lang === "ko" ? koreanQuickContactClass : "inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-bold transition-transform hover:-translate-y-0.5",
                          "bg-[#229ed9] text-white",
                          lang === "ko" && "focus-visible:outline-[#229ed9]",
                        ]}
                      >
                        <img src="/icons/telegram.svg" alt="" width="16" height="16" />Telegram
                      </a>
                    )
                  }
                  <a href="#contact" class:list={["text-gold text-sm font-medium hover:underline", lang === "ko" && "col-span-2 justify-self-center"]}
                    >{detail.contactCta ?? copy.labels.allContacts}</a
                  >
                </div>
              </div>
            )
          }
        </div>
      </div>

      {
        interiorVideo && (
          <div class="fade-up mb-16">
            <div class="mb-5 flex items-center gap-3">
              <span class="info-ring" aria-hidden="true">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
              </span>
              <h2 class="text-sm font-semibold tracking-[0.25em] text-gold-light">
                {copy.labels.interiorVideoHeading}
              </h2>
              <span class="feature-rule" aria-hidden="true"></span>
            </div>
            <div class="practical-info-card rounded-2xl p-5 sm:p-6">
              <button
                type="button"
                data-video-open
                data-video-src={interiorVideo.src}
                data-video-poster={interiorVideo.poster}
                data-video-title={`${copy.labels.interiorVideoTitle} · ${name}`}
                class="interior-video-card mx-auto flex w-full flex-col items-center gap-4 text-center"
                aria-label={`${copy.labels.interiorVideoTitle} · ${interiorVideoBadge} · ${name}`}
              >
                <span class="interior-video-preview">
                  <img src={interiorVideo.poster} alt="" loading="lazy" decoding="async" width={interiorVideo.width} height={interiorVideo.height} />
                  <span class="interior-video-play" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="#f0d67e">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </span>
                  <span class="interior-video-badge" aria-hidden="true">{interiorVideoBadge}</span>
                </span>
                <span>
                  <span class="block text-sm font-semibold text-white">{copy.labels.interiorVideoTitle}</span>
                  <span class="mt-1 block text-xs leading-relaxed text-white/50">
                    {copy.labels.interiorVideoDesc}
                  </span>
                </span>
              </button>
            </div>
          </div>
        )
      }

      <SpaGallery
        images={galleryImages}
        fallbackImage={cover}
        fallbackAlt={`${name} — Macau premium sauna venue`}
        heading={copy.labels.gallery}
        viewLarger={copy.labels.viewLarger}
        closeLabel={t.wechat.close}
        previousLabel={copy.labels.previousPhoto}
        nextLabel={copy.labels.nextPhoto}
        swipeHint={copy.labels.gallerySwipeHint}
        photoCountTemplate={copy.labels.galleryPhotoCount}
      />

      <div
        data-testid="spa-flow"
        class="practical-info-card fade-up rounded-2xl p-6 sm:p-8 mb-16"
      >
        <div class="mb-6 flex items-center gap-3">
          <span class="info-ring" aria-hidden="true"><Icon name="check" class="h-4 w-4" /></span>
          <h2 class="text-sm font-semibold tracking-[0.25em] text-gold-light">{copy.labels.flow}</h2>
          <span class="feature-rule" aria-hidden="true"></span>
        </div>
        <div class="relative max-w-2xl">
          <div class="flow-line absolute left-[17px] top-2 bottom-2 w-[1.5px] origin-top bg-gradient-to-b from-gold/70 to-gold/10"></div>
          <div class="space-y-5">
            {
              visitFlow.map((step, index) => (
                <div
                  class="flow-step relative flex gap-5 items-start"
                  style={`--step-delay: ${(index * 0.15).toFixed(2)}s`}
                >
                  <div class="flow-node relative z-10 flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full border border-gold/50 bg-[#141414]">
                    <span class="text-sm font-bold tabular-nums text-gold-light">{index + 1}</span>
                  </div>
                  <div class="flow-step-content min-w-0 flex-1 pt-1.5">
                    <p class="text-white font-medium text-sm">{step.title}</p>
                    <p class="text-white/50 text-sm mt-1 leading-relaxed">{step.body}</p>
                    {
                      diningVideo && index === 4 && (
                        <button
                          type="button"
                          data-video-open
                          data-video-src={diningVideo.src}
                          data-video-poster={diningVideo.poster}
                          data-video-title={diningVideoTitle}
                          class="dining-video-card mt-3 flex w-full items-center gap-3 rounded-xl border border-gold/40 bg-[#141414] p-2.5 text-left transition-colors hover:border-gold/70 hover:bg-gold/[0.06]"
                          aria-label={diningVideoTitle}
                        >
                          <span class="dining-video-thumb" aria-hidden="true">
                            <img src={diningVideo.poster} alt="" loading="lazy" decoding="async" width={diningVideo.width} height={diningVideo.height} />
                            <span class="dining-video-play">
                              <svg width="13" height="13" viewBox="0 0 24 24" fill="#f0d67e">
                                <path d="M8 5v14l11-7z" />
                              </svg>
                            </span>
                          </span>
                          <span class="min-w-0">
                            <span class="block text-sm font-semibold text-gold-light">{diningVideoTitle}</span>
                            <span class="mt-0.5 block text-xs leading-relaxed text-white/50">
                              {copy.labels.diningVideoDesc}
                            </span>
                          </span>
                        </button>
                      )
                    }
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        {
          !venue.temporarilyClosed && !detail.suppressPromotionalClaims && (
            <div
              data-testid="spa-flow-vip-reminder"
              class="mt-8 flex items-start gap-3 rounded-xl border border-gold/15 bg-gold/[0.04] p-4"
            >
              <span class="text-xl leading-none" aria-hidden="true">🎁</span>
              <div>
                <p class="text-gold font-semibold text-sm">{copy.vipReminder.title}</p>
                <p class="text-white/60 text-sm mt-1 leading-relaxed">{copy.vipReminder.body}</p>
                <button
                  type="button"
                  data-open-vip-extras
                  class="mt-3 inline-flex min-h-11 items-center gap-1 rounded-full border border-gold/50 px-4 py-2 text-sm font-semibold text-gold transition-colors hover:bg-gold/10"
                >
                  {copy.vipReminder.cta}
                </button>
              </div>
            </div>
          )
        }

        {
          !detail.suppressPromotionalClaims && (
            <div
              data-testid="spa-flow-concierge-reminder"
