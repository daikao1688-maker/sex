---
import PageShell from "../../../layouts/PageShell.astro";
import Icon from "../../../components/Icon.astro";
import { locales, localizePath, type Locale } from "../../../i18n/config";
import { getBlogCopy } from "../../../i18n/pages/blog";
import { blogCoverPresentation, getPostsFor, postSlug } from "../../../lib/blog";
import { site } from "../../../data/site";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const copy = getBlogCopy(lang);
const posts = await getPostsFor(lang);

const [featured, ...rest] = posts;
const featuredCover = featured ? blogCoverPresentation(featured.data.cover) : null;
const restCards = rest.map((post) => ({ post, cover: blogCoverPresentation(post.data.cover) }));

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: copy.meta.title,
    description: copy.meta.description,
    url: new URL(localizePath(lang, "/blog/"), site.origin).href,
    blogPost: posts.map((post) => ({
      "@type": "BlogPosting",
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.date,
      url: new URL(localizePath(lang, `/blog/${postSlug(post)}/`), site.origin).href,
    })),
  },
];

// Only offer a topic pill when this locale actually has posts in it.
const used = new Set(posts.map((post) => post.data.category));
const order = ["beginner", "price", "compare", "itinerary", "experience", "news"] as const;
const filters = [
  { key: "all", label: copy.allTopics },
  ...order
    .filter((key) => used.has(key))
    .map((key) => ({ key, label: copy.categories[key] })),
];
---

<PageShell
  lang={lang}
  path="/blog/"
  title={copy.meta.title}
  description={copy.meta.description}
  breadcrumbs={copy.breadcrumbs}
  schemas={schemas}
  theme="paper"
  promoCtaHref={localizePath(lang, "/contact/")}
>
  <section class="relative pt-6 pb-8 sm:pt-10 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="fade-up">
        <a
          href={localizePath(lang, "/")}
          class="inline-flex items-center gap-2 text-[var(--paper-soft)] hover:text-[var(--paper-accent)] transition-colors mb-8 text-sm"
        >
          <Icon name="arrow-left" class="w-4 h-4" />
          {copy.backHome}
        </a>
        <h1
          class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 tracking-wider text-[var(--paper-ink)]"
        >
          {copy.heading}
        </h1>
        <p class="text-[var(--paper-muted)] text-base sm:text-lg max-w-xl leading-relaxed">
          {copy.intro}
        </p>
        <div class="w-20 h-0.5 bg-gold mt-6"></div>
      </div>
    </div>
  </section>

  <section class="px-0 pb-20 sm:pb-28">
    <div class="max-w-5xl mx-auto relative">
      {posts.length > 0 && <div class="rm-filterbar px-4 py-3">
        <div class="flex flex-wrap items-center gap-2" role="group" data-blog-filter>
          {
            filters.map((filter, index) => (
              <button
                type="button"
                data-filter-cat={filter.key}
                aria-pressed={index === 0 ? "true" : "false"}
                class:list={[
                  "rounded-full border px-4 py-1.5 text-[13px] transition",
                  index === 0
                    ? "border-gold bg-gold font-bold text-black"
                    : "border-[var(--paper-border)] bg-[var(--paper-card)] text-[var(--paper-muted)] hover:border-gold-dark/60 hover:text-[var(--paper-accent)]",
                ]}
              >
                {filter.label}
              </button>
            ))
          }
        </div>
      </div>}

      <div class="px-4 pt-5">
        {posts.length === 0 && (
          <p class="rounded-2xl border border-[var(--paper-border)] bg-[var(--paper-card)] px-6 py-10 text-center text-[var(--paper-muted)]" data-blog-no-posts>
            {copy.emptyBlog}
          </p>
        )}
        {
          featured && featuredCover && (
            <a
              href={localizePath(lang, `/blog/${postSlug(featured)}/`)}
              class="group block relative rounded-2xl overflow-hidden mb-8 border border-[var(--paper-border)] bg-[var(--paper-card)] shadow-sm hover:shadow-md hover:border-gold-dark/50 transition-all"
              data-blog-card
              data-category={featured.data.category}
            >
              <div class="aspect-[16/9] sm:aspect-[21/9] bg-[#eee7d7] overflow-hidden">
                <img
                  src={featured.data.cover}
                  srcset={featuredCover.srcset}
                  sizes="(min-width: 1024px) 1024px, calc(100vw - 2rem)"
                  alt={featured.data.coverAlt}
                  width={featuredCover.width}
                  height={featuredCover.height}
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-700"
                />
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/15 to-transparent" />
              <div class="absolute bottom-0 left-0 right-0 p-5 sm:p-8">
                <span class="text-gold-light text-xs font-bold uppercase tracking-[0.12em]">
                  {copy.categories[featured.data.category]}
                </span>
                <h2 class="mt-2 text-xl sm:text-3xl font-bold leading-tight max-w-2xl text-white">
                  {featured.data.title}
                </h2>
                <p class="mt-2 text-xs sm:text-sm text-white/70">{featured.data.meta}</p>
              </div>
            </a>
          )
        }

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" data-blog-grid>
          {
            restCards.map(({ post, cover }) => (
              <a
                href={localizePath(lang, `/blog/${postSlug(post)}/`)}
                class="group block rounded-xl overflow-hidden border transition-all bg-[var(--paper-card)] border-[var(--paper-border)] shadow-sm hover:shadow-md hover:border-gold-dark/50"
                data-blog-card
                data-category={post.data.category}
              >
                <div class="aspect-[16/10] overflow-hidden bg-[#eee7d7]">
                  <img
                    src={post.data.cover}
                    srcset={cover.srcset}
                    sizes="(min-width: 1024px) 320px, (min-width: 640px) calc(50vw - 2rem), calc(100vw - 2rem)"
                    alt={post.data.coverAlt}
                    width={cover.width}
                    height={cover.height}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500"
                  />
                </div>
                <div class="p-4">
                  <span class="text-[11px] font-bold uppercase tracking-[0.12em] text-[var(--paper-accent)]">
                    {copy.categories[post.data.category]}
                  </span>
                  <h2 class="mt-1 text-[0.95rem] font-bold leading-snug line-clamp-2 text-[var(--paper-ink)]">
                    {post.data.title}
                  </h2>
                  <p class="mt-2 text-sm leading-relaxed line-clamp-2 text-[var(--paper-muted)]">
                    {post.data.description}
                  </p>
                  <p class="mt-2 text-[11px] text-[var(--paper-soft)]">{post.data.meta}</p>
                </div>
              </a>
            ))
          }
        </div>

        <p class="hidden mt-8 text-center text-sm text-[var(--paper-muted)]" data-blog-empty>
          {copy.emptyFilter}
        </p>
      </div>
    </div>
  </section>
</PageShell>

<script>
  (() => {
    const bar = document.querySelector<HTMLElement>("[data-blog-filter]");
    if (!bar) return;

    const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>("[data-filter-cat]"));
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-blog-card]"));
    const empty = document.querySelector<HTMLElement>("[data-blog-empty]");

    const ACTIVE = ["border-gold", "bg-gold", "font-bold", "text-black"];
    const IDLE = [
      "border-[var(--paper-border)]",
      "bg-[var(--paper-card)]",
      "text-[var(--paper-muted)]",
      "hover:border-gold-dark/60",
      "hover:text-[var(--paper-accent)]",
    ];

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const category = button.dataset.filterCat ?? "all";

        buttons.forEach((other) => {
          const active = other === button;
          other.setAttribute("aria-pressed", String(active));
          other.classList.remove(...(active ? IDLE : ACTIVE));
          other.classList.add(...(active ? ACTIVE : IDLE));
        });

        let visible = 0;
        cards.forEach((card) => {
          const match = category === "all" || card.dataset.category === category;
          card.classList.toggle("hidden", !match);
          if (match) visible += 1;
        });

        empty?.classList.toggle("hidden", visible > 0);
      });
    });
  })();
</script>
