---
import { render } from "astro:content";
import PageShell from "../../../layouts/PageShell.astro";
import Icon from "../../../components/Icon.astro";
import ContactChannels from "../../../components/ContactChannels.astro";
import { getDictionary } from "../../../i18n";
import { locales, localizePath, type Locale } from "../../../i18n/config";
import { getBlogCopy } from "../../../i18n/pages/blog";
import { getPostsFor, localesForSlug, postSlug, tableOfContents } from "../../../lib/blog";
import { site } from "../../../data/site";

export async function getStaticPaths() {
  const paths = [];
  for (const lang of locales) {
    const posts = await getPostsFor(lang);
    for (const post of posts) {
      paths.push({ params: { lang, slug: postSlug(post) }, props: { post } });
    }
  }
  return paths;
}

const { post } = Astro.props;
const lang = Astro.params.lang as Locale;

const copy = getBlogCopy(lang);
const t = getDictionary(lang);
const { Content, headings } = await render(post);

const slug = postSlug(post);
const path = `/blog/${slug}/`;
const toc = tableOfContents(headings);

const alternateLocales = await localesForSlug(slug);
const related = (await getPostsFor(lang)).filter((other) => postSlug(other) !== slug).slice(0, 3);
const coverExtension = post.data.cover.match(/\.(?:jpe?g|webp)$/i)?.[0] ?? "";
const responsiveCover = post.data.cover.replace(coverExtension, `-640${coverExtension}`);
// The checked-in blog hero inventory is uniform by format: WebP covers are
// 1280×720 and the one JPEG cover is 1360×768.
const coverDimensions = coverExtension.toLowerCase() === ".jpg"
  ? { width: 1360, height: 768 }
  : { width: 1280, height: 720 };

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date,
    dateModified: post.data.dateModified ?? post.data.date,
    inLanguage: lang,
    author: { "@type": "Organization", name: post.data.author },
    publisher: {
      "@type": "Organization",
      "@id": `${site.origin}/#organization`,
      name: t.meta.siteName,
      url: `${site.origin}/`,
      logo: {
        "@type": "ImageObject",
        url: new URL("/favicon.svg", site.origin).href,
      },
    },
    image: new URL(post.data.cover, site.origin).href,
    mainEntityOfPage: new URL(localizePath(lang, path), site.origin).href,
  },
];
---

<PageShell
  lang={lang}
  path={path}
  title={`${post.data.title} | ${t.meta.siteName}`}
  description={post.data.description}
  ogImage={post.data.cover}
  breadcrumbs={[
    { name: copy.breadcrumbs[0].name, path: "/" },
    { name: copy.heading, path: "/blog/" },
    { name: post.data.title, path },
  ]}
  schemas={schemas}
  alternateLocales={alternateLocales}
  theme="paper"
  promoCtaHref="#prepare-booking"
>
  <article>
    <div class="max-w-6xl mx-auto px-4 pt-6 sm:pt-10 pb-14">
      <a
        href={localizePath(lang, "/blog/")}
        class="inline-flex items-center gap-2 text-[var(--paper-soft)] hover:text-[var(--paper-accent)] transition-colors text-sm"
      >
        <Icon name="arrow-left" class="w-4 h-4" />
        {copy.post.allArticles}
      </a>

      <header class="max-w-3xl mt-6">
        <span
          class="inline-block rounded-full border border-gold-dark/40 bg-[var(--paper-card)] px-3 py-1 text-[11px] font-bold uppercase tracking-[0.12em] text-[var(--paper-accent)]"
        >
          {copy.categories[post.data.category]}
        </span>
        <h1 class="mt-4 text-[1.7rem] sm:text-4xl font-bold leading-snug text-[var(--paper-ink)]">
          {post.data.title}
        </h1>
        <p class="mt-3 text-[15px] leading-relaxed text-[var(--paper-muted)]">
          {post.data.description}
        </p>
        <p class="mt-3 text-[13px] text-[var(--paper-soft)]">
          {post.data.author} · {post.data.meta}
        </p>
        {
          post.data.draftPlaceholder && (
            <p class="mt-4 inline-block rounded-full border border-gold-dark/40 bg-gold/10 px-3 py-1 text-xs text-[var(--paper-accent)]">
              {copy.post.placeholderNotice}
            </p>
          )
        }
      </header>

      <div class="mt-8 overflow-hidden rounded-2xl border border-[var(--paper-border)] bg-[#eee7d7]">
        <img
          src={post.data.cover}
          srcset={`${responsiveCover} 640w, ${post.data.cover} ${coverDimensions.width}w`}
          sizes="(min-width: 1152px) 1152px, calc(100vw - 2rem)"
          alt={post.data.coverAlt}
          class="w-full h-auto object-cover"
          width={coverDimensions.width}
          height={coverDimensions.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="mt-9 lg:grid lg:grid-cols-[minmax(0,1fr)_240px] lg:gap-12">
        <div class="max-w-3xl min-w-0">
          {
            toc.length > 0 && (
              <details class="lg:hidden mb-7 rounded-xl border border-[var(--paper-border)] bg-[var(--paper-card)] px-5 py-4">
                <summary class="cursor-pointer text-[11px] font-bold uppercase tracking-[0.12em] text-[var(--paper-accent)]">
                  {copy.post.inThisArticle}
                </summary>
                <ul class="mt-3 space-y-1.5">
                  {toc.map((heading) => (
                    <li>
                      <a
                        href={`#${heading.slug}`}
                        class="text-[var(--paper-body)] hover:text-[var(--paper-accent)] text-sm transition-colors"
                      >
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            )
          }

          <div class="prose-paper">
            <Content />
          </div>

          <div
            id="prepare-booking"
            class="scroll-mt-24 bg-gradient-to-br from-[#1a1505] to-[#241c08] border border-gold/40 rounded-2xl p-6 my-10 text-center"
          >
            <h2 class="text-gold text-lg font-bold mb-2">{copy.post.ctaHeading}</h2>
            <p class="text-white/60 text-sm mb-5">{copy.post.ctaBody}</p>
            <ContactChannels lang={lang} />
          </div>
        </div>

        {
          toc.length > 0 && (
            <aside class="hidden lg:block">
              <div class="sticky top-28">
                <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-[var(--paper-accent)] mb-3">
                  {copy.post.inThisArticle}
                </p>
                <ul class="space-y-2 border-l border-[var(--paper-border)] pl-4">
                  {toc.map((heading) => (
                    <li>
                      <a
                        href={`#${heading.slug}`}
                        class="text-[var(--paper-body)] hover:text-[var(--paper-accent)] text-sm leading-snug transition-colors"
                      >
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </aside>
          )
        }
      </div>

      {
        related.length > 0 && (
          <div class="mt-14 max-w-3xl">
            <h2 class="text-lg font-bold text-[var(--paper-ink)] mb-4">{copy.post.related}</h2>
            <div class="grid gap-4 sm:grid-cols-3">
              {related.map((other) => (
                <a
                  href={localizePath(lang, `/blog/${postSlug(other)}/`)}
                  class="group block rounded-xl border border-[var(--paper-border)] bg-[var(--paper-card)] p-4 transition-all hover:border-gold-dark/50 hover:shadow-sm"
                >
                  <span class="text-[11px] font-bold uppercase tracking-[0.12em] text-[var(--paper-accent)]">
                    {copy.categories[other.data.category]}
                  </span>
                  <p class="mt-1 text-sm font-bold leading-snug line-clamp-3 text-[var(--paper-ink)]">
                    {other.data.title}
                  </p>
                  <p class="mt-2 text-[11px] text-[var(--paper-soft)]">{other.data.meta}</p>
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </article>
</PageShell>
