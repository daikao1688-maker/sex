---
import { render } from "astro:content";
import PageShell from "../../../layouts/PageShell.astro";
import Icon from "../../../components/Icon.astro";
import ContactChannels from "../../../components/ContactChannels.astro";
import { getDictionary } from "../../../i18n";
import { locales, localizePath, type Locale } from "../../../i18n/config";
import { getBlogCopy } from "../../../i18n/pages/blog";
import {
  blogCoverPresentation,
  getPostsFor,
  localesForSlug,
  postSlug,
  tableOfContents,
} from "../../../lib/blog";
import { site } from "../../../data/site";

export async function getStaticPaths() {
  const paths = [];
  for (const lang of locales) {
    const posts = await getPostsFor(lang);
    for (const post of posts) {
      paths.push({ params: { lang, slug: postSlug(post) }, props: { post } });
    }
  }
  return paths;
}

const { post } = Astro.props;
const lang = Astro.params.lang as Locale;

const copy = getBlogCopy(lang);
const t = getDictionary(lang);
const { Content, headings } = await render(post);

const slug = postSlug(post);
const path = `/blog/${slug}/`;
const toc = tableOfContents(headings);

const alternateLocales = await localesForSlug(slug);
const related = (await getPostsFor(lang)).filter((other) => postSlug(other) !== slug).slice(0, 3);
const cover = blogCoverPresentation(post.data.cover);
const seoTitle = post.data.seoTitle ?? post.data.title;
const metaDescription = post.data.metaDescription ?? post.data.description;

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date,
    dateModified: post.data.dateModified ?? post.data.date,
    inLanguage: lang,
    author: { "@type": "Organization", name: post.data.author },
    publisher: {
      "@type": "Organization",
      "@id": `${site.origin}/#organization`,
      name: t.meta.siteName,
      url: `${site.origin}/`,
      logo: {
        "@type": "ImageObject",
        url: new URL("/favicon.svg", site.origin).href,
      },
    },
    image: new URL(post.data.cover, site.origin).href,
    mainEntityOfPage: new URL(localizePath(lang, path), site.origin).href,
  },
];
---

<PageShell
  lang={lang}
  path={path}
  title={`${seoTitle} | ${t.meta.siteName}`}
  description={metaDescription}
  ogImage={post.data.cover}
  ogImageAlt={post.data.coverAlt}
  ogImageWidth={cover.width}
  ogImageHeight={cover.height}
  ogType="article"
  articlePublishedTime={post.data.date}
  articleModifiedTime={post.data.dateModified ?? post.data.date}
  breadcrumbs={[
    { name: copy.breadcrumbs[0].name, path: "/" },
    { name: copy.heading, path: "/blog/" },
    { name: post.data.title, path },
  ]}
  schemas={schemas}
  alternateLocales={alternateLocales}
  theme="paper"
  promoCtaHref="#prepare-booking"
>
  <article>
    {
      toc.length > 0 && (
        <nav
          data-blog-toc-mobile
          aria-label={copy.post.inThisArticle}
          aria-hidden="true"
          inert
          class="blog-reading-rail fixed top-16 sm:top-20 left-0 right-0 z-40 lg:hidden border-b border-[var(--paper-border)] bg-[var(--paper-bg)]"
        >
          <ul
            data-blog-toc-track
            class="blog-reading-track flex min-h-12 items-stretch gap-1 overflow-x-auto overscroll-x-contain whitespace-nowrap px-3 pr-10"
          >
            {toc.map((heading) => (
              <li class="flex shrink-0">
                <a
                  href={`#${heading.slug}`}
                  data-blog-toc-link
                  data-blog-toc-mobile-link
                  data-toc-id={heading.slug}
                  title={heading.text}
                  class="blog-reading-link relative inline-flex min-h-11 max-w-[72vw] shrink-0 items-center truncate px-3 text-sm font-semibold text-[var(--paper-muted)] transition-colors hover:text-[var(--paper-accent)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-gold/70"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="max-w-6xl mx-auto px-4 pt-6 sm:pt-10 pb-14">
      <a
        href={localizePath(lang, "/blog/")}
        class="inline-flex items-center gap-2 text-[var(--paper-soft)] hover:text-[var(--paper-accent)] transition-colors text-sm"
      >
        <Icon name="arrow-left" class="w-4 h-4" />
        {copy.post.allArticles}
      </a>

      <header class="max-w-3xl mt-6">
        <span
          class="inline-block rounded-full border border-gold-dark/40 bg-[var(--paper-card)] px-3 py-1 text-[11px] font-bold uppercase tracking-[0.12em] text-[var(--paper-accent)]"
        >
          {copy.categories[post.data.category]}
        </span>
        <h1 class="mt-4 text-[1.7rem] sm:text-4xl font-bold leading-snug text-[var(--paper-ink)]">
          {post.data.title}
        </h1>
        <p class="mt-3 text-[15px] leading-relaxed text-[var(--paper-muted)]">
          {post.data.description}
        </p>
        <p class="mt-3 text-[13px] text-[var(--paper-soft)]">
          {post.data.author} · {post.data.meta}
        </p>
        {
          post.data.draftPlaceholder && (
            <p class="mt-4 inline-block rounded-full border border-gold-dark/40 bg-gold/10 px-3 py-1 text-xs text-[var(--paper-accent)]">
              {copy.post.placeholderNotice}
            </p>
          )
        }
      </header>

      <div class="mt-8 overflow-hidden rounded-2xl border border-[var(--paper-border)] bg-[#eee7d7]">
        <img
          src={post.data.cover}
          srcset={cover.srcset}
          sizes="(min-width: 1152px) 1152px, calc(100vw - 2rem)"
          alt={post.data.coverAlt}
          class="w-full h-auto object-cover"
          width={cover.width}
          height={cover.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="mt-9 lg:grid lg:grid-cols-[minmax(0,1fr)_240px] lg:gap-12">
        <div class="max-w-3xl min-w-0">
          <div class="prose-paper" data-blog-body>
            <Content />
          </div>
          <div data-blog-reading-end aria-hidden="true" class="h-px"></div>

          <div
            id="prepare-booking"
            class="scroll-mt-24 bg-gradient-to-br from-[#1a1505] to-[#241c08] border border-gold/40 rounded-2xl p-6 my-10 text-center"
          >
            <h2 class="text-gold text-lg font-bold mb-2">{copy.post.ctaHeading}</h2>
            <p class="text-white/60 text-sm mb-5">{copy.post.ctaBody}</p>
            <ContactChannels lang={lang} />
          </div>
        </div>

        {
          toc.length > 0 && (
            <aside class="hidden lg:block" data-blog-toc-desktop>
              <div class="sticky top-28">
                <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-[var(--paper-accent)] mb-3">
                  {copy.post.inThisArticle}
                </p>
                <ul class="max-h-[calc(100dvh-9rem)] space-y-1 overflow-y-auto border-l border-[var(--paper-border)] py-1 pr-1">
                  {toc.map((heading) => (
                    <li>
                      <a
                        href={`#${heading.slug}`}
                        data-blog-toc-link
                        data-blog-toc-desktop-link
                        data-toc-id={heading.slug}
                        class="blog-desktop-toc-link -ml-px block border-l-2 border-transparent px-4 py-1.5 text-sm leading-snug text-[var(--paper-body)] transition-colors hover:text-[var(--paper-accent)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-gold/70"
                      >
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </aside>
          )
        }
      </div>

      {
        related.length > 0 && (
          <div class="mt-14 max-w-3xl">
            <h2 class="text-lg font-bold text-[var(--paper-ink)] mb-4">{copy.post.related}</h2>
            <div class="grid gap-4 sm:grid-cols-3">
              {related.map((other) => (
                <a
                  href={localizePath(lang, `/blog/${postSlug(other)}/`)}
                  class="group block rounded-xl border border-[var(--paper-border)] bg-[var(--paper-card)] p-4 transition-all hover:border-gold-dark/50 hover:shadow-sm"
                >
                  <span class="text-[11px] font-bold uppercase tracking-[0.12em] text-[var(--paper-accent)]">
                    {copy.categories[other.data.category]}
                  </span>
                  <p class="mt-1 text-sm font-bold leading-snug line-clamp-3 text-[var(--paper-ink)]">
                    {other.data.title}
                  </p>
                  <p class="mt-2 text-[11px] text-[var(--paper-soft)]">{other.data.meta}</p>
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </article>
</PageShell>

<style>
  .blog-reading-rail {
    visibility: hidden;
    pointer-events: none;
    opacity: 0;
    transform: translateY(-100%);
    box-shadow: 0 8px 22px rgb(38 34 26 / 0.08);
    transition:
      opacity 180ms ease,
      transform 180ms ease,
      visibility 180ms;
  }

  .blog-reading-rail.is-visible {
    visibility: visible;
    pointer-events: auto;
    opacity: 1;
    transform: translateY(0);
  }

  .blog-reading-track {
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .blog-reading-track::-webkit-scrollbar {
    display: none;
  }

  .blog-reading-link::after {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 1rem;
    height: 3px;
    border-radius: 9999px;
    background: #d4af37;
    content: "";
    transform: translateX(-50%) scaleX(0);
    transition: transform 180ms ease;
  }

  .blog-reading-link[aria-current="location"] {
    color: var(--paper-accent-strong);
  }

  .blog-reading-link[aria-current="location"]::after {
    transform: translateX(-50%) scaleX(1);
  }

  .blog-desktop-toc-link[aria-current="location"] {
    border-color: #d4af37;
    background: rgb(212 175 55 / 0.1);
    color: var(--paper-accent-strong);
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-reading-rail,
    .blog-reading-link::after {
      transition: none;
    }
  }
</style>

<script>
  import { initBlogReadingNavigation } from "../../../scripts/blog-reading-navigation.mjs";

  initBlogReadingNavigation();
</script>
