---
import PageShell from "../../layouts/PageShell.astro";
import Icon from "../../components/Icon.astro";
import { getEditorialPolicyCopy } from "../../i18n";
import { locales, localizePath, type Locale } from "../../i18n/config";
import { site, contact } from "../../data/site";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const copy = getEditorialPolicyCopy(lang);

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: copy.heading,
    description: copy.meta.description,
    url: new URL(localizePath(lang, "/editorial-policy/"), site.origin).href,
    inLanguage: lang,
    dateModified: "2026-08-22",
  },
];
---

<PageShell
  lang={lang}
  path="/editorial-policy/"
  title={copy.meta.title}
  description={copy.meta.description}
  breadcrumbs={copy.breadcrumbs}
  schemas={schemas}
  promoCtaHref={localizePath(lang, "/contact/")}
>
  <section data-testid="editorial-policy" class="px-4 pb-16 pt-6 sm:pt-10">
    <div class="mx-auto max-w-3xl">
      <div class="fade-up">
        <a
          href={localizePath(lang, "/")}
          class="group mb-6 inline-flex min-h-11 items-center text-sm text-white/60 transition-colors hover:text-gold"
        >
          <Icon name="arrow-left" class="mr-2 h-4 w-4 transition-transform group-hover:-translate-x-1" />
          {copy.backHome}
        </a>

        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.24em] text-gold/85">
          {copy.eyebrow}
        </p>
        <h1 class="mb-3 text-3xl font-bold sm:text-4xl">{copy.heading}</h1>
        <p class="mb-8 text-sm text-white/60">{copy.lastReviewed}</p>

        <div class="mb-10 rounded-2xl border border-gold/15 bg-gradient-to-b from-gold/[0.06] to-transparent p-5 sm:p-6">
          <p class="leading-relaxed text-white/80">{copy.intro}</p>
        </div>

        {
          copy.sections.map((section) => (
            <section id={section.heading === copy.sections.at(-1)?.heading ? "corrections" : undefined} class="mb-8 scroll-mt-24">
              <h2 class="mb-3 text-xl font-bold text-gold">{section.heading}</h2>
              {section.paragraphs.map((paragraph) => (
                <p class="mb-3 leading-relaxed text-white/65">{paragraph}</p>
              ))}
            </section>
          ))
        }

        <aside class="mt-10 rounded-2xl border border-white/10 bg-white/[0.025] p-5 sm:p-6">
          <h2 class="mb-2 text-lg font-semibold text-white">{copy.directory.heading}</h2>
          <p class="leading-relaxed text-white/60">{copy.directory.body}</p>
          <a
            href={copy.directory.url}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex min-h-11 items-center text-sm font-medium text-gold hover:underline"
          >
            {copy.directory.label}
          </a>
        </aside>

        <div class="mt-8 border-t border-white/5 pt-6">
          <a
            href={localizePath(lang, "/contact/")}
            class="inline-flex min-h-11 items-center text-sm font-medium text-gold hover:underline"
          >
            {copy.correctionCta}
          </a>
          <p class="mt-2 text-sm text-white/60">
            {copy.contactEmailLabel}
            <a href={`mailto:${contact.email}`} class="text-gold hover:underline font-medium">{contact.email}</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</PageShell>
